<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-adresse">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Adresse</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Adresse1 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ EPCI.adresse1 }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Adresse2 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ EPCI.adresse2 ? EPCI.adresse2 : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Adresse3 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ EPCI.adresse3 ? EPCI.adresse3 : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Code Postal :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ EPCI.codePostal }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Ville :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ EPCI.ville }}
            </div>
        </div>
        
    </fieldset>

    <hr class="bloc-limit">
</div>
