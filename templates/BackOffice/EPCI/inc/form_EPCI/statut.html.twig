<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-statut">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Statut</legend>

        {% if not EPCI.id %}
            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                {{ form_widget(form_EPCI.enabled, {'attr': {'class': 'hidden', 'checked': 'checked'}}) }}
                {{ form_widget(form_EPCI.dateInactif, {'attr': {'class': 'hidden'}}) }}
            </div>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                <i class="glyphicon glyphicon-alert"></i> EPCI actif par d&eacute;fault.
            </div>
        {% else %}

            <div class="form-group">
                {% if EPCI.enabled == true %}
                    {% set enabled = '1' %}
                {% else %}
                    {% set enabled = '0' %}
                {% endif %}
                <span class="hidden" id="enabledEPCI">{{ enabled }}</span>

                {{ form_label(form_EPCI.enabled, "Actif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                {{ form_errors(form_EPCI.enabled) }}

                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                    {{ form_widget(form_EPCI.enabled, {'attr': {'class': 'checkboxstyle pull-left'}}) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form_EPCI.dateInactif, "Date inactif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                {{ form_errors(form_EPCI.dateInactif) }}

                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                    {{ form_widget(form_EPCI.dateInactif, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>

        {% endif %}

    </fieldset>

    <hr class="bloc-limit">
</div>
