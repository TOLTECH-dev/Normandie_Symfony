<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-document">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Votre Plan de financement</legend>

        <div class="row hidden">
            <label class="col-xs-12 col-sm-12 col-md-3 col-lg-3 control-label">Aide de l'Anah :</label>
