<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-optionAuditeur">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Coordonn&eacute;es bancaire</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">RIB :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {% if partenaire and partenaire.partenaireOptionAuditeur and partenaire.partenaireOptionAuditeur.ribUrl %}
                <a href="{{ path(path_location, {'demandeId': partenaire.partenaireOptionAuditeur.id, 'typeFile': 6, 'extension': partenaire.partenaireOptionAuditeur.ribUrl, 'typeDemande': 6}) }}" target="_blank">
                    Voir le document
                </a>
                {% else %}
                Aucun document t&eacute;l&eacute;charg&eacute;
                {% endif %}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Domicialisation bancaire :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ partenaire.partenaire_optionAuditeur.domicileBancaire ? partenaire.partenaire_optionAuditeur.domicileBancaire : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Titulaire :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ partenaire.partenaire_optionAuditeur.titulaire ? partenaire.partenaire_optionAuditeur.titulaire : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">IBAN :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ partenaire.partenaire_optionAuditeur.iban ? partenaire.partenaire_optionAuditeur.iban : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">BIC :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ partenaire.partenaire_optionAuditeur.bic ? partenaire.partenaire_optionAuditeur.bic : '-' }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
