<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-identification">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Identification</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Login :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ user.username|default('-') }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Prénom :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ user.firstname|default('-') }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Nom :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ user.lastname|default('-') }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Email :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ user.email|default('-') }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
