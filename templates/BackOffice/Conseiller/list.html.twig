{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_conseiller_list') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
            <div id="container-title">
                <h2>Assistance B&eacute;n&eacute;ficiaires</h2>
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom10">
            <p class="text-center">
                <a href="{{ path('conseiller_beneficiaire_add') }}"
                   class="btn btn-primary btn-xs"
                   role="button"
                   data-toggle="tooltip"
                   data-placement="bottom"
                   data-container="body"
                   title="Cr&eacute;er un nouveau B&eacute;n&eacute;ficiaire"
                >
                    <i class="glyphicon glyphicon-user"></i> <span class="bold">Cr&eacute;er un B&eacute;n&eacute;ficiaire</span>
                </a>
            </p>
        </div>

        <table cellspacing="0" id="table_list_beneficiaire" class="table table-striped table-bordered small_table">
            <thead>
                <tr>
                    <th class="breakWord col0">B&eacute;n&eacute;ficiaire</th>
                    <th class="breakWord col1">Email</th>
                    <th class="breakWord col2">Cr&eacute;&eacute; par</th>
                    <th class="breakWord col3">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_conseiller_index') }}
{% endblock %}
