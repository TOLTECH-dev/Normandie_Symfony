<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-cheque">
    <hr class="bloc-limit">

    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Ch&egrave;que</legend>

        <ul id="custom-control_rectoCheque" class="list_error"></ul>
        {{ form_errors(formInstruction.rectoCheque) }}
        <div class="form-group">
            {{ form_label(formInstruction.rectoCheque, "Téléchargement du recto du chèque", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {% if remboursement is defined
                    and remboursementItem
                    and remboursementItem.instruction
                    and remboursementItem.instruction.rectoChequeUrl
                %}
                    <p class="lineHeight30 noMargin">
                        <a href="{{ path(path_location, {'demandeId': remboursementItem.instruction.id, 'typeFile': 8, 'extension': remboursementItem.instruction.rectoChequeUrl, 'typeDemande': typeDemandeDocument}) }}" target="_blank">
                            Voir le document
                        </a>
                    </p>
                {% endif %}

                {{ form_widget(formInstruction.rectoCheque) }}
            </div>
        </div>



        <ul id="custom-control_versoCheque" class="list_error"></ul>
        {{ form_errors(formInstruction.versoCheque) }}
        <div class="form-group">
            {{ form_label(formInstruction.versoCheque, "Téléchargement du verso du chèque", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {% if remboursement is defined
                    and remboursementItem
                    and remboursementItem.instruction
                    and remboursementItem.instruction.versoChequeUrl
                %}
                    <p class="lineHeight30 noMargin">
                        <a href="{{ path(path_location, {'demandeId': remboursementItem.instruction.id, 'typeFile': 9, 'extension': remboursementItem.instruction.versoChequeUrl, 'typeDemande': typeDemandeDocument}) }}" target="_blank">
                            Voir le document
                        </a>
                    </p>
                {% endif %}

                {{ form_widget(formInstruction.versoCheque) }}
            </div>
        </div>

        {% if not isDepot %}
            <div class="form-group">
                {{ form_label(formInstruction.isChequeConforme, "Chèque conforme ?", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                {{ form_errors(formInstruction.isChequeConforme) }}

                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 custom-select">
                    {{ form_widget(formInstruction.isChequeConforme, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
        {% endif %}

    </fieldset>

</div>