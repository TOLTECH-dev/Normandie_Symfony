<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-structureInferieur">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Rattachement Structure H&amp;E pour revenu inf&eacute;rieur au seuil</legend>

        {% set arrayStructureInferieurNom = orientationResult.structureInferieurNomConcat|split(groupconcatSeparatorItems) %}

        {% for structureInferieurNom in arrayStructureInferieurNom %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Structure H&amp;E {{ loop.index }} :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ structureInferieurNom }}
                </div>
            </div>
        {% else %}
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                    Aucun r&eacute;sultat
                </div>
            </div>
        {% endfor %}

    </fieldset>

    <hr class="bloc-limit">
</div>
