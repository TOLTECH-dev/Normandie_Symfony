<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-statut">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Statut</legend>

        {% if partenaire and partenaire.partenaire_statut and dateRattachement  %}
            <input type="hidden" value="{{ dateRattachement }}" id="value-dateRattachement" />
        {% else %}
            <input type="hidden" value="" id="value-dateRattachement" />
        {% endif %}

        <div class="form-group">
            {{ form_label(form_partenaire.partenaire_statut.dateRattachement, "Date rattachement", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form_partenaire.partenaire_statut.dateRattachement) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form_partenaire.partenaire_statut.dateRattachement, {'attr': {'class': 'form-control'}, 'id' : 'dateRattachement'}) }}
            </div>
        </div>

        {% if partenaire.partenaire_statut is null  %}
            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                {{ form_widget(form_partenaire.partenaire_statut.enabled, {'attr': {'class': 'hidden', 'checked': 'checked'}}) }}
                {{ form_widget(form_partenaire.partenaire_statut.dateInactif, {'attr': {'class': 'hidden' }, 'id': 'partenaire_dateInactif'}) }}
            </div>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                <i class="glyphicon glyphicon-alert"></i> {{ title|capitalize }} actif par d&eacute;fault.
            </div>
        {% else %}

            <div class="form-group">
                {% if partenaire.partenaire_statut.enabled == true %}
                    {% set enabled = '1' %}
                {% elseif partenaire.partenaire_statut.enabled == false %}
                    {% set enabled = '0' %}
                {% endif %}
                <span class="hidden" id="enabledPartenaire">{{ enabled }}</span>

                {{ form_label(form_partenaire.partenaire_statut.enabled, "Actif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                {{ form_errors(form_partenaire.partenaire_statut.enabled) }}

                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                    {{ form_widget(form_partenaire.partenaire_statut.enabled, {'attr': {'class': 'checkboxstyle pull-left'}}) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form_partenaire.partenaire_statut.dateInactif, "Date Inactif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                {{ form_errors(form_partenaire.partenaire_statut.dateInactif) }}

                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                    {{ form_widget(form_partenaire.partenaire_statut.dateInactif, {'attr': {'class': 'form-control'}, 'id': 'partenaire_dateInactif'}) }}
                </div>
            </div>


        {% endif %}
    </fieldset>

    <hr class="bloc-limit">
</div>
