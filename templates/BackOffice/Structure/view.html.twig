{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_structure_view') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="container-title">
            <h2>Consulter une Structure H&amp;E</h2>
            <a href="{{ path('structure_edit', {'structureId': structure.id}) }}"
               class="btn btn-warning btn-xs"
               role="button"
               id="button_position1"
               data-toggle="tooltip"
               data-placement="bottom"
               data-container="body"
               title="Modifier la Structure"
            >
                <i class="glyphicon glyphicon-edit"></i>
            </a>
            {{ include('BackOffice/Structure/inc/back.html.twig') }}
        </div>
    </div>

{{ include('BackOffice/Structure/inc/view_structure/identification.html.twig') }}
{{ include('BackOffice/Structure/inc/view_structure/adresse.html.twig') }}
{{ include('BackOffice/Structure/inc/view_structure/statut.html.twig') }}
{{ include('BackOffice/Structure/inc/view_structure/contact.html.twig') }}
{{ include('BackOffice/Structure/inc/view_structure/conseiller.html.twig') }}
{{ include('BackOffice/Structure/inc/view_structure/permanence.html.twig') }}

</div>
{% endblock %}
