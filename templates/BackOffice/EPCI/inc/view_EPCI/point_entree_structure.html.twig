<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-point-entree-structure">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Point entr&eacute;e structure</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">&nbsp;</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {% if EPCI.pointEntreeStructure is not null %}
                    {{ EPCI.pointEntreeStructure ? 'OUI' : 'NON'  }}
                {% else %}
                    -
                {% endif %}
            </div>
        </div>

        {% if EPCI.pointEntreeStructure %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Nom d'affichage :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ EPCI.nomAffichage ? EPCI.nomAffichage : '-' }}
                </div>
            </div>
        {% endif %}

    </fieldset>

    <hr class="bloc-limit">
</div>
