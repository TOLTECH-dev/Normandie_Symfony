{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_demande_list') }}
{% endblock %}

{% block contents %}
{% if is_granted('ROLE_INSTRUCTEUR') or is_granted('ROLE_CLIENT') %}
<div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
        <div id="container-title">
            <h2>Instruction administrative</h2>
        </div>
    </div>

<table cellspacing="0" id="table_list_demande" class="table table-striped table-bordered small_table">
    <thead>
    <tr>
        <th class="breakWord col0">N°</th>
        <th class="breakWord col1">B&eacute;n&eacute;ficiaire</th>
        <th class="breakWord col2">Logement</th>
        <th class="breakWord col3">Statut</th>
        <th class="breakWord col4">Type</th>
        <th class="breakWord col5">Action</th>
    </tr>
    </thead>
    <tbody>
        {% for item in list_demande %}
            <tr>
                <td>{{ item.id }}</td>
                <td>{{ item.nom|upper }} {{ item.prenom|capitalize }}</td>
                <td>{{ item.codePostal }} {{ item.ville }}</td>
                <td>{{ item.statutSlug }}</td>

                {% if (constant('App\\Entity\\Demande_::DEMANDE_AUDIT_ENERGIE_REGION_TYPE') == item.type) %} {% set typeDisplay = 'Audit énergétique Région Normandie' %}
                {% elseif (constant('App\\Entity\\Demande_::DEMANDE_TRAVAUX_TYPE') == item.type) %} {% set typeDisplay = 'Travaux' %}
                {% else %} {% set typeDisplay = '' %}
                {% endif %}
                <td>{{ typeDisplay }}</td>

                <td class="text-center">
                {% if is_granted('ROLE_INSTRUCTEUR') or is_granted('ROLE_CLIENT') %}
                    {% if item.dateCP is null %}
                        {% if item.statut not in ['1', '3', '18', '20', '23', '25', '38', '43'] %}
                            {% if item.instructionId %}
                                {% if constant('App\\Entity\\Demande_::DEMANDE_AUDIT_ENERGIE_REGION_TYPE') == item.type %}
                                    {% if item.statut in ['2', '4', '19', '21', '22', '24', '39', '44'] %}
                                        <a href="{{ path('demande_auditEnergie_reexamine', {'demandeId': item.id, 'instructionId': item.instructionId}) }}"
                                           class="btn btn-warning btn-xs"
                                           role="button"
                                           data-toggle="tooltip"
                                           data-placement="bottom"
                                           data-container="body"
                                           title="Ré-instruire la Demande"
                                        >
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </a>
                                    {% else %}
                                        <a href="{{ path('demande_auditEnergie_reexamine', {'demandeId': item.id, 'instructionId': item.instructionId}) }}"
                                           class="btn btn-default btn-xs"
                                           role="button"
                                           data-toggle="tooltip"
                                           data-placement="bottom"
                                           data-container="body"
                                           title="Ré-instruire la Demande"
                                        >
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </a>
                                    {% endif %}
                                {% elseif constant('App\\Entity\\Demande_::DEMANDE_TRAVAUX_TYPE') == item.type %}
                                    {% if item.statut in ['2', '4', '19', '21', '22', '24', '39', '44'] %}
                                        <a href="{{ path('demande_travaux_reexamine', {'demandeId': item.id, 'instructionId': item.instructionId}) }}"
                                           class="btn btn-warning btn-xs"
                                           role="button"
                                           data-toggle="tooltip"
                                           data-placement="bottom"
                                           data-container="body"
                                           title="Ré-instruire la Demande"
                                        >
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </a>
                                    {% else %}
                                        <a href="{{ path('demande_travaux_reexamine', {'demandeId': item.id, 'instructionId': item.instructionId}) }}"
                                           class="btn btn-default btn-xs"
                                           role="button"
                                           data-toggle="tooltip"
                                           data-placement="bottom"
                                           data-container="body"
                                           title="Ré-instruire la Demande"
                                        >
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </a>
                                    {% endif %}
                                {% endif %}
                            {% else %}
                                {% if constant('App\\Entity\\Demande_::DEMANDE_AUDIT_ENERGIE_REGION_TYPE') == item.type %}
                                <a href="{{ path('demande_auditEnergie_examine', {'demandeId': item.id}) }}"
                                   class="btn btn-primary btn-xs"
                                   role="button"
                                   data-toggle="tooltip"
                                   data-placement="bottom"
                                   data-container="body"
                                   title="Instruire la Demande"
                                >
                                    <i class="glyphicon glyphicon-play"></i>
                                </a>
                                {% elseif constant('App\\Entity\\Demande_::DEMANDE_TRAVAUX_TYPE') == item.type %}
                                <a href="{{ path('demande_travaux_examine', {'demandeId': item.id}) }}"
                                   class="btn btn-primary btn-xs"
                                   role="button"
                                   data-toggle="tooltip"
                                   data-placement="bottom"
                                   data-container="body"
                                   title="Instruire la Demande"
                                >
                                    <i class="glyphicon glyphicon-play"></i>
                                </a>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

</div>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_demande_listDemande_appel_datatables') }}
    {{ encore_entry_script_tags('backOffice_demande_listDemande_popover') }}
    {{ encore_entry_script_tags('coreList') }}
{% endblock %}
