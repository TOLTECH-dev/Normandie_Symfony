                {{ form_widget(form_EPCI.codePostal, {'attr': {'class': 'form-control'}}) }}

                <span id="EPCI_match"></span>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form_EPCI.ville, "Ville", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
