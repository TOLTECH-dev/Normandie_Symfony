<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-auditeur">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Votre Audit</legend>

        {% if 0 != demande.demandeAudit %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Auditeur retenu :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ devis.auditeurId ? devis.auditeurNom : '-' }}
                </div>
            </div>

            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Audit r&eacute;alis&eacute; :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {% if devis and devis.devisAuditAlt %}
                        <a href="{{ path(path_location, {'demandeId': devis.devisId, 'typeFile': 3, 'extension': devis.devisAuditUrl, 'typeDemande': 2}) }}" target="_blank">
                            Voir le document
                        </a>
                    {% else %}
                        Aucun document t&eacute;l&eacute;charg&eacute;
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Audit &eacute;nerg&eacute;tique national :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {% if devis and devis.devisAuditAlt %}
                        <a href="{{ path(path_location, {'demandeId': devis.devisId, 'typeFile': 3, 'extension': devis.devisAuditUrl, 'typeDemande': 2}) }}" target="_blank">
                            Voir le document
                        </a>
                    {% else %}
                        Aucun document t&eacute;l&eacute;charg&eacute;
                    {% endif %}
                </div>
            </div>
        {% endif %}
        
    </fieldset>

    <hr class="bloc-limit">
</div>
