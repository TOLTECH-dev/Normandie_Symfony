{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_historique_list') }}
    {{ encore_entry_link_tags('backOffice_historique_modal_email') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
        <div id="container-title">
            {% if demande.type %}
                {% set demandeTypeLabel = null %}
                {% set typeNum = demande.type|split(' | ')[0] %}
                {% if typeNum == 0 %}
                    {% set demandeTypeLabel = 'Audit énergétique et scénarios' %}
                {% elseif typeNum == 1  %}
                    {% set demandeTypeLabel = 'Audit Numérique' %}
                {% elseif typeNum == 2  %}
                    {% set demandeTypeLabel = 'Travaux' %}
                {% endif %}
            {% endif %}
            <h2>Historique {{ demandeTypeLabel }} n°{{ demande.id }} </h2>
            {% include 'BackOffice/Historique/inc/back.html.twig' with {redirectRoute: redirectRoute} %}
        </div>
    </div>

<table cellspacing="0" id="table_list_historique" class="table table-striped table-bordered small_table">
    <thead>
        <tr>
            <th class="breakWord col0">Date</th>
            <th class="breakWord col1">Action</th>
            <th class="breakWord col2">Auteur</th>
            <th class="breakWord col3">&Eacute;tat de la demande</th>
            <th class="breakWord col4">D&eacute;tail</th>
        </tr>
    </thead>

    <tbody>
        {% for item in list %}
            {% set isCommentaire = ('commentaire' == item.action|lower) ? true : false %}
            <tr>
                <td class="breakWord">
                    {{ item.dateCreation|date('d/m/Y H:i:s') }}
                </td>

                <td class="breakWord">
                    {{ item.action }}
                </td>

                <td class="breakWord">
                    {% if item.auteurCreation|lower in list_user|keys %}
                        {{ list_user[item.auteurCreation|lower] }} - {{ item.auteurRole|split(' | ')|first }}
                    {% else %}
                        {{ item.auteurCreation }} - {{ item.auteurRole|split(' | ')|first }}
                    {% endif %}
                </td>

                <td class="breakWord">
                    {{ item.statutSlug }}
                </td>

                <td class="breakWord text-center">
                    {#If one email was sent or if we are in one comment => we show the detail modal#}
                    {% if item.historiqueEmail|length>0 or isCommentaire %}
                        <span data-toggle="modal"
                              data-target="#modal_email_{{ item.id }}"
                        >
                            <button type="button"
                                    class="btn btn-primary btn-xs"
                                    data-toggle="tooltip"
                                    data-placement="bottom"
                                    data-container="body"
                                    data-original-title="Visualiser le d&eacute;tail"
                                    title="Visualiser le d&eacute;tail"
                            >
                                <i class="glyphicon glyphicon-eye-open"></i>
                            </button>
                        </span>

                        <!-- Modal Historique Email -->
                        <div class="modal fade modalBackdrop modal_email" id="modal_email_{{ item.id }}" tabindex="-1" role="dialog" data-backdrop="false">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        {% if isCommentaire %}
                                            {% set subject = 'Détails du commentaire' %}
                                        {% else %}
                                            {% set subject = 'Liste des emails' %}
                                        {% endif %}
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                        <legend class="modal-title text-center"><span class="legend-icon"></span>&nbsp;{{ subject }}</legend>
                                    </div>
                                    <div class="modal-body text-left">
                                        {% include 'BackOffice/Historique/inc/modal_email.html.twig' with {'item': item, 'isCommentaire': isCommentaire} %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_historique_index') }}
    {{ encore_entry_script_tags('coreList') }}
{% endblock %}
