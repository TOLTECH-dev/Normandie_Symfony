<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-plancherBas">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Plancher bas</legend>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_label(form.ficheTechnique_initial.plancherBasSurface, "Surface (m²)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
            </div>
            <div class="flex1">
                {{ form_widget(form.ficheTechnique_initial.plancherBasSurface, {'attr': {'class': 'form-control initial-plancherBasSurface'}}) }}
                {{ form_errors(form.ficheTechnique_initial.plancherBasSurface) }}
                <ul id="error-initial-plancherBasSurface" class="list_error"></ul>
            </div>
            <div class="flex2">
                {{ form_widget(form.ficheTechnique_BBC.plancherBasSurface, {'attr': {'class': 'form-control BBC-plancherBasSurface'}}) }}
                {{ form_errors(form.ficheTechnique_BBC.plancherBasSurface) }}
                <ul id="error-BBC-plancherBasSurface" class="list_error"></ul>
            </div>
            <div class="flex3">
                {{ form_widget(form.ficheTechnique_prescription.plancherBasSurface, {'attr': {'class': 'form-control prescription-plancherBasSurface'}}) }}
                {{ form_errors(form.ficheTechnique_prescription.plancherBasSurface) }}
                <ul id="error-prescription-plancherBasSurface" class="list_error"></ul>
            </div>
        </div>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_label(form.ficheTechnique_initial.plancherBasR, "R (m².K/W)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
            </div>
            <div class="flex1">
                {{ form_widget(form.ficheTechnique_initial.plancherBasR, {'attr': {'class': 'form-control initial-plancherBasR'}}) }}
                {{ form_errors(form.ficheTechnique_initial.plancherBasR) }}
                <ul id="error-initial-plancherBasR" class="list_error"></ul>
            </div>
            <div class="flex2">
                {{ form_widget(form.ficheTechnique_BBC.plancherBasR, {'attr': {'class': 'form-control BBC-plancherBasR'}}) }}
                {{ form_errors(form.ficheTechnique_BBC.plancherBasR) }}
                <ul id="error-BBC-plancherBasR" class="list_error"></ul>
            </div>
            <div class="flex3">
                {{ form_widget(form.ficheTechnique_prescription.plancherBasR, {'attr': {'class': 'form-control prescription-plancherBasR'}}) }}
                {{ form_errors(form.ficheTechnique_prescription.plancherBasR) }}
                <ul id="error-prescription-plancherBasR" class="list_error"></ul>
            </div>
        </div>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_label(form.ficheTechnique_initial.plancherBasEtancheite, "Gestion des points singuliers", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
                {{ form_errors(form.ficheTechnique_initial.plancherBasEtancheite) }}
            </div>
            <div class="flex1">
                {{ form_widget(form.ficheTechnique_initial.plancherBasEtancheite, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="flex2">
                {{ form_widget(form.ficheTechnique_BBC.plancherBasEtancheite, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="flex3">
                {{ form_widget(form.ficheTechnique_prescription.plancherBasEtancheite, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
