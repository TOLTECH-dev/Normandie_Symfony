{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_remboursement_auditEnergie_depot') }}
{% endblock %}

{% block contents %}
    {% if is_granted('ROLE_AUDITEUR') or is_granted('ROLE_CLIENT') or is_granted('ROLE_ADMIN') %}
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div id="container-title">
                    <h2>T&eacute;l&eacute;chargement des pi&egrave;ces justificatives: Dossier n&deg;{% if demandeId is defined %}{{ demandeId }}{% else %}{{ remboursement.demandeId }}{% endif %}</h2>
                    {% include 'BackOffice/Remboursement/AuditEnergie/inc/back.html.twig' with {'path_location_list': 'remboursement_list'} %}
                </div>
            </div>

            {{ form_start(form, {'attr': {'class': 'form-horizontal', 'id': 'form_depotAuditEnergie'}}) }}

                {{ form_errors(form) }}

                {% set path_location = 'demande_document_bo' %}
                {% set typeDemandeDocument = 5 %}
                {% set formInstruction = form.remboursement_auditEnergie.instruction %}
                {% set remboursementItem = (remboursement is defined and remboursement.remboursementAuditEnergie) ? remboursement.remboursementAuditEnergie : null %}
                {% set remboursementItemType = 0 %}
                {% set isDepot = true %}

                {{ include('BackOffice/Remboursement/AuditEnergie/inc/form_depot/audit.html.twig') }}

                {{ include('BackOffice/Remboursement/inc/form_examine/cheque.html.twig') }}
                {{ include('BackOffice/Remboursement/inc/form_examine/facture.html.twig') }}

                {#
                    Si instruction inexistante ou bien si existante mais que le destinataire Rib n'est pas "Beneficiaire"
                    Alors on affiche la partie RIB
                #}
                {% if (
                        (remboursement.remboursementAuditEnergie.instruction is not defined or not remboursement.remboursementAuditEnergie.instruction)
                        or (
                            remboursement.remboursementAuditEnergie.instruction.destinataire is defined
                            and remboursement.remboursementAuditEnergie.instruction.destinataire
                            and '1' != remboursement.remboursementAuditEnergie.instruction.destinataire|split(' | ')[0]
                        )
                    ) %}
                    {{ include('BackOffice/Remboursement/inc/form_examine/RIB.html.twig') }}
                {% endif %}

                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                    <div class="form-group">
                        {{ form_widget(form.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                    </div>
                </div>

                {{ form_rest(form) }}

            {{ form_end(form) }}

        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_remboursement_auditEnergie_formDepot_index') }}
    {{ encore_entry_script_tags('backOffice_remboursement_checkIBAN') }}
{% endblock %}
