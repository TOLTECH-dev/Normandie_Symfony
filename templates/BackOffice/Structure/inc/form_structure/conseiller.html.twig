        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Conseiller</legend>

        <div class="form-group col-xs-12 col-sm-12 col-md-12 col-lg-12 smallPadding">
            {{ form_row(form_structure.structure_conseiller) }}
            <p class="box_addConseiller">
                <a href="#" id="add_conseiller" class="btn btn-primary btn-xs"><i class="glyphicon glyphicon-plus"></i> Ajouter un conseiller</a>
