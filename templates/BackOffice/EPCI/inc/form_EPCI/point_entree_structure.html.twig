<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-point-entree-structure">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Point entr&eacute;e structure</legend>

        <div class="form-group">
            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">&nbsp;</div>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                <div style="float: left;">
                    <div class="onoffswitch">
                        {{ form_widget(form_EPCI.pointEntreeStructure) }}
                        <label class="onoffswitch-label" for="{{ form_EPCI.pointEntreeStructure.vars.id }}">
                            <span class="onoffswitch-inner"></span>
                            <span class="onoffswitch-switch"></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div id="nom-affichage-row" class="form-group hidden">
            {{ form_label(form_EPCI.nomAffichage, "Nom d'affichage", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form_EPCI.nomAffichage) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form_EPCI.nomAffichage, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
