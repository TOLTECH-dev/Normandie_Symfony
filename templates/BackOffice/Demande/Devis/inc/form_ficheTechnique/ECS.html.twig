<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-ECS">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;ECS</legend>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_label(form.ficheTechnique_initial.ECSEnergie, "Energie", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
                {{ form_errors(form.ficheTechnique_initial.ECSEnergie) }}
            </div>
            <div class="flex1 bloc-selectMultiple">
                {{ form_widget(form.ficheTechnique_initial.ECSEnergie) }}
            </div>
            <div class="flex2 bloc-selectMultiple">
                {{ form_widget(form.ficheTechnique_BBC.ECSEnergie) }}
            </div>
            <div class="flex3 bloc-selectMultiple">
                {{ form_widget(form.ficheTechnique_prescription.ECSEnergie) }}
            </div>
        </div>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_label(form.ficheTechnique_initial.ECSEquipement, "Equipement", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
                {{ form_errors(form.ficheTechnique_initial.ECSEquipement) }}
            </div>
            <div class="flex1">
                {{ form_widget(form.ficheTechnique_initial.ECSEquipement, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="flex2">
                {{ form_widget(form.ficheTechnique_BBC.ECSEquipement, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="flex3">
                {{ form_widget(form.ficheTechnique_prescription.ECSEquipement, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
