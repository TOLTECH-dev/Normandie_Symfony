{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_motifNonConformite_list') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-12 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-0 col-lg-offset-1 marginBottom40 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="container-title">
            <h2>Motifs de non-conformit&eacute;</h2>
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <p class="motif-explication">
            Ces motifs sont propos&eacute;s &agrave; l'instructeur lorsqu'il d&eacute;clare un document non conforme.
            Un motif <strong>inactif</strong> n'est plus propos&eacute; sur les nouveaux dossiers, mais reste
            affich&eacute; et coch&eacute; sur ceux qui le portent d&eacute;j&agrave; : l'historique des d&eacute;cisions
            d&eacute;j&agrave; prises n'est jamais modifi&eacute;. Modifier un libell&eacute; ne change pas davantage
            les dossiers instruits par le pass&eacute;, qui en conservent une copie.
        </p>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <ul class="nav nav-tabs marginTop20" role="tablist" id="onglets-motifs">
            {% for onglet in onglets %}
                <li class="{{ onglet.cle == onglet_actif ? 'active' : '' }}" role="presentation">
                    <a href="#{{ onglet.ancre }}"
                       aria-controls="{{ onglet.ancre }}"
                       role="tab"
                       data-toggle="tab"
                       data-cle="{{ onglet.cle }}"
                       title="{{ onglet.familleLibelle }}"
                    >
                        {{ onglet.document }}
                        {% if onglet.inactifs > 0 %}
                            <span class="badge badge-inactif" title="{{ onglet.inactifs }} motif(s) inactif(s)">{{ onglet.inactifs }}</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>

        <div class="tab-content">
            {% for onglet in onglets %}
                <div role="tabpanel"
                     class="tab-pane fade {{ onglet.cle == onglet_actif ? 'in active' : '' }}"
                     id="{{ onglet.ancre }}"
                >
                    <p class="motif-contexte">
                        <span class="label label-default">{{ onglet.familleLibelle }}</span>
                        &nbsp;{{ onglet.actifs }} motif{{ onglet.actifs > 1 ? 's' : '' }} actif{{ onglet.actifs > 1 ? 's' : '' }}{% if onglet.inactifs > 0 %}, {{ onglet.inactifs }} inactif{{ onglet.inactifs > 1 ? 's' : '' }}{% endif %}.

                        {% if not onglet.connu %}
                            <span class="text-danger">
                                Ce document ne figure pas dans la nomenclature de l'application
                                (code &laquo;&nbsp;{{ onglet.filtre }}&nbsp;&raquo;) : ses motifs ne sont propos&eacute;s
                                sur aucun &eacute;cran d'instruction.
                            </span>
                        {% endif %}

                        <a href="{{ path('motif_non_conformite_add', {'doc': onglet.cle}) }}"
                           class="btn btn-primary btn-xs pull-right"
                           role="button"
                           title="Cr&eacute;er un motif pour ce document"
                        >
                            <i class="glyphicon glyphicon-plus"></i> <span class="bold">Cr&eacute;er un motif</span>
                        </a>
                    </p>

                    {% if onglet.motifs is empty %}
                        <p class="text-muted">Aucun motif pour ce document.</p>
                    {% else %}
                        <table cellspacing="0" class="table table-striped table-bordered table-motif">
                            <thead>
                                <tr>
                                    <th class="col-position">Position</th>
                                    <th>Libell&eacute;</th>
                                    <th class="col-statut">Statut</th>
                                    <th class="col-action">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for motif in onglet.motifs %}
                                    <tr class="{{ motif.actif ? '' : 'motif-inactif' }}">
                                        <td>
                                            {{ motif.position }}
                                            {% if motif.doublon %}
                                                <span class="label label-warning"
                                                      title="Deux motifs de ce document occupent cette position : leur ordre d'affichage n'est pas maîtrisé. Donnez-en une libre à l'un des deux.">!</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if motif.protege %}
                                                {# Le motif « Autre » n'est pas modifiable : pas de lien, pour ne pas
                                                   proposer une action que le contrôleur refusera. #}
                                                {{ motif.libelle }}
                                                <span class="label label-info" title="Motif protégé : dernier de sa liste, c'est lui qui ouvre le champ de saisie libre. Ni modifiable ni désactivable.">prot&eacute;g&eacute;</span>
                                            {% else %}
                                                <a href="{{ path('motif_non_conformite_edit', {'famille': onglet.famille, 'motifId': motif.id}) }}"
                                                   title="Modifier le motif"
                                                >
                                                    {{ motif.libelle }}
                                                </a>
                                            {% endif %}
                                        </td>
                                        <td>{{ motif.actif ? 'Actif' : 'Inactif' }}</td>
                                        <td class="text-center">
                                            {% if motif.protege %}
                                                <span class="text-muted">&mdash;</span>
                                            {% elseif motif.actif %}
                                                <a href="{{ path('motif_non_conformite_enabled', {'famille': onglet.famille, 'motifId': motif.id, 'flag': 0}) }}"
                                                   class="btn btn-success btn-xs"
                                                   role="button"
                                                   title="D&eacute;sactiver le motif"
                                                >
                                                    <i class="glyphicon glyphicon-flag"></i>
                                                </a>
                                            {% else %}
                                                <a href="{{ path('motif_non_conformite_enabled', {'famille': onglet.famille, 'motifId': motif.id, 'flag': 1}) }}"
                                                   class="btn btn-danger btn-xs"
                                                   role="button"
                                                   title="Activer le motif"
                                                >
                                                    <i class="glyphicon glyphicon-flag"></i>
                                                </a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_motifNonConformite_listMotif_index') }}
{% endblock %}
