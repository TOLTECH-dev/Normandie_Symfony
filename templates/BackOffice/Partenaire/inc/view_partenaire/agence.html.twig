<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-agence">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Agence</legend>

        {% if partenaire.partenaireAgence is empty %}
            <p class="text-center bold">Aucune agence cr&eacute;&eacute;e.</p>
        {% else %}
            {% set j = 1 %}
            {% for item in partenaire.partenaireAgence %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Agence {{ j }}:</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    <ul class="noMmargin noPadding noPuce">
                        <li>{{ item.nom }}</li>
                        <li>{{ item.contact }}</li>
                        <li>{{ item.adresse }}</li>
                        <li>{{ item.codePostal }}</li>
                        <li>{{ item.ville }}</li>
                        <li>{{ item.telephone }}</li>
                        <li>{{ item.email }}</li>
                    </ul>
                </div>
            </div>
            {% set j = j + 1 %}
            {% endfor %}
        {% endif %}

    </fieldset>
</div>
