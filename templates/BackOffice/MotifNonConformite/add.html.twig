{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_motifNonConformite_list') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div id="container-title">
                <h2>Cr&eacute;er un motif &mdash; {{ document }}</h2>
                {{ include('BackOffice/MotifNonConformite/inc/back.html.twig') }}
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <p class="motif-explication">
                <span class="label label-default">{{ familleLibelle }}</span>
                Le motif sera propos&eacute; &agrave; l'instructeur lorsqu'il d&eacute;clarera ce document
                non conforme.
            </p>
        </div>

        {{ form_start(form_motif, {'attr': {'class': 'form-horizontal', 'id': 'form_addMotif'}}) }}
            {{ form_errors(form_motif) }}

            {{ include('BackOffice/MotifNonConformite/inc/form_motif/champs.html.twig') }}

            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                <div class="form-group">
                    {{ form_widget(form_motif.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                </div>
            </div>

            {{ form_rest(form_motif) }}
        {{ form_end(form_motif) }}

    </div>
{% endblock %}
