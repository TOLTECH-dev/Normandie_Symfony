<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-identification">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Identification</legend>

        <div class="form-group hidden">
            {{ form_label(form_orientation.ville_id, "Ville Id", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form_orientation.ville_id) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form_orientation.ville_id, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="form-group">
            <label class="col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label" for="CodePostalOrientation">Code Postal</label>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                <input type="text" class="form-control" id="CodePostalOrientation" value="{{ ville['code_postal'] }}" readonly />
            </div>
        </div>

        <div class="form-group">
            <label class="col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label" for="villeOrientation">Ville</label>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                <input type="text" class="form-control" id="villeOrientation" value="{{ ville['nom'] }}" readonly />
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
