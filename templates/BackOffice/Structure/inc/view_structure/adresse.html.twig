<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-adresse">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Adresse</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Adresse 1 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ structure.structure_adresse.adresse1 }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Adresse 2 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ structure.structure_adresse.adresse2 ? structure.structure_adresse.adresse2 : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Adresse 3 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ structure.structure_adresse.adresse3 ? structure.structure_adresse.adresse3 : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Code Postal :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
