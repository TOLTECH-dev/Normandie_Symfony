{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_newsletter_add') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="container-title">
            <h2>Envoyer une Newsletter</h2>
            {{ include('BackOffice/Newsletter/inc/back.html.twig') }}
        </div>
    </div>

{{ form_start(form, {'attr': {'class': 'form-horizontal', 'id': 'form_addNewsletter'}}) }}
{{ form_errors(form) }}

{{ include('BackOffice/Newsletter/inc/form_newsletter/subject.html.twig') }}
{{ include('BackOffice/Newsletter/inc/form_newsletter/email.html.twig') }}
{{ include('BackOffice/Newsletter/inc/form_newsletter/destinataire.html.twig') }}

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
    <div class="form-group">
        {{ form_widget(form.envoyer, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
    </div>
</div>

{{ form_rest(form) }}
{{ form_end(form) }}

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_newsletter_index') }}
{% endblock %}
