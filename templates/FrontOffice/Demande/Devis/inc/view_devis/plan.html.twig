            <label class="col-xs-12 col-sm-12 col-md-2 col-lg-2 control-label">Origine :</label>
            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                {{ devis.devisAideIntercommunaliteOrigine ? devis.devisAideIntercommunaliteOrigine : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-3 col-lg-3 control-label">MaPrimeR&eacute;nov&rsquo; :</label>
            <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
