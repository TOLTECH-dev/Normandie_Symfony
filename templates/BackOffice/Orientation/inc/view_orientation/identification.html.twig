<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-identification">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Identification</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Code Postal :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ orientationResult.orientationCodePostal }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Ville :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ orientationResult.orientationVille }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
