            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">T&eacute;l&eacute;phone :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ structure.structure_adresse.telephone ? structure.structure_adresse.telephone : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Site Internet :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ structure.structure_adresse.siteInternet ? structure.structure_adresse.siteInternet : '-' }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
