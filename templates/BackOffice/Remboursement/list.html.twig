{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_remboursement_list') }}
    {{ encore_entry_link_tags('backOffice_historique_modal_commentaire') }}
{% endblock %}

{% block contents %}
    {% if is_granted('ROLE_CONSEILLER')
        or is_granted('ROLE_INSTRUCTEUR')
        or is_granted('ROLE_INSTRUCTEUR_UP')
        or is_granted('ROLE_AUDITEUR')
        or is_granted('ROLE_RENOVATEUR')
        or is_granted('ROLE_CLIENT')
        or is_granted('ROLE_ADMIN')
    %}
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 hidden" id="content-wrapper">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
                <div id="container-title">
                    <h2>Remboursement des Aides</h2>
                    {% if is_granted('ROLE_CLIENT') or is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('remboursement_export') }}"
                           class="bouton-creer"
                           role="button"
                           title="Exporter les remboursements"
                        >
                            <i class="glyphicon glyphicon-download-alt"></i>
                            <span class="bold">Exporter</span>
                        </a>
                    {% endif %}
                </div>
            </div>

            {#
                Filtres à choix multiple, placés au-dessus du tableau (le script les déplace dans la
                barre d'outils de DataTables), sur le modèle de la consultation des dossiers. La
                sélection est reportée dans un champ caché, valeurs séparées par des barres
                verticales, qui sert de critère à la colonne masquée correspondante.
            #}
            <div class="filtres-listes-attente">
            <div id="filtres-listes" class="filtres-listes" hidden>
                <div class="filtre-liste">
                    <button type="button" class="filtre-liste-bouton" id="bouton_thematiques"
                            aria-haspopup="true" aria-expanded="false">
                        <span class="filtre-liste-texte">Toutes les th&eacute;matiques</span>
                        <span class="caret"></span>
                    </button>
                    {# Les thématiques sont renseignées par le script, qui en détient déjà les libellés #}
                    <div class="filtre-liste-menu" id="menu_thematiques" role="group" aria-labelledby="bouton_thematiques" hidden></div>
                    <input type="hidden" name="demandeType" id="filtre_demandeType" data-colonne="demandeType" value="" />
                </div>

                <div class="filtre-liste">
                    <button type="button" class="filtre-liste-bouton" id="bouton_statuts"
                            aria-haspopup="true" aria-expanded="false">
                        <span class="filtre-liste-texte">Tous les statuts</span>
                        <span class="caret"></span>
                    </button>
                    <div class="filtre-liste-menu" id="menu_statuts" role="group" aria-labelledby="bouton_statuts" hidden>
                        <p class="filtre-liste-titre">Remboursements</p>
                        {% for statut in statutsRemboursement %}
                            <label class="filtre-liste-choix">
                                <input type="checkbox" value="{{ statut }}" /> <span>{{ statut }}</span>
                            </label>
                        {% endfor %}
                        <p class="filtre-liste-titre">Demandes</p>
                        {% for statut in statutsDemande %}
                            <label class="filtre-liste-choix">
                                <input type="checkbox" value="{{ statut }}" /> <span>{{ statut }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="statut" id="filtre_statut" data-colonne="statut" value="" />
                </div>
            </div>
            </div>

            {#
                Colonnes regroupées : le numéro de dossier, le numéro de chèque et le statut forment
                une bande en tête de ligne ; les autres informations sont réunies par nature. Chaque
                champ de recherche interroge tout son groupe (cf. RemboursementListSql), son attribut
                data-colonne désignant la colonne par son nom logique.
            #}
            <table cellspacing="0" id="table_list_remboursement"
                   class="table table-striped table-bordered big_table tableau-groupe tableau-remboursements">
                <thead>
                    <tr>
                        <th class="colonne-dossier">Dossier</th>
                        <th class="colonne-beneficiaire">B&eacute;n&eacute;ficiaire</th>
                        <th class="colonne-accompagnement">Accompagnement</th>
                        <th class="colonne-professionnel">Professionnel</th>
                        <th class="colonne-rmh">Date RMH</th>
                        <th class="colonne-action">Action</th>
                        <th class="colonne-thematique">Th&eacute;matique</th>
                        <th class="colonne-statut">Statut</th>
                    </tr>
                </thead>

                {% if not isDataEmpty %}
                    <tfoot>
                        <tr id="filterrow">
                            <th>
                                <input type="text"
                                       name="dossier"
                                       data-colonne="dossier"
                                       class="filtre-tableau"
                                       placeholder="N&deg; dossier ou ch&egrave;que"
                                       aria-label="Rechercher par num&eacute;ro de dossier ou de ch&egrave;que"
                                />
                            </th>
                            <th>
                                <input type="text"
                                       name="beneficiaire"
                                       data-colonne="beneficiaire"
                                       class="filtre-tableau"
                                       placeholder="Nom, ville, code postal"
                                       aria-label="Rechercher par b&eacute;n&eacute;ficiaire, ville ou code postal"
                                />
                            </th>
                            <th>
                                <input type="text"
                                       name="structureConseiller"
                                       data-colonne="structureConseiller"
                                       class="filtre-tableau"
                                       placeholder="Structure ou conseiller"
                                       aria-label="Rechercher par structure ou conseiller"
                                />
                            </th>
                            <th>
                                <input type="text"
                                       name="partenaire"
                                       data-colonne="partenaire"
                                       class="filtre-tableau"
                                       placeholder="Professionnel"
                                       aria-label="Rechercher par professionnel"
                                />
                            </th>
                            <th>
                                <input type="text"
                                       name="RMHDate"
                                       data-colonne="RMHDate"
                                       class="filtre-tableau"
                                       placeholder="jj/mm/aaaa"
                                       aria-label="Rechercher par date de remise &agrave; l&rsquo;huissier"
                                />
                            </th>
                            <th class="textCenter">
                                <button type="button"
                                        class="bouton-vider-filtres"
                                        data-toggle="tooltip"
                                        data-placement="bottom"
                                        data-container="body"
                                        title="Vider les champs de recherche"
                                        id="clear_search_input"
                                >
                                    <i class="glyphicon glyphicon-erase"></i>
                                    <span class="sr-only">Vider les champs de recherche</span>
                                </button>
                            </th>
                            {# Colonnes masquées (thématique, statut) : leurs filtres sont au-dessus du tableau #}
                            <th>&nbsp;</th>
                            <th>&nbsp;</th>
                        </tr>
                    </tfoot>
                {% endif %}

                <tbody></tbody>

                <div id="js-role" class="hidden"
                     data-is-conseiller="{% if is_granted('ROLE_CONSEILLER') %}1{% else %}0{% endif %}"
                     data-is-instructeur="{% if is_granted('ROLE_INSTRUCTEUR') %}1{% else %}0{% endif %}"
                     data-is-instructeur-up="{% if is_granted('ROLE_INSTRUCTEUR_UP') %}1{% else %}0{% endif %}"
                     data-is-auditeur="{% if is_granted('ROLE_AUDITEUR') %}1{% else %}0{% endif %}"
                     data-is-renovateur="{% if is_granted('ROLE_RENOVATEUR') %}1{% else %}0{% endif %}"
                     data-is-epci="{% if is_granted('ROLE_EPCI') %}1{% else %}0{% endif %}"
                     data-is-client="{% if is_granted('ROLE_CLIENT') %}1{% else %}0{% endif %}"
                     data-is-admin="{% if is_granted('ROLE_ADMIN') %}1{% else %}0{% endif %}"
                     data-is-technique="{% if is_granted('ROLE_TECHNIQUE') %}1{% else %}0{% endif %}"
                >
                </div>
            </table>
        </div>

        {{ include('BackOffice/Demande/inc/modalCommentaire.html.twig') }}

    {% endif %}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
    {{ encore_entry_script_tags('backOffice_remboursement_list_appel_datatables_ajax') }}
    {{ encore_entry_script_tags('coreList') }}
    <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>

{% endblock %}
