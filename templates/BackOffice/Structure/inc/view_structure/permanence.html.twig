<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-permanence">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Permanence</legend>

        {% if structure.structurePermanence is empty %}
            <p class="text-center bold">Aucune Permanence cr&eacute;&eacute;e.</p>
        {% else %}
            {% set k = 1 %}
            {% for item in structure.structurePermanence %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Permanence {{ k }}:</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    <ul class="noMmargin noPadding noPuce">
                        <li>{{ item.nom }}</li>
                        <li>{{ item.adresse }}</li>
                        <li>{{ item.codePostal }}</li>
                        <li>{{ item.ville }}</li>
                        <li>{{ item.telephone }}</li>
                        <li>{{ item.email }}</li>
                        <li>{{ item.jourOuverture }}</li>
                        <li>{{ item.horaire }}</li>
                    </ul>
                </div>
            </div>
            {% set k = k + 1 %}
            {% endfor %}
        {% endif %}

    </fieldset>
</div>
