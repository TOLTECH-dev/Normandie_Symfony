<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-adresse">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Adresse</legend>
        
        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Code Postal :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ logement.codePostal }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Ville :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ logement.ville }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Num&eacute;ro de rue :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ logement.numeroRue }}
            </div>
        </div>

        {% set complementNumeroRueArray = {
        '0 | bis': 'Bis',
        '1 | ter': 'Ter',
        '': '-'
        } %}

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Compl&eacute;ment num&eacute;ro de rue :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ complementNumeroRueArray[logement.complementRue] }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Nom de rue :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ logement.adresse }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Compl&eacute;ment 1 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ logement.complement1 ? logement.complement1 : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Compl&eacute;ment 2 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ logement.complement2 ? logement.complement2 : '-' }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
