<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-ECS">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;ECS</legend>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">Energie</label>
            </div>
            <div class="flex1 bloc-selectMultiple fontSize9">
                {% if ficheTechnique.ficheTechnique_initial.ECSEnergie is not empty %}
                <ul>
                    {% for item in ficheTechnique.ficheTechnique_initial.ECSEnergie %}
                        <li>{{ pathologieVentilationArray[item] }}</li>
                    {% endfor %}
                </ul>
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex2 bloc-selectMultiple fontSize9">
                {% if ficheTechnique.ficheTechnique_BBC.ECSEnergie is not empty %}
                <ul>
                    {% for item in ficheTechnique.ficheTechnique_BBC.ECSEnergie %}
                        <li>{{ pathologieVentilationArray[item] }}</li>
                    {% endfor %}
                </ul>
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex3 bloc-selectMultiple fontSize9">
                {% if ficheTechnique.ficheTechnique_prescription.ECSEnergie is not empty %}
                <ul>
                    {% for item in ficheTechnique.ficheTechnique_prescription.ECSEnergie %}
                        <li>{{ pathologieVentilationArray[item] }}</li>
                    {% endfor %}
                </ul>
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 bloc-selectMultiple fontSize9">
                    {% if ficheTechnique.ficheTechnique_finChantier.ECSEnergie is not empty %}
                        <ul>
                            {% for item in ficheTechnique.ficheTechnique_finChantier.ECSEnergie %}
                                <li>{{ pathologieVentilationArray[item] }}</li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-center">-</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">Equipement</label>
            </div>
            <div class="flex1 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_initial.ECSEquipement %}
                    {{ ficheTechnique.ficheTechnique_initial.ECSEquipement }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex2 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_BBC.ECSEquipement %}
                    {{ ficheTechnique.ficheTechnique_BBC.ECSEquipement }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex3 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_prescription.ECSEquipement %}
                    {{ ficheTechnique.ficheTechnique_prescription.ECSEquipement }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 marginTop7 fontSize9">
                    {% if ficheTechnique.ficheTechnique_finChantier.ECSEquipement %}
                        {{ ficheTechnique.ficheTechnique_finChantier.ECSEquipement }}
                    {% else %}
                        <p class="text-center">-</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
