<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-statut">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Statut</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Statut de Remboursement :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ remboursementStatutSlug }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Date de RMH :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ remboursement and remboursementDateRMH ? remboursementDateRMH|date('d/m/Y') : '-' }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
