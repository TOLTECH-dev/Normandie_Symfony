{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_core_datepicker') }}
    {{ encore_entry_link_tags('backOffice_partenaire_add_edit') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
        <div id="container-title">
            <h2>Ajouter un {{ title|capitalize }}</h2>
            {{ include('BackOffice/Partenaire/inc/back.html.twig') }}
        </div>
    </div>

<span class="hidden" id="typePartenaire">{{ type }}</span>
{% set path_location = 'demande_document_bo' %}

{{ form_start(form_partenaire, {'attr': {'class': 'form-horizontal', 'id': 'form_addPartenaire'}}) }}

{{ form_errors(form_partenaire) }}

{{ include('BackOffice/Partenaire/inc/form_partenaire/identification.html.twig') }}
{{ include('BackOffice/Partenaire/inc/form_partenaire/option_auditeur.html.twig') }}
{{ include('BackOffice/Partenaire/inc/form_partenaire/option_renovateur.html.twig') }}
{{ include('BackOffice/Partenaire/inc/form_partenaire/adresse.html.twig') }}
{{ include('BackOffice/Partenaire/inc/form_partenaire/statut.html.twig') }}
{{ include('BackOffice/Partenaire/inc/form_partenaire/contact.html.twig') }}
{{ include('BackOffice/Partenaire/inc/form_partenaire/agence.html.twig') }}

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
    <div class="form-group">
        {{ form_widget(form_partenaire.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
    </div>
</div>

{{ form_rest(form_partenaire) }}

{{ form_end(form_partenaire) }}

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_partenaire_index') }}
{% endblock %}
