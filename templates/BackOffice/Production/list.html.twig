{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_core_datepicker') }}
    {{ encore_entry_link_tags('backOffice_production_list') }}
    {{ encore_entry_link_tags('backOffice_production_add_edit') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
        <div id="container-title">
            <h2>Productions des Ch&egrave;ques</h2>
        </div>
    </div>

{% if is_granted('ROLE_INSTRUCTEUR') or is_granted('ROLE_ADMIN') %}
<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom10">
    <p class="text-center">
        <span data-toggle="modal" data-target="#modal-production">
            <button type="button"
                    class="btn btn-primary btn-xs production-flux"
                    data-toggle="tooltip"
                    data-placement="bottom"
                    data-container="body"
                    title="Lancer une Production"
            >
                <i class="glyphicon glyphicon-play"></i> <span class="bold">Lancer une Production</span>
            </button>
        </span>
    </p>

    <div class="modal fade modalBackdrop" id="modal-production" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title text-center" id="myModalLabel">Lancer une production</h4>
                </div>
                    <div class="modal-body">
                                    {{ include('BackOffice/Production/add.html.twig') }}
                                    &nbsp;
                                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}

<table cellspacing="0" id="table_list_production" class="table table-striped table-bordered big_table">
    <thead>
    <tr>
        <th class="breakWord col0">N°</th>
        <th class="breakWord col1">Nombre de demandes</th>
        <th class="breakWord col2">Total</th>
        <th class="breakWord col3">Date de lancement</th>
        <th class="breakWord col4">Date de Production</th>
        <th class="breakWord col5">Date d'Exp&eacute;dition</th>
        <th class="breakWord col6">Action</th>
    </tr>
    </thead>
    <tbody>
        {% for item in list_production %}
            {% set sum =  item.countEnergie + item.countNumerique + item.countEnergieRegion + item.countMiseAJourAuditE
                + item.countNiveau1 + item.countNiveau2 + item.countNiveau2Renovateur + item.countNiveauBBCrenovateur + item.countNiveauBBCbiosource
                + item.countNiveauSortiePassoire + item.countNiveauPremiereEtapeBBCRGE + item.countNiveauPremiereEtapeBBCRenovateur + item.countNiveauRenovationGobaleBBC
            %}
            <tr>
                <td>{{ item.productionId }}</td>
                <td>
                    Audit Energ&eacute;tique et Sc&eacute;nario: {{ item.countEnergie }}<br>
                    Audit Num&eacute;rique: {{ item.countNumerique }}<br>
                    {{ constant('App\\Entity\\Demande_::DEMANDE_AUDIT_ENERGIE_REGION_LABEL')}}: {{ item.countEnergieRegion }}<br>
                    {{ constant('App\\Entity\\Demande_::DEMANDE_MISE_A_JOUR_AUDIT_ENERGIE_LABEL')}}: {{ item.countMiseAJourAuditE }}<br>
                    Ch&egrave;que Travaux Niveau 1: {{ item.countNiveau1 }}<br>
                    Ch&egrave;que Travaux Niveau 2: {{ item.countNiveau2 }}<br>
                    Ch&egrave;que Travaux Niveau 2 (R&eacute;novateur): {{ item.countNiveau2Renovateur }}<br>
                    Ch&egrave;que Travaux Niveau BBC: {{ item.countNiveauBBCrenovateur }}<br>
                    Ch&egrave;que Travaux Niveau BBC biosourc&eacute;: {{ item.countNiveauBBCbiosource }}<br>
                    {{ constant('App\\Entity\\Demande_travaux_devis::DEMANDE_TYPE_NIVEAU_SORTIE_PASSOIRE_KEY')}}: {{ item.countNiveauSortiePassoire }}<br>
                    {{ constant('App\\Entity\\Demande_travaux_devis::DEMANDE_TYPE_NIVEAU_ETAPE1_BBC_RGE_KEY')}}: {{ item.countNiveauPremiereEtapeBBCRGE }}<br>
                    {{ constant('App\\Entity\\Demande_travaux_devis::DEMANDE_TYPE_NIVEAU_ETAPE1_BBC_RENOVATEUR_KEY')}}: {{ item.countNiveauPremiereEtapeBBCRenovateur }}<br>
                    {{ constant('App\\Entity\\Demande_travaux_devis::DEMANDE_TYPE_NIVEAU_RENOVATION_GLOBALE_BBC_KEY')}}: {{ item.countNiveauRenovationGobaleBBC }}<br>
                </td>
                <td class="text-center">{{ sum }}</td>
                <td class="text-center">{{ item.dateLancement|date("d/m/Y") }}</td>
                <td class="text-center">
                    {% if item.dateProduction is null %}
                        -
                    {% else %}
                        {{ item.dateProduction|date("d/m/Y") }}
                    {% endif %}
                </td>
                <td class="text-center">
                    {% if item.dateExpedition is null %}
                        -
                    {% else %}
                        {{ item.dateExpedition|date("d/m/Y") }}
                    {% endif %}
                </td>
                <td class="text-center">
                    {% if is_granted('ROLE_INSTRUCTEUR') or is_granted('ROLE_ADMIN') %}
                    <span data-toggle="modal" data-target="#modal-editProduction_{{ item.productionId }}">
                        <button type="button"
                                class="btn btn-warning btn-xs"
                                data-toggle="tooltip"
                                data-placement="bottom"
                                data-container="body"
                                title="Modifier la Date d'exp&eacute;dition"
                        >
                            <i class="glyphicon glyphicon-edit"></i>
                        </button>
                    </span>

                    <!-- Modal Edit Date date expedition -->
                    <div class="modal fade modalBackdrop" id="modal-editProduction_{{ item.productionId }}" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                    <h4 class="modal-title text-center" id="myModalLabel">Modifier la date d'exp&eacute;dition</h4>
                                </div>
                                <div class="modal-body">
                                    {{ include('BackOffice/Production/edit.html.twig') }}
                                    &nbsp;
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_production_index') }}
{% endblock %}
