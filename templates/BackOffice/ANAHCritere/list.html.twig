{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_ANAHCritere_list') }}
    {{ encore_entry_link_tags('backOffice_ANAHCritere_add_edit') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
            <div id="container-title">
                <h2>Liste des Crit&egrave;res ANAH</h2>
            </div>
        </div>

        {% if list_ANAHCritere|length < 5 %}
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom10">
                <p class="text-center">
                    <span data-toggle="modal" data-target="#modal-addANAHCritere">
                        <button type="button"
                                class="btn btn-primary btn-xs"
                                data-toggle="tooltip"
                                data-placement="bottom"
                                data-container="body"
                                title="Ajouter un crit&egrave;re ANAH"
                        >
                            <i class="glyphicon glyphicon-plus"></i> <span class="bold">Cr&eacute;er un Crit&egrave;re ANAH</span>
                        </button>
                    </span>
                </p>

                <!-- Modal Add ANAH Critère -->
                <div class="modal fade modalBackdrop" id="modal-addANAHCritere" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title text-center" id="myModalLabel">Ajouter une Date CP</h4>
                            </div>
                            <div class="modal-body">
                                {{ include('BackOffice/ANAHCritere/inc/form_list/add.html.twig') }}
                                &nbsp;
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <table cellspacing="0" id="table_list_ANAHCritere" class="table table-striped table-bordered big_table">
            <thead>
            <tr>
                <th class="breakWord col0">Nombre de personnes</th>
                <th class="breakWord col1">Plafond tr&egrave;s modeste (&euro;)</th>
                <th class="breakWord col2">Plafond modeste (&euro;)</th>
                <th class="breakWord col3">Plafond interm&eacute;diaire (&euro;)</th>
                <th class="breakWord col4">Action</th>
            </tr>
            </thead>
            <tbody>
            {% for item in list_ANAHCritere %}
                <tr>
                    <td>{{ item.nbPersonne }}</td>
                    <td>{{ item.plafondTresModeste|number_format(0, '.', ' ') }}</td>
                    <td>{{ item.plafondModeste|number_format(0, '.', ' ') }}</td>
                    <td>{{ item.plafondIntermediaire|number_format(0, '.', ' ') }}</td>
                    <td class="text-center">
                            <span data-toggle="modal" data-target="#modal-editANAHCritere_{{ item.id }}">
                                <button type="button"
                                        class="btn btn-warning btn-xs"
                                        data-toggle="tooltip"
                                        data-placement="bottom"
                                        data-container="body"
                                        title="Modifier le crit&egrave;re ANAH"
                                >
                                    <i class="glyphicon glyphicon-edit"></i>
                                </button>
                            </span>

                        <!-- Modal Edit ANAH Critère -->
                        <div class="modal fade modalBackdrop" id="modal-editANAHCritere_{{ item.id }}" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                        <h4 class="modal-title text-center" id="myModalLabel">Modifier un Crit&egrave;re ANAH</h4>
                                    </div>
                                    <div class="modal-body">
                                        {{ include('BackOffice/ANAHCritere/inc/form_list/edit.html.twig') }}
                                        &nbsp;
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
                {% if loop.last %}
                    <tr>
                        <td>par personne suppl&eacute;mentaire</td>
                        <td>+{{ item.supplementTresModeste|number_format(0, '.', ' ') }}</td>
                        <td>+{{ item.supplementModeste|number_format(0, '.', ' ') }}</td>
                        <td>+{{ item.supplementIntermediaire|number_format(0, '.', ' ') }}</td>
                        <td class="text-center">&nbsp;</td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_ANAHCritere_index') }}
    {{ encore_entry_script_tags('coreList') }}
{% endblock %}
