{#
    Compte activé (route user_register_confirmed, RegistrationController::registerConfirmed, réservée à
    un utilisateur connecté). N'affiche aucune donnée du compte.
#}
{% extends "Main/Security/layout_auth.html.twig" %}

{% block title %}Compte confirmé{% endblock %}

{% block card %}
    <div class="auth-card">
        <div class="auth-card-header">
            <div class="auth-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="m8 12 3 3 5-6"></path>
                </svg>
            </div>
            <h2 class="auth-card-title">Compte confirm&eacute;</h2>
            <p class="auth-card-subtitle">F&eacute;licitations, votre compte est maintenant activ&eacute;.</p>
        </div>

        {{ include('BackOffice/Security/_auth_messages.html.twig') }}

        <a href="{{ path('fo_dashboard') }}" class="auth-submit">Acc&eacute;der &agrave; mon compte</a>
    </div>
{% endblock %}
