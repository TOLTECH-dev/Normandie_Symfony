{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_beneficiaire_list_all') }}
    {{ encore_entry_link_tags('backOffice_beneficiaire_assign_structure') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
            <div id="container-title">
                <h2>Liste des b&eacute;n&eacute;ficiaires</h2>
            </div>
        </div>

        <table cellspacing="0" id="table_list_beneficiaire" class="table table-striped table-bordered small_table">
            <thead>
                <tr>
                    <th class="breakWord col0">Nom / Pr&eacute;nom</th>
                    <th class="breakWord col1">Type</th>
                    <th class="breakWord col2">Code Postal / Ville</th>
                    <th class="breakWord col3">Email</th>
                    <th class="breakWord col4">Structure / Conseiller</th>
                    <th class="breakWord col5">Nombre de logement</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <!-- Modal assign structure de rattachement -->
        <div class="modal fade modalBackdrop" id="modal-assignStructure" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title text-center" id="myModalLabel">Choix de la Structure Conseil</h4>
                    </div>
                    <div class="modal-body">
                        {{ include('BackOffice/Beneficiaire/inc/form_assign/form.html.twig') }}
                        &nbsp;
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_beneficiaire_index') }}
    {{ encore_entry_script_tags('coreList') }}
{% endblock %}
