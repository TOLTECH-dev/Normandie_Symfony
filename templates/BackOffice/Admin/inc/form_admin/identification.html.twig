<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Identification</legend>

        {# Affichage du champ username uniquement à la création #}
        {% if user.id is null %}
        <div class="form-group">
            {{ form_label(form.username, "Login", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form.username) }}
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.username, {'attr': {'class': 'form-control', "placeholder":"Login"}}) }}
            </div>
        </div>
        {% endif %}

        <div class="form-group">
            {{ form_label(form.firstname, "Prénom", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form.firstname) }}
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.firstname, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.lastname, "Nom", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form.lastname) }}
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.lastname, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.email, "Email", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form.email) }}
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder':'Email'}}) }}
            </div>
        </div>

        {# Affichage du mot de passe uniquement à la création #}
        {% if user.id is null and form.plainPassword is defined %}
        <div class="form-group">
            {{ form_label(form.plainPassword.first, "Mot de passe", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form.plainPassword) }}
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder':'Mot de passe'}}) }}
            </div>
        </div>
        <div class="form-group">
            {{ form_label(form.plainPassword.second, "Confirmation du mot de passe", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder':'Confirmation'}}) }}
            </div>
        </div>
        {% endif %}

    </fieldset>
    <hr class="bloc-limit">
</div>
