{% set typeBeneficiaire = beneficiaire.type|split(' | ') %}
{% if '0' == typeBeneficiaire[0] %}
    {% set textePieceComplementaire = 'Pièce complémentaire' %}
    {% set texteInfoBulle = constant('INFO_BULLE_HTML_PIECE_COMPLEMENTAIRE_PARTICULIER', auditE) %}
{% elseif '1' == typeBeneficiaire[0] %}
    {% set textePieceComplementaire = 'Statut de la SCI' %}
    {% set texteInfoBulle = constant('INFO_BULLE_HTML_PIECE_COMPLEMENTAIRE_SCI', auditE) %}
{% endif %}

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-document">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Votre Maison</legend>

        <ul id="custom-control_justificatifPropriete" class="list_error"></ul>
        {{ form_errors(form.demande_auditEnergie.justificatifPropriete) }}
        <div class="form-group">
            {{ form_label(form.demande_auditEnergie.justificatifPropriete, "Justificatif de propriété:", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

            <div class="document-tip">
                <a role="button"
                   tabindex="0"
                   data-container="body"
                   data-toggle="popover"
                   data-trigger="focus"
                   data-placement="top"
                   data-content="{{ constant('INFO_BULLE_HTML_JUSTIFICATIF_DE_PROPRIETE', auditE) }}"
                >
                    <i class="glyphicon glyphicon-question-sign"></i>
                </a>
            </div>

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.demande_auditEnergie.justificatifPropriete) }}
            </div>
        </div>

        {% if auditE and auditE.demande_auditEnergie and auditE.demande_auditEnergie.id and auditE.demande_auditEnergie.justificatifProprieteAlt %}
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 col-xs-offset-0 col-sm-offset-0 col-md-offset-4 col-lg-offset-4">
            <p>
                <a href="{{ path(path_location, {'demandeId': auditE.demande_auditEnergie.id, 'typeFile': 0, 'extension': auditE.demande_auditEnergie.justificatifProprieteUrl, 'typeDemande': 0}) }}" target="_blank">
                    Voir le document
                </a>
            </p>
        </div>
        {% endif %}

        <ul id="custom-control_pieceComplement" class="list_error"></ul>
        {{ form_errors(form.demande_auditEnergie.pieceComplement) }}
        <div class="form-group">
            {{ form_label(form.demande_auditEnergie.pieceComplement, textePieceComplementaire ~ ":", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

            <div class="document-tip">
                <a role="button"
                   tabindex="0"
                   data-container="body"
                   data-toggle="popover"
                   data-trigger="focus"
                   data-placement="top"
                   data-content="
                        {{ texteInfoBulle }}
                    "
                >
                    <i class="glyphicon glyphicon-question-sign"></i>
                </a>
            </div>

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.demande_auditEnergie.pieceComplement) }}
            </div>
        </div>

        {% if auditE and auditE.demande_auditEnergie and auditE.demande_auditEnergie.id and auditE.demande_auditEnergie.pieceComplementAlt %}
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 col-xs-offset-0 col-sm-offset-0 col-md-offset-4 col-lg-offset-4">
            <p>
                <a href="{{ path(path_location, {'demandeId': auditE.demande_auditEnergie.id, 'typeFile': 1, 'extension': auditE.demande_auditEnergie.pieceComplementUrl, 'typeDemande': 0}) }}" target="_blank">
                    Voir le document
                </a>
            </p>
        </div>
        {% endif %}

    </fieldset>

    <hr class="bloc-limit">
</div>
