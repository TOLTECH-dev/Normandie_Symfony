<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-adresse">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Adresse</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Code Postal :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireCodePostal }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Ville :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireVille }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Num&eacute;ro de rue :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireNumeroRue }}
            </div>
        </div>

        {% set complementNumeroRueArray = {
        '0 | bis': 'Bis',
        '1 | ter': 'Ter',
        '': '-'
        } %}

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Compl&eacute;ment num&eacute;ro de rue :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ complementNumeroRueArray[beneficiaire.beneficiaireComplementNumeroRue] }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Nom de rue :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireNomRue }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Compl&eacute;ment1 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireComplement1 ? beneficiaire.beneficiaireComplement1 : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Compl&eacute;ment2 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireComplement2 ? beneficiaire.beneficiaireComplement2 : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Email :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireEmail ? beneficiaire.beneficiaireEmail : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label"> T&eacute;l&eacute;phone 1 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireTel1 ? beneficiaire.beneficiaireTel1 : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label"> T&eacute;l&eacute;phone 2 :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireTel2 ? beneficiaire.beneficiaireTel2 : '-' }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
