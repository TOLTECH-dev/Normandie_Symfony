{% extends "Main/Security/Resetting/layout.html.twig" %}

{% block title %}Vérifiez votre messagerie{% endblock %}

{% block card %}
    <div class="auth-card">
        <div class="auth-card-header">
            <div class="auth-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="m3 7 9 6 9-6"></path>
                </svg>
            </div>
            <h2 class="auth-card-title">V&eacute;rifiez votre messagerie</h2>
            {# Formulation neutre : la page s'affiche que le compte existe ou non #}
            <p class="auth-card-subtitle">
                Si un compte correspond aux informations saisies, un courriel contenant un lien de
                r&eacute;initialisation du mot de passe vient de vous &ecirc;tre envoy&eacute;.
            </p>
        </div>

        {{ include('BackOffice/Security/_auth_messages.html.twig') }}

        <ul class="auth-info-list">
            <li>Le lien reste valable {{ tokenLifetime }} heure{{ tokenLifetime > 1 ? 's' }}.</li>
            <li>Une nouvelle demande n'est possible qu'apr&egrave;s ce d&eacute;lai.</li>
            <li>Pensez &agrave; v&eacute;rifier vos courriers ind&eacute;sirables.</li>
        </ul>

        <a href="{{ path(isBackOffice ? 'admin_user_login' : 'user_login') }}" class="auth-submit">Retour &agrave; la connexion</a>
    </div>
{% endblock %}
