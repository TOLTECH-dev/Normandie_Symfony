<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">

    <link rel="apple-touch-icon" href="{{ asset('build/images/backOffice/favicon/apple-touch-icon.png') }}"
          sizes="180x180">
    <link rel="icon" href="{{ asset('build/images/backOffice/favicon/favicon-32x32.png') }}" type="image/png"
          sizes="32x32">
    <link rel="icon" href="{{ asset('build/images/backOffice/favicon/favicon-16x16.png') }}" type="image/png"
          sizes="16x16">
    <link rel="mask-icon" href="{{ asset('build/images/backOffice/favicon/safari-pinned-tab.svg') }}" color="#5bbad5">
    <link rel="manifest" href="{{ asset('build/images/backOffice/favicon/manifest.json') }}">

    <title>
        {% block title %}
            Espace Partenaire
        {% endblock %}
    </title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        {{ encore_entry_link_tags('backOffice') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        {{ encore_entry_script_tags('backOffice') }}
        <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
        <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
    {% endblock %}
</head>
<body>
{% set currentPath = app.request.attributes.get('_route') %}
{% set avecMenu = 'admin_user_login' != currentPath and app.user is not null %}

{# Lien d'évitement (RGAA 12.7) : premier élément focalisable de la page #}
<a href="#contenu" class="lien-evitement">Aller au contenu</a>

{{ render(controller('App\\Controller\\BackOfficeCommonController::layoutHeader', {
    'route': currentPath,
    'routeParams': app.request.attributes.get('_route_params')
})) }}

{% if avecMenu %}
    {{ include('BackOffice/Common/menu_principal.html.twig') }}

    {# Fond sombre du tiroir sur petit écran ; sans effet au clavier, le menu se ferme par Échap #}
    <div class="menu-fond" id="menu-fond" hidden></div>
{% endif %}

{# Icône de la rubrique, posée en variable CSS : elle préfixe le titre de la vue (#container-title) #}
{% set entreeMenu = avecMenu ? menu_bo_entree_courante() : null %}

<main id="contenu"
      class="zone-principale{{ avecMenu ? '' : ' sans-menu' }}"
      {% if entreeMenu is not null %}style="--icone-vue: '{{ entreeMenu.icone_code }}'"{% endif %}>

    {% if avecMenu %}
        {# Destination du bouton « Retour » et maillon supplémentaire, que chaque vue peut imposer #}
        {% set urlRetour %}{% block retour_url %}{% endblock %}{% endset %}
        {% set filArianeComplement %}{% block fil_ariane_complement %}{% endblock %}{% endset %}

        {{ include('BackOffice/Common/entete_vue.html.twig', {
            'urlRetour': urlRetour,
            'filArianeComplement': filArianeComplement
        }) }}
    {% endif %}

    <div class="content">
        <div class="container-fluid">
            <div class="row padding13">
                {{ include('Macros/error.html.twig') }}

                {# Avertissement d'expiration prochaine du mot de passe (Reco-15) #}
                {% set passwordExpiresInDays = password_expires_in_days() %}
                {% if passwordExpiresInDays is not null %}
                    <div class="alert alert-warning col-xs-12 col-sm-12 col-md-6 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-3 col-lg-offset-3 notification" role="alert">
                        <p class="text-center">
                            Votre mot de passe expire {{ passwordExpiresInDays > 1 ? 'dans ' ~ passwordExpiresInDays ~ ' jours' : 'd\'ici demain' }}.
                            <a href="{{ path('admin_password_change') }}" class="alert-link">Le changer maintenant</a>
                        </p>
                    </div>
                {% endif %}

                {% block contents %}
                {% endblock %}
            </div>
        </div>
    </div>

</main>

{#
{{ render(controller('App\\Controller\\BackOfficeCommonController::layoutFooter')) }}
#}

</body>
</html>
