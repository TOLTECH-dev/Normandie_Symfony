{% extends "FrontOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('frontOffice_demande_devis_view') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3" id="title-wrapper">
        <div id="container-title">
            <h2>Consulter ma demande d'aide Travaux (Volet technique)</h2>
            {% if devis.instructionDossierConforme is empty
                and devis.dateCPId is null
                and demande.statutId not in ['15']
            %}
                <a href="{{ path('demande_devis_edit', {'devisId': devis.devisId}) }}"
                   class="btn btn-warning btn-xs"
                   role="button"
                   data-toggle="tooltip"
                   data-placement="bottom"
                   data-container="body"
                   title="Modifier le Devis"
                >
                    <i class="glyphicon glyphicon-edit"></i>
                </a>
            {% endif %}
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 hidden" id="content-wrapper">
        {% set path_location = 'demande_document_fo' %}

        {{ include('FrontOffice/Demande/Devis/inc/view_devis/audit.html.twig') }}
        {{ include('FrontOffice/Demande/Devis/inc/view_devis/document.html.twig') }}
        {{ include('FrontOffice/Demande/Devis/inc/view_devis/type.html.twig') }}
        {{ include('FrontOffice/Demande/Devis/inc/view_devis/plan.html.twig') }}
        {{ include('FrontOffice/Demande/Devis/inc/view_devis/acte_engagement.html.twig') }}
    </div>
{% endblock %}
