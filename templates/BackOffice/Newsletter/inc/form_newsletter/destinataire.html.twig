<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-destinataire">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Liste des Destinataires</legend>

            <div class="wrapper_error">
                {{ form_errors(form.isSentToClient) }}
                {{ form_errors(form.isSentToAuditeur) }}
                {{ form_errors(form.isSentToRenovateur) }}
                {{ form_errors(form.isSentToConseiller) }}
                {{ form_errors(form.isSentToEPCI) }}
                {{ form_errors(form.isSentToBeneficiaire) }}
                {{ form_errors(form.isSentToAdministrateur) }}
                {{ form_errors(form.isSentToInstructeur) }}
                {{ form_errors(form.isSentToTechnique) }}
            </div>

            <div id="box-flex">
                <div id="flex1">
                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToClient) }}
                        </div>
                        {{ form_label(form.isSentToClient, "Région", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>

                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToAuditeur) }}
                        </div>
                        {{ form_label(form.isSentToAuditeur, "Auditeurs", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>

                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToRenovateur) }}
                        </div>
                        {{ form_label(form.isSentToRenovateur, "Rénovateurs", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>

                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToConseiller) }}
                        </div>
                        {{ form_label(form.isSentToConseiller, "Conseillers H&E", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>

                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToEPCI) }}
                        </div>
                        {{ form_label(form.isSentToEPCI, "EPCI", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>

                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToBeneficiaire) }}
                        </div>
                        {{ form_label(form.isSentToBeneficiaire, "Bénéficiaires", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>

                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToAdministrateur) }}
                        </div>
                        {{ form_label(form.isSentToAdministrateur, "Administrateurs", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>

                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToInstructeur) }}
                        </div>
                        {{ form_label(form.isSentToInstructeur, "Instructeurs UP", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>

                    <div class="form-group">
                        <div class="col-xs-1 col-sm-1 col-md-1 col-lg-1">
                            {{ form_widget(form.isSentToTechnique) }}
                        </div>
                        {{ form_label(form.isSentToTechnique, "Technique", {'label_attr': {'class': 'col-xs-10 col-sm-10 col-md-10 col-lg-10 control-label'}}) }}
                    </div>
                </div>

                <div id="flex2">
                    {{ form_widget(form.partenaireType) }}
                </div>
            </div>

    </fieldset>
</div>
