{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_structure_add_edit') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="container-title">
            <h2>Ajouter une Structure H&amp;E</h2>
            {{ include('BackOffice/Structure/inc/back.html.twig') }}
        </div>
    </div>

{{ form_start(form_structure, {'attr': {'class': 'form-horizontal', 'id': 'form_addStructure'}}) }}

{{ form_errors(form_structure) }}

{{ include('BackOffice/Structure/inc/form_structure/identification.html.twig') }}
{{ include('BackOffice/Structure/inc/form_structure/adresse.html.twig') }}
{{ include('BackOffice/Structure/inc/form_structure/statut.html.twig') }}
{{ include('BackOffice/Structure/inc/form_structure/contact.html.twig') }}
{{ include('BackOffice/Structure/inc/form_structure/conseiller.html.twig') }}
{{ include('BackOffice/Structure/inc/form_structure/permanence.html.twig') }}

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
    <div class="form-group">
        {{ form_widget(form_structure.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
    </div>
</div>

{{ form_rest(form_structure) }}

{{ form_end(form_structure) }}

</div>
{% endblock %}


{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_structure_formStructure_index') }}
{% endblock %}
