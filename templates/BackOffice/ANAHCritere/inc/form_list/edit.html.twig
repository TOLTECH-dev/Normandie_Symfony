<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc bloc-formEdit">
    <fieldset>

        {% for key, form_item in formEdit %}
            {% if key == item.id %}

                {{ form_start(form_item, {'attr': {'class': 'form-horizontal'}}) }}
                    {{ form_errors(form_item) }}

                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"></div>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 wrapper_error">{{ form_errors(form_item.nbPersonne) }}</div>
                    <div class="paddingBottom15">
                        {{ form_label(form_item.nbPersonne, "Nombre de personnes", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label'}}) }}

                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                            {{ form_widget(form_item.nbPersonne, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    <br><br>

                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"></div>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 wrapper_error">{{ form_errors(form_item.plafondTresModeste) }}</div>
                    <div class="paddingBottom15">
                        {{ form_label(form_item.plafondTresModeste, "Plafond très modeste (€)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label'}}) }}

                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                            {{ form_widget(form_item.plafondTresModeste, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    <br><br>

                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"></div>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 wrapper_error">{{ form_errors(form_item.supplementTresModeste) }}</div>
                    <div class="paddingBottom15">
                        {{ form_label(form_item.supplementTresModeste, "Supplément très modeste (€)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label'}}) }}

                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                            {{ form_widget(form_item.supplementTresModeste, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    <br><br>

                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"></div>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 wrapper_error">{{ form_errors(form_item.plafondModeste) }}</div>
                    <div class="paddingBottom15">
                        {{ form_label(form_item.plafondModeste, "Plafond modeste (€)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label'}}) }}

                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                            {{ form_widget(form_item.plafondModeste, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    <br><br>

                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"></div>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 wrapper_error">{{ form_errors(form_item.supplementModeste) }}</div>
                    <div class="paddingBottom15">
                        {{ form_label(form_item.supplementModeste, "Supplément modeste (€)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label'}}) }}

                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                            {{ form_widget(form_item.supplementModeste, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    <br><br>

                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"></div>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 wrapper_error">{{ form_errors(form_item.plafondIntermediaire) }}</div>
                    <div class="paddingBottom15">
                        {{ form_label(form_item.plafondIntermediaire, "Plafond intermédiaire (€)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label'}}) }}

                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                            {{ form_widget(form_item.plafondIntermediaire, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    <br><br>

                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"></div>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 wrapper_error">{{ form_errors(form_item.supplementIntermediaire) }}</div>
                    <div>
                        {{ form_label(form_item.supplementIntermediaire, "Supplément intermédiaire (€)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label'}}) }}

                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                            {{ form_widget(form_item.supplementIntermediaire, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    <br>

                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc bloc-submit">
                        <div>
                            {{ form_widget(form_item.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                        </div>
                    </div>

                    {{ form_rest(form_item) }}
                {{ form_end(form_item) }}

            {% endif %}
        {% endfor %}

    </fieldset>
</div>
