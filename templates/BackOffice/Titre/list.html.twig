{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_titre_list') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
            <div id="container-title">
                <h2>Liste des Ch&egrave;ques &eacute;mis</h2>
            </div>
        </div>

        <table cellspacing="0" id="table_list_titre" class="table table-striped table-bordered big_table">
            <thead>
                <tr>
                    <th class="col0 with_select breakWord header" data-fieldCode="demandeType">Th&eacute;matique</th>
                    <th class="col1 with_search breakWord header" data-fieldCode="beneficiaire">B&eacute;n&eacute;ficiaire</th>
                    <th class="col2 with_search breakWord header" data-fieldCode="demandeId">N&deg; dossier</th>
                    <th class="col3 with_search breakWord header" data-fieldCode="productionId">N&deg; production</th>
                    <th class="col4 with_search breakWord header" data-fieldCode="numeroCheque">N&deg; ch&egrave;que</th>
                    <th class="col5 with_search breakWord header col_valeurTitre" data-fieldCode="valeurTitre">Valeur titre</th>
                    <th class="col6 with_search breakWord header" data-fieldCode="dateEmission">Date &eacute;mission</th>
                    <th class="col7 with_search breakWord header" data-fieldCode="dateValidite">Date validit&eacute;</th>
                    <th class="col8 col_action header" data-fieldCode="action">Action</th>
                </tr>
            </thead>

            {% if recordsTotal and (recordsTotal is not null or recordsTotal != 0) %}
                <tfoot>
                    <tr id="filterrow">
                        <th class="with_select">Th&eacute;matique</th>
                        <th class="with_search">B&eacute;n&eacute;ficiaire</th>
                        <th class="with_search">N&deg; dossier</th>
                        <th class="with_search">N&deg; production</th>
                        <th class="with_search">N&deg; ch&egrave;que</th>
                        <th class="with_search">Valeur titre</th>
                        <th class="with_search">Date &eacute;mission</th>
                        <th class="with_search">Date validit&eacute;</th>
                        <th class="text-center">
                            <button type="button"
                                    role="button"
                                    class="btn btn-danger btn-xs"
                                    data-toggle="tooltip"
                                    data-placement="bottom"
                                    data-container="body"
                                    title="Vider les champs de recherche"
                                    id="clear_search_input"
                            >
                                <i class="glyphicon glyphicon-erase"></i>
                            </button>
                        </th>
                    </tr>
                </tfoot>
            {% endif %}

            <tbody>
                <div id="js-roles" class="hidden"
                     data-is-admin="{% if is_granted('ROLE_ADMIN') %}1{% else %}0{% endif %}"
                     data-is-client="{% if is_granted('ROLE_CLIENT') %}1{% else %}0{% endif %}"
                >
                </div>
            </tbody>

        </table>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_titre_index') }}
{% endblock %}
