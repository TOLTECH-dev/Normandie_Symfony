{% extends "FrontOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('frontOffice_beneficiaire_add_edit') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('frontOffice_beneficiaire_index') }}
    <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
    <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3" id="title-wrapper">
        <div id="container-title">
            <h2>Saisie de mes informations personnelles</h2>
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 hidden" id="content-wrapper">
        {{ form_start(form, {'attr': {'class': 'form-horizontal', 'id': 'form_editBeneficiaire'}}) }}

            {{ form_errors(form) }}

            {{ include('FrontOffice/Beneficiaire/inc/form_beneficiaire/identification.html.twig') }}
            {{ include('FrontOffice/Beneficiaire/inc/form_beneficiaire/adresse.html.twig') }}
            {{ include('FrontOffice/Beneficiaire/inc/form_beneficiaire/situation.html.twig') }}
            {{ include('FrontOffice/Beneficiaire/inc/form_beneficiaire/dispositif.html.twig') }}
            {{ include('FrontOffice/Beneficiaire/inc/form_beneficiaire/structure.html.twig') }}

            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                <div class="form-group">
                    {{ form_widget(form.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                </div>
                <div>
                    {{ include('FrontOffice/Common/mentionsCNIL.html.twig') }}
                </div>
            </div>

            {{ form_rest(form) }}

        {{ form_end(form) }}

        <div id="data-js-bundle" class="hidden" data-prefix-pathname-bundle="{{ prefix_pathname_bundle_fo }}">
        </div>
    </div>
{% endblock %}
