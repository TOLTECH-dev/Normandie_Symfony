{#
    Connexion à l'espace bénéficiaire (route user_login, SecurityController::loginUser).

    Même ergonomie que la connexion au back-office (BackOffice/Security/login.html.twig).
    Création de compte selon isShowDemandeCreateAction (date APP_DATE_LIMITE_CREATION_DEMANDE_MEMBER) :
    - inscriptions ouvertes : lien « Créer un compte » sous la carte ;
    - inscriptions fermées : information sur l'inscription par un conseiller, dans le panneau
      d'identité sur grand écran, sous la carte sur petit écran (une seule version visible, cf.
      auth_layout.css), pour ne pas allonger le panneau du formulaire.

    L'identifiant des bénéficiaires est leur adresse e-mail (recopiée à la création de compte).
    Le bouton FranceConnect, désactivé, figure dans l'historique git de ce fichier.
#}
{% extends "Main/Security/layout_auth.html.twig" %}
{% import "Macros/captcha.html.twig" as captcha %}

{% block title %}Connexion{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if cachedUserIsCaptchaItemValue is defined and cachedUserIsCaptchaItemValue %}
        <script src="https://www.google.com/recaptcha/api.js?hl=fr" type="text/javascript" async defer></script>
    {% endif %}
{% endblock %}

{% block brand_extra %}
    {% if isShowDemandeCreateAction is empty %}
        <div class="auth-notice auth-notice-brand">
            {{ include('Main/Security/_registration_closed_notice.html.twig') }}
        </div>
    {% endif %}
{% endblock %}

{% block card %}
    <div class="auth-card">
        <div class="auth-card-header">
            <h2 class="auth-card-title">Connexion</h2>
            <p class="auth-card-subtitle">Saisissez vos identifiants pour acc&eacute;der &agrave; votre espace personnel.</p>
        </div>

        {{ include('BackOffice/Security/_auth_messages.html.twig') }}

        <form action="{{ path('user_login') }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

            <div class="auth-field">
                <label for="username">Adresse e-mail</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" class="auth-input"
                       required="required" inputmode="email" autocomplete="username" autofocus />
            </div>

            <div class="auth-field">
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" class="auth-input"
                       required="required" autocomplete="current-password" />
            </div>

            {% if cachedUserIsCaptchaItemValue is defined and cachedUserIsCaptchaItemValue %}
                <div class="auth-captcha">
                    {{ captcha.recaptcha(recaptcha_client_key, 'light') }}
                </div>
            {% endif %}

            <button type="submit" class="auth-submit" id="_submit" name="_submit">Se connecter</button>
        </form>

        <div class="auth-card-footer">
            <a href="{{ path('user_resetting_request') }}">Mot de passe oubli&eacute; ?</a>
        </div>
    </div>

    {% if isShowDemandeCreateAction is not empty %}
        <div class="auth-notice">
            <h2 class="auth-notice-title">Pas encore de compte ?</h2>
            <p>Si vous n'avez pas d'espace personnel, cr&eacute;ez-en un pour acc&eacute;der &agrave; votre espace personnel.</p>
            <a href="{{ path('user_registration') }}" class="auth-notice-action">Cr&eacute;er un compte</a>
        </div>
    {% else %}
        <div class="auth-notice auth-notice-panel">
            {{ include('Main/Security/_registration_closed_notice.html.twig') }}
        </div>
    {% endif %}

    {#
        Pour maintenance : remplacer le contenu de ce bloc par
        <div class="auth-card">
            <div class="auth-card-header">
                <h2 class="auth-card-title">Site en maintenance</h2>
                <p class="auth-card-subtitle">Ch&egrave;que &eacute;co-&eacute;nergie Normandie est en cours de maintenance.
                    Nous serons de retour tr&egrave;s bient&ocirc;t. Merci de votre patience.</p>
            </div>
        </div>
    #}
{% endblock %}
