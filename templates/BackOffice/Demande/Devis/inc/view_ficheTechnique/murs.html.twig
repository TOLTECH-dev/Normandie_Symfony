<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-murs">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Murs</legend>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">Surface (m<sup>2</sup>)</label>
            </div>
            <div class="flex1 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_initial.mursSurface ? ficheTechnique.ficheTechnique_initial.mursSurface : '-' }}
            </div>
            <div class="flex2 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_BBC.mursSurface ? ficheTechnique.ficheTechnique_BBC.mursSurface : '-' }}
            </div>
            <div class="flex3 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_prescription.mursSurface ? ficheTechnique.ficheTechnique_prescription.mursSurface : '-' }}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 form-control fontSize9">
                    {{ ficheTechnique.ficheTechnique_finChantier.mursSurface ? ficheTechnique.ficheTechnique_finChantier.mursSurface : '-' }}
                </div>
            {% endif %}
        </div>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">R (m<sup>2</sup>.K/W)</label>
            </div>
            <div class="flex1 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_initial.mursR ? ficheTechnique.ficheTechnique_initial.mursR : '-' }}
            </div>
            <div class="flex2 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_BBC.mursR ? ficheTechnique.ficheTechnique_BBC.mursR : '-' }}
            </div>
            <div class="flex3 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_prescription.mursR ? ficheTechnique.ficheTechnique_prescription.mursR : '-' }}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 form-control fontSize9">
                    {{ ficheTechnique.ficheTechnique_finChantier.mursR ? ficheTechnique.ficheTechnique_finChantier.mursR : '-' }}
                </div>
            {% endif %}
        </div>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">Information &eacute;tanch&eacute;it&eacute; &agrave; l'air et migration vapeur d'eau</label>
            </div>
            <div class="flex1 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_initial.mursEtancheite %}
                    {{ ficheTechnique.ficheTechnique_initial.mursEtancheite }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex2 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_BBC.mursEtancheite %}
                    {{ ficheTechnique.ficheTechnique_BBC.mursEtancheite }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex3 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_prescription.mursEtancheite %}
                    {{ ficheTechnique.ficheTechnique_prescription.mursEtancheite }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 marginTop7 fontSize9">
                    {% if ficheTechnique.ficheTechnique_finChantier.mursEtancheite %}
                        {{ ficheTechnique.ficheTechnique_finChantier.mursEtancheite }}
                    {% else %}
                        <p class="text-center">-</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">Jonction murs / planchers y compris interm&eacute;diaires</label>
            </div>
            <div class="flex1 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_initial.mursJonctionMursPlanchers %}
                    {{ ficheTechnique.ficheTechnique_initial.mursJonctionMursPlanchers }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex2 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_BBC.mursJonctionMursPlanchers %}
                    {{ ficheTechnique.ficheTechnique_BBC.mursJonctionMursPlanchers }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex3 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_prescription.mursJonctionMursPlanchers %}
                    {{ ficheTechnique.ficheTechnique_prescription.mursJonctionMursPlanchers }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 marginTop7 fontSize9">
                    {% if ficheTechnique.ficheTechnique_finChantier.mursJonctionMursPlanchers %}
                        {{ ficheTechnique.ficheTechnique_finChantier.mursJonctionMursPlanchers }}
                    {% else %}
                        <p class="text-center">-</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
