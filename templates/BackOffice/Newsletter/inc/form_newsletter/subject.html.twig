<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-subject">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Objet de l'email</legend>

        <div class="form-group">
            {{ form_label(form.subject, "Saisir l'objet de l'email", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form.subject) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.subject, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
