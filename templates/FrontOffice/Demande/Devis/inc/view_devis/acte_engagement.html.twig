<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-acte-engagement">
    <hr class="bloc-limit">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Votre Acte d'engagement dans le cadre d'un accompagnement par un Espace Conseil France R&eacute;nov&apos;</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Votre acte :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {% if devis and devis.acteEngagementAlt %}
                    <a href="{{ path(path_location, {'demandeId': devis.devisId, 'typeFile': 15, 'extension': devis.acteEngagementUrl, 'typeDemande': 2}) }}" target="_blank">
                        Voir le document
                    </a>
                {% else %}
                    Aucun document t&eacute;l&eacute;charg&eacute;
                {% endif %}
            </div>
        </div>

    </fieldset>

</div>
