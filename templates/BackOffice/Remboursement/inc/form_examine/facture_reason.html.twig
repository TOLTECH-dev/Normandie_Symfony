<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc hidden" id="bloc-factureCase">
    <hr class="bloc-limit">

    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Cocher une ou plusieurs cases selon les non-conformit&eacute;s de la facture</legend>

        <div class="form-group">
            {{ form_label(formInstruction.factureReason, "", {'label_attr': {'class': 'col-xs-0 col-sm-0 col-md-0 col-lg-0 control-label'}}) }}
            {{ form_errors(formInstruction.factureReason) }}

            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                {{ form_widget(formInstruction.factureReason, {'attr': {'class': 'factureReason'}}) }}
            </div>
        </div>

    </fieldset>

</div>
