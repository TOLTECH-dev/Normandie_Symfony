            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form_EPCI.ville, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
        
    </fieldset>

    <hr class="bloc-limit">
