<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-optionRenovateur">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Option</legend>

        {% set typeActeur = {
        '0 | architecte': 'Architecte',
        '1 | moe': 'Maitre d\'oeuvre',
        '2 | entreprise': 'Entreprise',
        '3 | artisan': 'Artisan',
        '4 | cooperative': 'Coopérative',
        '5 | autre': 'Autre',
        '': '-'
        } %}

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Type d'acteur :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ typeActeur[partenaire.partenaire_optionRenovateur.typeActeur] }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Compl&eacute;ment d'identification :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ partenaire.partenaire_optionRenovateur.complement ? partenaire.partenaire_optionRenovateur.complement : '-' }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
