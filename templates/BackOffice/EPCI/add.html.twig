{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_EPCI_add_edit') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div id="container-title">
                <h2>Ajouter une EPCI</h2>
                {{ include('BackOffice/EPCI/inc/back.html.twig') }}
            </div>
        </div>

        {{ form_start(form_EPCI, {'attr': {'class': 'form-horizontal', 'id': 'form_addEPCI'}}) }}

            {{ form_errors(form_EPCI) }}

            {{ include('BackOffice/EPCI/inc/form_EPCI/identification.html.twig') }}
            {{ include('BackOffice/EPCI/inc/form_EPCI/adresse.html.twig') }}
            {{ include('BackOffice/EPCI/inc/form_EPCI/information.html.twig') }}
            {{ include('BackOffice/EPCI/inc/form_EPCI/participation_sare.html.twig') }}
            {{ include('BackOffice/EPCI/inc/form_EPCI/point_entree_structure.html.twig') }}
            {{ include('BackOffice/EPCI/inc/form_EPCI/statut.html.twig') }}
            {{ include('BackOffice/EPCI/inc/form_EPCI/contact.html.twig') }}
            {{ include('BackOffice/EPCI/inc/form_EPCI/permanence.html.twig') }}

            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                <div class="form-group">
                    {{ form_widget(form_EPCI.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                </div>
            </div>

            {{ form_rest(form_EPCI) }}

        {{ form_end(form_EPCI) }}

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_EPCI_index') }}
{% endblock %}
