{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_EPCI_list') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
        <div id="container-title">
            <h2>Liste des EPCI</h2>
        </div>
    </div>

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom10">
    <p class="text-center">
        <a href="{{ path('EPCI_add') }}"
           class="btn btn-primary btn-xs"
           role="button"
           data-toggle="tooltip"
           data-placement="bottom"
           data-container="body"
           title="Cr&eacute;er une nouvelle EPCI"
        >
            <i class="glyphicon glyphicon-plus"></i> <span class="bold">Cr&eacute;er une EPCI</span>
        </a>
    </p>
</div>

<table cellspacing="0" id="table_list_EPCI" class="table table-striped table-bordered big_table">
    <thead>
    <tr>
        <th class="breakWord col0">Nom</th>
        <th class="breakWord col1">Adresse 1</th>
        <th class="breakWord col2">Code Postal</th>
        <th class="breakWord col3">Ville</th>
        <th class="breakWord col4">T&eacute;l&eacute;phone</th>
        <th class="breakWord col5">Courriel</th>
        <th class="breakWord col6">Participation au SARE</th>
        <th class="breakWord col7">Statut</th>
    </tr>
    </thead>
    <tbody>
        {% for item in list_EPCI %}
            <tr>
                <td>
                    <a href="{{ path('EPCI_view', {'EPCIId': item.id}) }}"
                       data-toggle="tooltip"
                       data-placement="bottom"
                       data-container="body"
                       title="Consulter l'EPCI"
                    >
                    {{ item.nom }}
                    </a>
                </td>
                <td>{{ item.adresse1 }}</td>
                <td>{{ item.codePostal }}</td>
                <td>{{ item.ville }}</td>
                <td>{{ item.telephone }}</td>
                <td>{{ item.email }}</td>
                {% if 1 == item.enabled %}
                    {% set statut = 'Actif' %}
                {% else %}
                    {% set statut = 'Inactif' %}
                    {% if item.dateInactif is defined and item.dateInactif %}
                        {% set statut = statut ~ ' depuis le ' ~ item.dateInactif|date('d/m/Y') %}
                    {% endif %}
                {% endif %}
                <td>
                    {% if item.participationSARE is not null %}
                        {{ item.participationSARE ? 'OUI' : 'NON'  }}
                    {% else %}
                        -
                    {% endif %}
                </td>
                <td>{{ statut }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_EPCI_index') }}
{% endblock %}
