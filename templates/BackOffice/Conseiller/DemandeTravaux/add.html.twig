{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('frontOffice_core_form') }}
    {{ encore_entry_link_tags('frontOffice_demande_travaux_add_edit') }}
    {{ encore_entry_link_tags('frontOffice_common_menu') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3" id="title-wrapper">
        <div id="container-title">
            <h2>Compl&eacute;ter une demande d'Aide Travaux (Volet administratif)</h2>
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 hidden" id="content-wrapper">
        {{ form_start(form, {'attr': {'class': 'form-horizontal', 'id': 'form_addTravaux'}}) }}

            {{ form_errors(form) }}

            {% set path_location = 'demande_document_bo' %}

            {% set proprio = logement.situation|split(' | ') %}
            <input type="hidden" value="{{ proprio[0] }}" id="situationLogement_value" />

            <input type="hidden" value="{{ auditE|length }}" id="auditE_value" />
            <input type="hidden" value="true" id="demandeTravauxIsCreate" />
            <input type="hidden" value="{{ auditE.statutId is defined ? auditE.statutId : '' }}" id="auditE_statut" />
            <input type="hidden" value="{{ remboursementAuditStatutId }}" id="remboursementAuditStatutId" />

            {{ include('FrontOffice/Demande/Travaux/inc/form_travaux/audit.html.twig') }}
            {{ include('FrontOffice/Demande/Travaux/inc/form_travaux/revenu.html.twig') }}
            {{ include('FrontOffice/Demande/Travaux/inc/form_travaux/structure.html.twig') }}
            {{ include('FrontOffice/Demande/Travaux/inc/form_travaux/signature.html.twig') }}

            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                <div class="form-group">
                    {{ form_widget(form.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                </div>
                <div>
                    {{ include('FrontOffice/Common/mentionsCNIL.html.twig') }}
                </div>
            </div>

            {{ form_rest(form) }}

        {{ form_end(form) }}

        <div id="data-js-bundle" class="hidden" data-prefix-pathname-bundle="{{ prefix_pathname_bundle_bo }}">
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('frontOffice_demande_checkFile') }}
    {{ encore_entry_script_tags('frontOffice_demande_formTravaux_index') }}
{% endblock %}

