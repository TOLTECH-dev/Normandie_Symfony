{#
    Création de compte bénéficiaire (route user_registration, RegistrationController::register).

    Même ergonomie que les autres pages d'authentification (gabarit Main/Security/layout_auth), avec
    un panneau d'identité réduit et un formulaire étendu sur deux colonnes (classe auth-page-wide,
    styles de l'entrée "register").

    Scripts de l'entrée registerForm, qui s'appuient sur des identifiants à ne pas renommer :
    - assets/js/main/passwordValidation.js : password, password_repeat, pswd_*, result,
      password_match_message ;
    - assets/js/main/persistUsername.js : recopie l'adresse e-mail (#email) dans l'identifiant
      caché (#username).
#}
{% extends "Main/Security/layout_auth.html.twig" %}
{% import "Macros/captcha.html.twig" as captcha %}

{% block title %}Création de compte{% endblock %}

{% block body_class %}auth-page-wide{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('register') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('registerForm') }}
    <script src="https://www.google.com/recaptcha/api.js?hl=fr" type="text/javascript" async defer></script>
{% endblock %}

{% block card %}
    <div class="auth-card auth-card-wide">
        <div class="auth-card-header">
            <h2 class="auth-card-title">Cr&eacute;ation de compte</h2>
            <p class="auth-card-subtitle">Cr&eacute;ez votre espace personnel pour suivre vos demandes d'aide.</p>
        </div>

        {{ include('BackOffice/Security/_auth_messages.html.twig') }}

        {{ form_start(form, {'action': path('user_registration'), 'attr': {'id': 'form_register', 'class': 'auth-password-form'}}) }}

            {# Erreurs globales (ex. jeton CSRF) #}
            {% for error in form.vars.errors %}
                <div class="auth-alert" role="alert">{{ error.message }}</div>
            {% endfor %}

            <div class="auth-grid">
                <div class="auth-field">
                    {{ form_label(form.firstname) }}
                    {{ form_widget(form.firstname, {'attr': {'class': 'auth-input', 'autocomplete': 'given-name'}}) }}
                    {% for error in form.firstname.vars.errors %}
                        <p class="auth-field-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div class="auth-field">
                    {{ form_label(form.lastname) }}
                    {{ form_widget(form.lastname, {'attr': {'class': 'auth-input', 'autocomplete': 'family-name'}}) }}
                    {% for error in form.lastname.vars.errors %}
                        <p class="auth-field-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div class="auth-field">
                    <label for="email">{{ form.email.first.vars.label }}</label>
                    {{ form_widget(form.email.first, {'id': 'email', 'attr': {'class': 'auth-input', 'autocomplete': 'email'}}) }}
                    {# Non-correspondance (RepeatedType), format, et compte existant : l'identifiant est l'adresse e-mail #}
                    {% for error in form.email.vars.errors|merge(form.email.first.vars.errors)|merge(form.username.vars.errors) %}
                        <p class="auth-field-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div class="auth-field">
                    <label for="email_repeat">{{ form.email.second.vars.label }}</label>
                    {{ form_widget(form.email.second, {'id': 'email_repeat', 'attr': {'class': 'auth-input', 'autocomplete': 'email'}}) }}
                    {% for error in form.email.second.vars.errors %}
                        <p class="auth-field-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div class="auth-password-rules auth-grid-full" id="pswd_info">
                    <p>Votre mot de passe doit contenir :</p>
                    <ul>
                        <li id="pswd_letter" class="invalid">une lettre minuscule</li>
                        <li id="pswd_capital" class="invalid">une lettre majuscule</li>
                        <li id="pswd_number" class="invalid">un chiffre</li>
                        <li id="pswd_special_character" class="invalid">un caract&egrave;re sp&eacute;cial</li>
                        <li id="pswd_length" class="invalid">au moins 12 caract&egrave;res</li>
                    </ul>
                </div>

                <div class="auth-field">
                    <div class="auth-field-label-row">
                        <label for="password">{{ form.password.first.vars.label }}</label>
                        <span id="result" aria-live="polite"></span>
                    </div>
                    {{ form_widget(form.password.first, {'id': 'password', 'attr': {'class': 'auth-input', 'autocomplete': 'new-password', 'aria-describedby': 'pswd_info'}}) }}
                    {# Le message « Les mots de passe ne correspondent pas » est rattaché à ce champ par RepeatedType #}
                    {% for error in form.password.vars.errors|merge(form.password.first.vars.errors) %}
                        <p class="auth-field-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div class="auth-field">
                    <label for="password_repeat">{{ form.password.second.vars.label }}</label>
                    {{ form_widget(form.password.second, {'id': 'password_repeat', 'attr': {'class': 'auth-input', 'autocomplete': 'new-password'}}) }}
                    <small id="password_match_message" aria-live="polite" style="display:none;"></small>
                    {% for error in form.password.second.vars.errors %}
                        <p class="auth-field-error">{{ error.message }}</p>
                    {% endfor %}
                </div>
            </div>

            {{ form_widget(form.username, {'id': 'username', 'type': 'hidden'}) }}

            <div class="auth-form-actions">
                <div class="auth-captcha">
                    {{ captcha.recaptcha(recaptcha_client_key, 'light') }}
                </div>

                <button type="submit" class="auth-submit" name="_submit">Cr&eacute;er un compte</button>
            </div>

        {{ form_end(form) }}

        <div class="auth-card-footer">
            Vous avez d&eacute;j&agrave; un compte ? <a href="{{ path('user_login') }}">Se connecter</a>
        </div>
    </div>
{% endblock %}
