<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-email">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Contenu de l'email</legend>

<ul id="custom-control_file" class="list_error"></ul>
{{ form_errors(form.file) }}
<div class="form-group">
    {{ form_label(form.file, "Téléchargement de la newsletter (format HTML)", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
        {{ form_widget(form.file, {'attr': {'class': 'custom-file'}}) }}
    </div>
</div>

<br><p class="bold text-center">OU<br>(Si les 2 champs sont remplis, le fichier t&eacute;l&eacute;charg&eacute; sera pris en compte)</p><br>

<div class="form-group">
    {{ form_label(form.email, "Saisir le texte de l'email", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
    {{ form_errors(form.email) }}

    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
    </div>
</div>

    </fieldset>

    <hr class="bloc-limit">
</div>
