<table cellpadding="0" cellspacing="0" align="left" border="0" style="margin-left: 90px;">
    <tr>
        <td><div class="legend-icon">&nbsp;</div></td>
        <td class="title2">&nbsp;Historique des commentaires</td>
    </tr>
</table>
<br>

<table cellpadding="0" cellspacing="5" align="left" border="0" style="margin-left: 90px;">
    {% for item in listCommentaire %}
        <tr>
            <td colspan="2">{{ item.ratingAuteur }} &nbsp;&nbsp;&nbsp; Dossier n&deg;{{ item.demandeId }} - {{ item.ratingDate }} :</td>
        </tr>
        {% if '3' == item.ratingScore %}
            <tr>
                <td><div class="circle circleScoreParfait"></div></td>
                <td class="scoreParfait" style="text-align: left;">Bon</td>
            </tr>
        {% elseif '2' == item.ratingScore %}
            <tr>
                <td><div class="circle circleScoreMoyen"></div></td>
                <td class="scoreMoyen" style="text-align: left">Moyen</td>
            </tr>
        {% elseif '1' == item.ratingScore %}
            <tr>
                <td><div class="circle circleScoreMauvais"></div></td>
                <td class="scoreMauvais" style="text-align: left">Mauvais</td>
            </tr>
        {% endif %}
        <tr>
            <td colspan="2">
                <br>
            </td>
        </tr>
        <tr>
            <td>
                &nbsp;
            </td>
            <td style="width: 545px">
                <div class="textGris">{{ item.ratingCommentaire|nl2br }}</div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                {% if loop.last %}
                    &nbsp;
                {% else %}
                    <hr class="orange">
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="2" class="textBold" style="text-align: center;">
                <div>Aucun commentaire.</div>
            </td>
        </tr>
    {% endfor %}
</table>
