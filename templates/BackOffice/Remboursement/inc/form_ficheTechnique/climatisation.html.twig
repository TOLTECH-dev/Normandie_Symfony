<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-climatisation">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Autres &eacute;quipements</legend>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_label(formFicheTechnique.ficheTechnique_initial.climatisation, "Climatisation", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
                {{ form_errors(formFicheTechnique.ficheTechnique_initial.climatisation) }}
            </div>
            <div class="flex1">
                {{ form_widget(formFicheTechnique.ficheTechnique_initial.climatisation, {'attr': attrDefault}) }}
            </div>
            <div class="flex2">
                {{ form_widget(formFicheTechnique.ficheTechnique_BBC.climatisation, {'attr': attrDefault}) }}
            </div>
            <div class="flex3">
                {{ form_widget(formFicheTechnique.ficheTechnique_prescription.climatisation, {'attr': {'class': 'form-control', 'readonly': true}}) }}
            </div>
            <div class="flex4">
                {{ form_widget(formFicheTechnique.ficheTechnique_finChantier.climatisation, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_label(formFicheTechnique.ficheTechnique_initial.climatisationTypeVentilation, "Ventilation", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
                {{ form_errors(formFicheTechnique.ficheTechnique_initial.climatisationTypeVentilation) }}
            </div>
            <div class="flex1">
                {{ form_widget(formFicheTechnique.ficheTechnique_initial.climatisationTypeVentilation, {'attr': attrTypeVentilation}) }}
            </div>
            <div class="flex2">
                {{ form_widget(formFicheTechnique.ficheTechnique_BBC.climatisationTypeVentilation, {'attr': attrTypeVentilation}) }}
            </div>
            <div class="flex3">
                {{ form_widget(formFicheTechnique.ficheTechnique_prescription.climatisationTypeVentilation, {'attr': {'class': 'form-control isReadonly', 'readonly': true}}) }}
            </div>
            <div class="flex4">
                {{ form_widget(formFicheTechnique.ficheTechnique_finChantier.climatisationTypeVentilation, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
