{% extends "FrontOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('frontOffice_demande_auditEnergie_view') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3" id="title-wrapper">
        <div id="container-title">
            <h2>Consulter ma demande d'{{ demandeTypeLabel }}</h2>
            {% if demande.dateCPId is null and demande.statutId not in ['15'] %}
            <a href="{{ path('demande_auditEnergie_edit', {'demandeId': demande.demandeId}) }}"
               class="btn btn-warning btn-xs"
               role="button"
               data-toggle="tooltip"
               data-placement="bottom"
               data-container="body"
               title="Modifier la demande"
            >
                <i class="glyphicon glyphicon-edit"></i>
            </a>
            {% endif %}
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 hidden" id="content-wrapper">
        {% set path_location = 'demande_document_fo' %}

        {{ include('FrontOffice/Demande/AuditEnergie/inc/view_auditEnergie/document.html.twig') }}
        {{ include('FrontOffice/Demande/AuditEnergie/inc/view_auditEnergie/revenu.html.twig') }}
        {{ include('FrontOffice/Demande/AuditEnergie/inc/view_auditEnergie/structure.html.twig') }}
        {{ include('FrontOffice/Demande/AuditEnergie/inc/view_auditEnergie/auditeur.html.twig') }}
        {{ include('FrontOffice/Demande/AuditEnergie/inc/view_auditEnergie/signature.html.twig') }}
    </div>
{% endblock %}
