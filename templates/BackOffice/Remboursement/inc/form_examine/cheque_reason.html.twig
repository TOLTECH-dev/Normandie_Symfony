<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc hidden" id="bloc-chequeCase">
    <hr class="bloc-limit">
    
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Cocher une ou plusieurs cases selon les non-conformit&eacute;s du Ch&egrave;que</legend>

        <div class="form-group">
            {{ form_label(formInstruction.chequeReason, "", {'label_attr': {'class': 'col-xs-0 col-sm-0 col-md-0 col-lg-0 control-label'}}) }}
