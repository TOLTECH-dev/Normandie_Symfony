<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-conseiller">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Conseiller</legend>

        {% if structure.structureConseiller is empty %}
            <p class="text-center bold">Aucun conseiller cr&eacute;&eacute;.</p>
        {% else %}
            {% set j = 1 %}
            {% for item in structure.structureConseiller %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Conseiller {{ j }}:</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    <ul class="noMmargin noPadding noPuce">
                        <li>{{ item.nom }}</li>
                        <li>{{ item.prenom }}</li>
                        <li>{{ item.telephone }}</li>
                        <li>{{ item.email }}</li>

                        {% if 0 == item.enabled %}
                            {% set statut = 'Inactif depuis le ' %}
                            <li>{{ statut }} | {{ item.dateInactif |date('d/m/Y') }}</li>
                        {% elseif 1 == item.enabled %}
                            {% set statut = 'Actif' %}
                            <li>{{ statut }}</li>
                        {% endif %}

                        <ul>
                            {% for row in item.departementIntervention %}
                                <li>{{ row.slug }}</li>
                            {% endfor %}
                        </ul>
                    </ul>
                </div>
            </div>
            {% set j = j+ 1 %}
            {% endfor %}
        {% endif %}

    </fieldset>

    <hr class="bloc-limit">
</div>
