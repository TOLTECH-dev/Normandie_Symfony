<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-chauffage">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Chauffage</legend>

        <div class="flex-wrapper">

            <div class="flex0">
                {{ form_label(formFicheTechnique.ficheTechnique_initial.chauffageEnergie, "Energie", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
                {{ form_errors(formFicheTechnique.ficheTechnique_initial.chauffageEnergie) }}
            </div>
            <div class="flex1 bloc-selectMultiple {{ classCheckboxMultiple }}">
                {{ form_widget(formFicheTechnique.ficheTechnique_initial.chauffageEnergie, {'attr': attrCheckboxMultiple}) }}
            </div>
            <div class="flex2 bloc-selectMultiple {{ classCheckboxMultiple }}">
                {{ form_widget(formFicheTechnique.ficheTechnique_BBC.chauffageEnergie, {'attr': attrCheckboxMultiple}) }}
            </div>
            <div class="flex3 bloc-selectMultiple isReadonly">
                {{ form_widget(formFicheTechnique.ficheTechnique_prescription.chauffageEnergie, {'attr': {'class': 'isReadonly', 'readonly': true}}) }}
            </div>
            <div class="flex4 bloc-selectMultiple">
                {{ form_widget(formFicheTechnique.ficheTechnique_finChantier.chauffageEnergie) }}
            </div>
        </div>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_label(formFicheTechnique.ficheTechnique_initial.chauffageEquipement, "Equipement", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label'}}) }}
                {{ form_errors(formFicheTechnique.ficheTechnique_initial.chauffageEquipement) }}
            </div>
            <div class="flex1">
                {{ form_widget(formFicheTechnique.ficheTechnique_initial.chauffageEquipement, {'attr': attrDefault}) }}
            </div>
            <div class="flex2">
                {{ form_widget(formFicheTechnique.ficheTechnique_BBC.chauffageEquipement, {'attr': attrDefault}) }}
            </div>
            <div class="flex3">
                {{ form_widget(formFicheTechnique.ficheTechnique_prescription.chauffageEquipement, {'attr': {'class': 'form-control', 'readonly': true}}) }}
            </div>
            <div class="flex4">
                {{ form_widget(formFicheTechnique.ficheTechnique_finChantier.chauffageEquipement, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
