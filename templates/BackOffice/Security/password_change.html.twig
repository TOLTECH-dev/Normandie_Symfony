{#
    Renouvellement du mot de passe par l'utilisateur connecté (Reco-15), à la demande ou imposé à
    l'expiration. Champs du nouveau mot de passe : _new_password_fields.html.twig.
#}
{% extends "BackOffice/Security/layout_auth.html.twig" %}

{% block title %}Changer mon mot de passe{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('passwordValidation') }}
{% endblock %}

{% block card %}
    <div class="auth-card">
        <div class="auth-card-header">
            <h2 class="auth-card-title">Changer mon mot de passe</h2>
            <p class="auth-card-subtitle">
                {% if isExpired %}
                    Votre mot de passe a expir&eacute;. Choisissez-en un nouveau pour acc&eacute;der &agrave; votre espace.
                {% elseif expirationDate %}
                    Votre mot de passe actuel expire le {{ expirationDate|date('d/m/Y') }}.
                {% else %}
                    Choisissez le mot de passe qui remplacera votre mot de passe actuel.
                {% endif %}
            </p>
        </div>

        {{ include('BackOffice/Security/_auth_messages.html.twig') }}

        {{ form_start(form, {'attr': {'id': 'form_password_change', 'class': 'auth-password-form'}}) }}

            {# Erreurs globales (ex. jeton CSRF) #}
            {% for error in form.vars.errors %}
                <div class="auth-alert" role="alert">{{ error.message }}</div>
            {% endfor %}

            <div class="auth-field">
                <label for="current_password">{{ form.currentPassword.vars.label }}</label>
                {{ form_widget(form.currentPassword, {'id': 'current_password', 'attr': {'class': 'auth-input', 'autocomplete': 'current-password', 'autofocus': 'autofocus'}}) }}
                {% for error in form.currentPassword.vars.errors %}
                    <p class="auth-field-error">{{ error.message }}</p>
                {% endfor %}
            </div>

            {{ include('BackOffice/Security/_new_password_fields.html.twig', {'field': form.newPassword}) }}

            <button type="submit" class="auth-submit" name="_submit">Enregistrer le nouveau mot de passe</button>

        {{ form_end(form) }}

        <div class="auth-card-footer">
            {% if not isExpired %}
                <a href="{{ path(homeRoute) }}">Retour &agrave; mon espace</a>
                &nbsp;&middot;&nbsp;
            {% endif %}
            <a href="{{ path('admin_user_logout') }}">Se d&eacute;connecter</a>
        </div>
    </div>
{% endblock %}
