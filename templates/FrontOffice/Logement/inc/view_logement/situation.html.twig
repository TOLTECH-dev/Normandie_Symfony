<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-situation">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Situation pour ce logement</legend>

        {% set situationArray = {
        '0 | proprietaire_occupant': 'Propriétaire occupant ou en cours d\'acquisition',
        '1 | proprietaire_bailleur': 'Propriétaire bailleur',
        '2 | locataire': 'Locataire',
        '': '-'
        } %}

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Votre situation :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ situationArray[logement.situation] }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
