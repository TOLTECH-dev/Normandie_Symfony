<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-audit">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Votre Audit</legend>

        <ul id="custom-control_audit" class="list_error"></ul>
        {{ form_errors(form.remboursement_auditNumerique.depot.audit) }}
        <div class="form-group">
            {{ form_label(form.remboursement_auditNumerique.depot.audit, "Audit réalisé", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {% if remboursement is defined
                    and remboursement.remboursementAuditNumerique
                    and remboursement.remboursementAuditNumerique.depot
                    and remboursement.remboursementAuditNumerique.depot.auditUrl
                %}
                    <p class="lineHeight30 noMargin">
                        <a href="{{ path(path_location, {'demandeId': remboursement.remboursementAuditNumerique.depot.id, 'typeFile': 3, 'extension': remboursement.remboursementAuditNumerique.depot.auditUrl, 'typeDemande': 7}) }}" target="_blank">
                            Voir le document
                        </a>
                    </p>
                {% endif %}

                {{ form_widget(form.remboursement_auditNumerique.depot.audit, {'attr': {'class': 'custom-file'}}) }}
            </div>
        </div>

    </fieldset>

</div>
