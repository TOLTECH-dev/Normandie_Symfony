<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-moduleFicheTechnique">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;R&eacute;capitulatif</legend>

        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" id="bloc-wrapper">
            <div id="bloc-wrapper1">
                <div id="bloc-data_audit">
                    <p class="bold"><i class="glyphicon glyphicon-folder-open"></i>&nbsp;&nbsp;Audit</p>
                    <p class="text-center">
                        {% if devis and devis.auditAlt %}
                            <a href="{{ path(path_location, {'demandeId': devis.id, 'typeFile': 3, 'extension': devis.auditUrl, 'typeDemande': 2}) }}" target="_blank">
                                Voir le document
                            </a>
                        {% else %}
                            Aucun document t&eacute;l&eacute;charg&eacute;
                        {% endif %}
                    </p>
                </div>

                <div id="bloc-data_devis">
                    <p class="bold marginLeft10"><i class="glyphicon glyphicon-folder-open"></i>&nbsp;&nbsp;Devis</p>
                    <ul>
                        {% set devisTypeArray = static_function('App\\Entity\\Demande_travaux_devis_upload', 'arrayDemandeTypeTravaux') %}
                        <table class="table table-condensed">
                            <tbody>
                                {% for item in devis.demandeTravauxDevisUpload %}
                                    <tr>
                                        <td>{{ (item.type) ? devisTypeArray[item.type] : '-' }}</td>
                                        <td>{{ item.montant|number_format(2, '.', ' ') }}&euro;</td>
                                        <td>
                                            {% if item.id and item.devisDocumentAlt %}
                                                <a href="{{ path(path_location, {'demandeId': item.id, 'typeFile': 5, 'extension': item.devisDocumentUrl, 'typeDemande': 2}) }}" target="_blank">
                                                    Voir le document
                                                </a>
                                            {% else %}
                                                Aucun document t&eacute;l&eacute;charg&eacute;
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>

                    </ul>
                </div>
            </div>
        </div>

    </fieldset>

</div>
