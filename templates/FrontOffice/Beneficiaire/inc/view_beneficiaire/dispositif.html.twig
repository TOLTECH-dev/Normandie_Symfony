<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-dispositif">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;J'ai eu connaissance du dispositif par :</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">M&eacute;dia / Ev&egrave;nement / Presse :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireKnownByMedia ? 'OUI' : 'NON' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Autre :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireKnownByOther ? 'OUI' : 'NON' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">&nbsp;Mon Accompagnateur R&eacute;nov&rsquo; conventionn&eacute; avec la R&eacute;gion :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.structureId ? beneficiaire.structureIdentificationNom|capitalize : 'NON' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Auditeur :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.partenaireIdentificationAuditeurId ? beneficiaire.partenaireIdentificationAuditeur|capitalize : 'NON' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">&nbsp;R&eacute;novateur :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.partenaireIdentificationRenovateurId ? beneficiaire.partenaireIdentificationRenovateur|capitalize : 'NON' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">&nbsp;Financeur :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.banqueId ? beneficiaire.banqueNom|capitalize : 'NON' }}
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
