{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_orientation_list') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
            <div id="container-title">
                <h2>Liste des Orientations</h2>
            </div>
        </div>

        <table cellspacing="0" id="table_list_orientation" class="table table-striped table-bordered small_table">
            <thead>
                <tr>
                    <th class="breakWord col0">Code Postal</th>
                    <th class="breakWord col1">Ville</th>
                    <th class="breakWord col2">Orientation H&amp;E Inf&eacute;rieur</th>
                    <th class="breakWord col3">Orientation H&amp;E Sup&eacute;rieur</th>
                    <th class="breakWord col4">EPCI</th>
                    <th class="breakWord col5">Action</th>
                </tr>
            </thead>
            <tbody>
            {% set groupconcatSeparatorItems = constant('App\\Utils\\DefaultServiceUtils::GROUPCONCAT_SEPARATOR_ITEMS') %}
            {% for item in list_orientation %}
                    <tr>
                        <td>{{ item.ville_codePostal }}</td>
                        <td>{{ item.ville_nom }}</td>
                        <td>
                            {% if item.structureInferieurNomConcat|length > 0 %}
                                {% set arrayStructureInferieurNom = item.structureInferieurNomConcat|split(groupconcatSeparatorItems) %}
                                {% for structureInferieurNom in arrayStructureInferieurNom %}
                                    - {{ structureInferieurNom }}<br />
                                {% endfor %}
                            {% endif %}
                        </td>
                        <td>
                            {% if item.structureSuperieurNomConcat|length > 0 %}
                                {% set arrayStructureSuperieurNom = item.structureSuperieurNomConcat|split(groupconcatSeparatorItems) %}
                                {% for structureSuperieurNom in arrayStructureSuperieurNom %}
                                    - {{ structureSuperieurNom }}<br />
                                {% endfor %}
                            {% endif %}
                        </td>
                        <td>{{ item.EPCI_nom }}</td>
                        <td class="text-center">
                            {% if item.orientation_id is not null %}
                                <a href="{{ path('orientation_view', {'orientationId': item.orientation_id}) }}"
                                   class="btn btn-primary btn-xs"
                                   role="button"
                                   data-toggle="tooltip"
                                   data-placement="bottom"
                                   data-container="body"
                                   title="Consulter l'Orientation"
                                >
                                    <i class="glyphicon glyphicon-search"></i>
                                </a>
                            {% else %}
                                <a href="{{ path('orientation_add', {'villeId': item.ville_id}) }}"
                                   class="btn btn-primary btn-xs"
                                   role="button"
                                   data-toggle="tooltip"
                                   data-placement="bottom"
                                   data-container="body"
                                   title="Modifier l'Orientation"
                                >
                                    <i class="glyphicon glyphicon-plus"></i>
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_orientation_listOrientation_appel_datatables') }}
{% endblock %}
