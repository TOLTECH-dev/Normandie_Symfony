<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc bloc-commentaireForm">
    <fieldset>
        <legend><span class="legend-icon"></span>&nbsp;Cr&eacute;er un commentaire</legend>

        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"></div>
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 wrapper_error">{{ form_errors(form.content) }}</div>
        <div class="form-group">
            {{ form_label(form.content, "Contenu :", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form.content, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="form-group box-recipient">
            {{ form_label(form.recipient, "Envoyer une copie par email à :", {'label_attr': {'class': 'col-xs-0 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form.recipient) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 marginTop10">
                {{ form_widget(form.recipient) }}
            </div>
        </div>

    </fieldset>

</div>
