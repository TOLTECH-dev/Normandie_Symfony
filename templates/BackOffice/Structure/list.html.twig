{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_structure_list') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
        <div id="container-title">
            <h2>Liste des Structures H&amp;E</h2>
        </div>
    </div>

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom10">
    <p class="text-center">
        <a href="{{ path('structure_add') }}"
           class="btn btn-primary btn-xs"
           role="button"
           data-toggle="tooltip"
           data-placement="bottom"
           data-container="body"
           title="Cr&eacute;er une nouvelle Structure"
        >
            <i class="glyphicon glyphicon-plus"></i> <span class="bold">Cr&eacute;er une Structure</span>
        </a>
    </p>
</div>

<table cellspacing="0" id="table_list_structure" class="table table-striped table-bordered big_table">
    <thead>
        <tr>
            <th class="breakWord col0">Code</th>
            <th class="breakWord col1">Nom</th>
            <th class="breakWord col2">Code Postal</th>
            <th class="breakWord col3">Ville</th>
            <th class="breakWord col4">Statut</th>
            <th class="breakWord col5">Action</th>
        </tr>
    </thead>
    <tbody>
        {% for item in list_structure %}
            <tr>
                <td>
                    <a href="{{ path('structure_view', {'structureId': item.id}) }}"
                       data-toggle="tooltip"
                       data-placement="bottom"
                       data-container="body"
                       title="Consulter la Structure"
                    >
                    {{ item.structure_identification.code }}
                    </a>
                </td>
                <td>{{ item.structure_identification.nom }}</td>
                <td>{{ item.structure_adresse.codePostal }}</td>
                <td>{{ item.structure_adresse.ville }}</td>

                {% if 0 == item.structure_statut.enabled %}
                    {% set statut = 'Inactif' ~ ' depuis le ' ~ item.structure_statut.dateInactif |date('d/m/Y') %}
                {% elseif 1 == item.structure_statut.enabled %}
                    {% set statut = 'Actif' %}
                {% endif %}
                <td>{{ statut }}</td>

                <td class="text-center">
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_structure_listStructure_appel_datatables') }}
{% endblock %}
