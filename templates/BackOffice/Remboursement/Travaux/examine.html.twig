{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_core_datepicker') }}
    {{ encore_entry_link_tags('backOffice_remboursement_inc_module') }}
    {{ encore_entry_link_tags('backOffice_remboursement_inc_examine') }}
    {{ encore_entry_link_tags('backOffice_remboursement_travaux_examine') }}
{% endblock %}

{% block contents %}
    {% if is_granted('ROLE_INSTRUCTEUR') or is_granted('ROLE_INSTRUCTEUR_UP') or is_granted('ROLE_CLIENT') or is_granted('ROLE_ADMIN') %}
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div id="container-title">
                    <h2>Instruire un remboursement: Dossier n&deg;{{ demande.id }}</h2>
                    {% include 'BackOffice/Remboursement/Travaux/inc/back.html.twig' with {'path_location_list': 'remboursement_list'} %}
                </div>
            </div>

            {{ form_start(form, {'attr': {'class': 'form-horizontal', 'id': 'form_examine'}}) }}

                {{ form_errors(form) }}

                {% set path_location = 'demande_document_bo' %}
                {% set typeDemandeDocument = 9 %}
                {% set formInstruction = form.remboursement_travaux.instruction %}
                {% set remboursementItem = (remboursement is defined and remboursement.remboursementTravaux) ? remboursement.remboursementTravaux : null %}
                {% set remboursementItemType = 2 %}
                {% set isDepot = false %}

                {{ include('BackOffice/Remboursement/inc/module.html.twig') }}
                {{ include('BackOffice/Remboursement/inc/form_examine/remise.html.twig') }}
                {{ include('BackOffice/Remboursement/inc/form_examine/cheque.html.twig') }}
                {{ include('BackOffice/Remboursement/inc/form_examine/cheque_reason.html.twig') }}
                {{ include('BackOffice/Remboursement/inc/form_examine/cheque_reason_autre.html.twig') }}
                {% if 1 == isBBC1 %}
                    {{ include('BackOffice/Remboursement/Travaux/inc/form_examine/ficheTravaux.html.twig') }}
                    {{ include('BackOffice/Remboursement/Travaux/inc/form_examine/ficheTravaux_reason.html.twig') }}
                    {{ include('BackOffice/Remboursement/Travaux/inc/form_examine/ficheTravaux_reason_autre.html.twig') }}
                {% else %}
                    {{ include('BackOffice/Remboursement/inc/form_examine/facture.html.twig') }}
                    {{ include('BackOffice/Remboursement/inc/form_examine/facture_reason.html.twig') }}
                    {{ include('BackOffice/Remboursement/inc/form_examine/facture_reason_autre.html.twig') }}
                {% endif %}
                {{ include('BackOffice/Remboursement/inc/form_examine/RIB.html.twig') }}
                {{ include('BackOffice/Remboursement/inc/form_examine/RIB_reason.html.twig') }}
                {{ include('BackOffice/Remboursement/inc/form_examine/RIB_reason_autre.html.twig') }}

                {% if 1 == isBBC1 %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                        <div class="form-group">
                            {{ form_widget(form.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                        </div>
                    </div>
                {% else %}
                    <input type="hidden" value="{% if totalDevis is defined and totalDevis %}{{ totalDevis }}{% endif %}" id="totalDevis" />

                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc bloc-submit">
                        <div class="form-group">
                            <button type="button" id="button_popupValidation" class="col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success" data-toggle="modal" data-target="#popupValidation">
                                Valider
                            </button>
                        </div>
                    </div>

                    <!-- Modal -->
                    <div class="modal fade modalBackdrop" id="popupValidation" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" data-backdrop="false">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                    <h4 class="modal-title text-center" id="confirmation_instruction">Confirmer l'instruction?</h4>
                                </div>
                                <div class="modal-body">

                                    <div class="bloc-confirmation">
                                        <p class="text-center"><i class="glyphicon glyphicon-warning-sign"></i>&nbsp;Attention.</p>
                                        <p>Le montant de la facture est diff&eacute;rent de celui du devis alors que la partie "Facture" est conforme.</p>

                                        <br>
                                        <p class="bold text-center">Etes-vous s&ucirc;r de vouloir continuer ?</p>

                                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                                            <div class="form-group">
                                                {{ form_widget(form.valider, {'label': 'Continuer', 'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-2 col-md-offset-2 col-lg-offset-2 btn btn-success'}}) }}
                                                <button type="button" class="col-xs-12 col-sm-4 col-md-4 col-lg-4 btn btn-secondary marginLeft10" data-dismiss="modal">Annuler</button>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {{ form_rest(form) }}

            {{ form_end(form) }}

        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_remboursement_travaux_formExamine_index') }}
    {{ encore_entry_script_tags('backOffice_remboursement_checkIBAN') }}
{% endblock %}
