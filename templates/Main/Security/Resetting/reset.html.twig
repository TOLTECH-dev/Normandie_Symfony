{#
    Saisie du nouveau mot de passe, atteinte via le lien reçu par courriel.
    Champs du nouveau mot de passe : BackOffice/Security/_new_password_fields.html.twig.
#}
{% extends "Main/Security/Resetting/layout.html.twig" %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('passwordValidation') }}
{% endblock %}

{% block card %}
    <div class="auth-card">
        <div class="auth-card-header">
            <h2 class="auth-card-title">Nouveau mot de passe</h2>
            <p class="auth-card-subtitle">Choisissez le mot de passe qui remplacera votre mot de passe actuel.</p>
        </div>

        {{ include('BackOffice/Security/_auth_messages.html.twig') }}

        {{ form_start(form, {'action': path('user_resetting_reset', {'token': token}), 'attr': {'id': 'form_reset', 'class': 'auth-password-form'}}) }}

            {# Erreurs globales (ex. jeton CSRF) #}
            {% for error in form.vars.errors %}
                <div class="auth-alert" role="alert">{{ error.message }}</div>
            {% endfor %}

            {{ include('BackOffice/Security/_new_password_fields.html.twig', {'field': form.password}) }}

            <button type="submit" class="auth-submit" name="_submit">Enregistrer le nouveau mot de passe</button>

        {{ form_end(form) }}

        <div class="auth-card-footer">
            <a href="{{ path(isBackOffice ? 'admin_user_login' : 'user_login') }}">Retour &agrave; la connexion</a>
        </div>
    </div>
{% endblock %}
