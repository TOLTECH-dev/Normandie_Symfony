<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-statut">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Statut</legend>

        <div class="form-group bloc-dateInactif">
            {{ form_label(form_banque.banque_statut.enabled, "Actif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form_banque.banque_statut.enabled) }}

            <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1">
                {% if banque.banquestatut is null  %}
                    {{ form_widget(form_banque.banque_statut.enabled, {'attr': {'class': 'checkboxstyle', 'checked': 'checked'}}) }}
                {% else %}
                    {{ form_widget(form_banque.banque_statut.enabled, {'attr': {'class': 'checkboxstyle'}}) }}
                {% endif %}
            </div>
        </div>

        {% if banque.banquestatut %}
            {% if 0 == banque.banquestatut.enabled %}
                {% set enabled = 'off' %}
            {% elseif 1 == banque.banquestatut.enabled %}
                {% set enabled = 'on' %}
            {% endif %}
        {% else %}
            {% set enabled = 'on' %}
        {% endif %}
        <input type="hidden" value="{{ enabled }}" id="valueForm" />

        <div class="form-group">
            {{ form_label(form_banque.banque_statut.dateInactif, "Date Inactif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
            {{ form_errors(form_banque.banque_statut.dateInactif) }}

            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                {{ form_widget(form_banque.banque_statut.dateInactif, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
    </fieldset>

    <hr class="bloc-limit">
</div>
