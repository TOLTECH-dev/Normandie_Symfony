<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-depot">
    <hr class="bloc-limit">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Audit</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Audit :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {% if remboursement is defined
                    and remboursementDepot
                    and remboursementDepot.auditAlt
                %}
                    <a href="{{ path(path_location, {'demandeId': remboursementDepot.id, 'typeFile': 3, 'extension': remboursementDepot.auditUrl, 'typeDemande': typeDepotDocument}) }}" target="_blank">
                        Voir le document
                    </a>
                {% else %}
                    Aucun document t&eacute;l&eacute;charg&eacute;
                {% endif %}
            </div>
        </div>

    </fieldset>

</div>
