<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc bloc-formEdit">
    <fieldset>

        {% for key, form_item in formEdit %}
        {% if key == item.id %}

            {{ form_start(form_item, {'attr': {'class': 'form-horizontal'}}) }}
            {{ form_errors(form_item) }}

            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"></div>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 wrapper_error">{{ form_errors(form_item.dateRMH) }}</div>
            <div class="paddingBottom15">
                {{ form_label(form_item.dateRMH, "Date RMH", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ form_widget(form_item.dateRMH, {'attr': {'class': 'form-control datepickerClass'}}) }}
                </div>
            </div>
            <br><br>

            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"></div>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 wrapper_error">{{ form_errors(form_item.enabled) }}</div>
            <div class="bloc-dateInactif paddingBottom15">
                {{ form_label(form_item.enabled, "Actif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

                <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1">
                    {{ form_widget(form_item.enabled, {'attr': {'class': 'checkboxstyle'}}) }}
                </div>
            </div>
            <br><br>

            {% if 0 == item.enabled %}
                {% set enabled = 'off' %}
            {% elseif 1 == item.enabled %}
                {% set enabled = 'on' %}
            {% endif %}
            <input type="hidden" value="{{ enabled }} | {{ item.id }}" class="valueForm" />

            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"></div>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 wrapper_error">{{ form_errors(form_item.dateInactif) }}</div>
            <div>
                {{ form_label(form_item.dateInactif, "Date Inactif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ form_widget(form_item.dateInactif, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <br>

            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc bloc-submit">
                <div>
                    {{ form_widget(form_item.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                </div>
            </div>

            {{ form_rest(form_item) }}
            {{ form_end(form_item) }}

        {% endif %}
        {% endfor %}

    </fieldset>
</div>
