{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('frontOffice_logement_list') }}
    {{ encore_entry_link_tags('frontOffice_common_menu') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1" id="title-wrapper">
        <div id="container-title">
            <h2>Identification des logements</h2>
        </div>
    </div>

    {% set prefix_pathname = constant('App\\Utils\\DefaultServiceUtils::PREFIX_PATHNAME_ASSISTANT_BENEFICIAIRE') ~ '_' %}
    {% set is_backoffice = true %}
    {{ include('FrontOffice/Logement/inc/list_logement/content.html.twig') }}

    <div id="data-js-bundle" class="hidden" data-prefix-pathname-bundle="{{ prefix_pathname_bundle_bo }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('frontOffice_logement_list_index') }}
{% endblock %}
