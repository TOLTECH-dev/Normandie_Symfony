<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-situation">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Situation</legend>

        {% set situationFamilleArray = {
            '0 | celibataire': 'Célibataire',
            '1 | marie': 'Marié',
            '2 | union_libre': 'Union libre',
            '3 | veuf_divorce': 'Veuf(ve)/Divorcé',
            '4 | pacse': 'Pacsé(e)',
            '': '-'
        } %}

        {% if "1 | sci" == beneficiaire.beneficiaireType %}
            {% set labelFieldNombrePersonneFoyer = constant('App\\Entity\\Demande_::LABEL_FIELD_NOMBRE_PERSONNE_FOYER_SCI') %}
            {% set labelFieldRevenuFiscalFoyer = constant('App\\Entity\\Demande_::LABEL_FIELD_REVENU_FISCAL_DEMANDEUR_SCI') %}
            {% set isShowSituationFamille = false %}
        {% else%}
            {% set labelFieldNombrePersonneFoyer = constant('App\\Entity\\Demande_::LABEL_FIELD_NOMBRE_PERSONNE_FOYER_PARTICULIER') %}
            {% set labelFieldRevenuFiscalFoyer = constant('App\\Entity\\Demande_::LABEL_FIELD_REVENU_FISCAL_FOYER_PARTICULIER') %}
            {% set isShowSituationFamille = true %}
        {% endif %}

        {% if isShowSituationFamille == true %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Situation familiale :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ situationFamilleArray[beneficiaire.beneficiaireSituationFamille] }}
                </div>
            </div>
        {% endif %}

        {% if isShowSituationFamille == true %}
            {% if "1 | marie" == beneficiaire.beneficiaireSituationFamille
                or "2 | union_libre" == beneficiaire.beneficiaireSituationFamille
                or "4 | pacse" == beneficiaire.beneficiaireSituationFamille
            %}
                <div class="row">
                    <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Nom du conjoint :</label>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                        {{ beneficiaire.beneficiaireNomConjoint }}
                    </div>
                </div>

                <div class="row">
                    <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Pr&eacute;nom du conjoint :</label>
                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                        {{ beneficiaire.beneficiairePrenomConjoint }}
                    </div>
                </div>
            {% endif %}
        {% endif %}

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">{{ labelFieldNombrePersonneFoyer}} :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireNbPersonneFoyer }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">{{ labelFieldRevenuFiscalFoyer }} :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ beneficiaire.beneficiaireRevenuFiscal|number_format(2, '.', ' ') }}&euro;
            </div>
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
