            <label class="col-xs-12 col-sm-12 col-md-2 col-lg-2 control-label">Type :</label>
            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                {{ devis.devisTypeMaPrimeRenovNom ? devis.devisTypeMaPrimeRenovNom : '-' }}
            </div>
        </div>

