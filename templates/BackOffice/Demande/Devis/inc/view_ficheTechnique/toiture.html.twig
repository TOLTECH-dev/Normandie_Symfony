<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-toiture">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Toiture</legend>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">Surface (m<sup>2</sup>)</label>
            </div>
            <div class="flex1 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_initial.toitureSurface ? ficheTechnique.ficheTechnique_initial.toitureSurface : '-' }}
            </div>
            <div class="flex2 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_BBC.toitureSurface ? ficheTechnique.ficheTechnique_BBC.toitureSurface : '-' }}
            </div>
            <div class="flex3 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_prescription.toitureSurface ? ficheTechnique.ficheTechnique_prescription.toitureSurface : '-' }}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 form-control fontSize9">
                    {{ ficheTechnique.ficheTechnique_finChantier.toitureSurface ? ficheTechnique.ficheTechnique_finChantier.toitureSurface : '-' }}
                </div>
            {% endif %}
        </div>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">R (m<sup>2</sup>.K/W)</label>
            </div>
            <div class="flex1 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_initial.toitureR ? ficheTechnique.ficheTechnique_initial.toitureR : '-' }}
            </div>
            <div class="flex2 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_BBC.toitureR ? ficheTechnique.ficheTechnique_BBC.toitureR : '-' }}
            </div>
            <div class="flex3 form-control fontSize9">
                {{ ficheTechnique.ficheTechnique_prescription.toitureR ? ficheTechnique.ficheTechnique_prescription.toitureR : '-' }}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 form-control fontSize9">
                    {{ ficheTechnique.ficheTechnique_finChantier.toitureR ? ficheTechnique.ficheTechnique_finChantier.toitureR : '-' }}
                </div>
            {% endif %}
        </div>

        <div class="flex-wrapper">
            <div class="flex0 text-right">
                <label class="col-xs-12 col-sm-12 col-md-12 col-lg-12 control-label paddingTop7">Information &eacute;tanch&eacute;it&eacute; &agrave; l'air et migration vapeur d'eau</label>
            </div>
            <div class="flex1 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_initial.toitureEtancheite %}
                    {{ ficheTechnique.ficheTechnique_initial.toitureEtancheite }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex2 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_BBC.toitureEtancheite %}
                    {{ ficheTechnique.ficheTechnique_BBC.toitureEtancheite }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            <div class="flex3 marginTop7 fontSize9">
                {% if ficheTechnique.ficheTechnique_prescription.toitureEtancheite %}
                    {{ ficheTechnique.ficheTechnique_prescription.toitureEtancheite }}
                {% else %}
                    <p class="text-center">-</p>
                {% endif %}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 marginTop7 fontSize9">
                    {% if ficheTechnique.ficheTechnique_finChantier.toitureEtancheite %}
                        {{ ficheTechnique.ficheTechnique_finChantier.toitureEtancheite }}
                    {% else %}
                        <p class="text-center">-</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>

    </fieldset>

    <hr class="bloc-limit">
</div>
