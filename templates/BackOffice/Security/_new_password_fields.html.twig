{#
    Choix d'un nouveau mot de passe (réinitialisation, renouvellement) : règles, indicateur de force
    et confirmation.

    Paramètre : field = vue d'un champ RepeatedType de mots de passe.

    Les identifiants password, password_repeat, pswd_*, result et password_match_message sont
    utilisés par assets/js/main/passwordValidation.js (entrée passwordValidation) : ne pas les
    renommer. Les règles affichées sont celles de la contrainte App\Validator\Constraints\PasswordStrength
    et de App\Security\Password\PasswordChangeService.
#}
<div class="auth-password-rules" id="pswd_info">
    <p>Votre mot de passe doit contenir :</p>
    <ul>
        <li id="pswd_letter" class="invalid">une lettre minuscule</li>
        <li id="pswd_capital" class="invalid">une lettre majuscule</li>
        <li id="pswd_number" class="invalid">un chiffre</li>
        <li id="pswd_special_character" class="invalid">un caract&egrave;re sp&eacute;cial</li>
        <li id="pswd_length" class="invalid">au moins 12 caract&egrave;res</li>
    </ul>
    <p class="auth-password-rules-note">
        Il ne doit reprendre ni votre identifiant, ni votre adresse e-mail, ni vos nom et pr&eacute;nom,
        ni l'un de vos derniers mots de passe.
    </p>
</div>

<div class="auth-field">
    <div class="auth-field-label-row">
        <label for="password">{{ field.first.vars.label }}</label>
        <span id="result" aria-live="polite"></span>
    </div>
    {{ form_widget(field.first, {'id': 'password', 'attr': {'class': 'auth-input', 'autocomplete': 'new-password', 'aria-describedby': 'pswd_info'}}) }}
    {# Erreurs du champ répété (règles, correspondance, historique) et du premier champ #}
    {% for error in field.vars.errors|merge(field.first.vars.errors) %}
        <p class="auth-field-error">{{ error.message }}</p>
    {% endfor %}
</div>

<div class="auth-field">
    <label for="password_repeat">{{ field.second.vars.label }}</label>
    {{ form_widget(field.second, {'id': 'password_repeat', 'attr': {'class': 'auth-input', 'autocomplete': 'new-password'}}) }}
    <small id="password_match_message" aria-live="polite" style="display:none;"></small>
    {% for error in field.second.vars.errors %}
        <p class="auth-field-error">{{ error.message }}</p>
    {% endfor %}
</div>
