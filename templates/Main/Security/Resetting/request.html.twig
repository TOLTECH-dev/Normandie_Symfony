{% extends "Main/Security/Resetting/layout.html.twig" %}
{% import "Macros/captcha.html.twig" as captcha %}

{% block title %}Mot de passe oublié{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://www.google.com/recaptcha/api.js?hl=fr" type="text/javascript" async defer></script>
{% endblock %}

{% block card %}
    <div class="auth-card">
        <div class="auth-card-header">
            <h2 class="auth-card-title">Mot de passe oubli&eacute;</h2>
            <p class="auth-card-subtitle">
                Indiquez votre {{ string }} : si un compte correspond, vous recevrez un courriel contenant
                un lien pour choisir un nouveau mot de passe. Pensez &agrave; v&eacute;rifier vos courriers ind&eacute;sirables.
            </p>
        </div>

        {{ include('BackOffice/Security/_auth_messages.html.twig') }}
        {{ include('Main/Security/_bandeau_mots_de_passe.html.twig') }}

        <form action="{{ path('user_resetting_send_email') }}" method="post">
            <div class="auth-field">
                <label for="username">{{ string|capitalize }}</label>
                <input type="text" id="username" name="username" class="auth-input"
                       required="required" autocomplete="username" autofocus />
            </div>

            <div class="auth-captcha">
                {{ captcha.recaptcha(recaptcha_client_key, 'light') }}
            </div>

            <button type="submit" class="auth-submit" id="_submit" name="_submit">Envoyer le lien de r&eacute;initialisation</button>
        </form>

        <div class="auth-card-footer">
            <a href="{{ path(isBackOffice ? 'admin_user_login' : 'user_login') }}">Retour &agrave; la connexion</a>
        </div>
    </div>
{% endblock %}
