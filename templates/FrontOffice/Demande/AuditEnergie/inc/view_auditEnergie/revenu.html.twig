{# beneficiaireTypeKey => exists in read demandes and beneficiaire.type : exists in add/Edit demandes #}
{% set beneficiaireTypeKey = (beneficiaireTypeKey is defined) ? beneficiaireTypeKey : beneficiaire.type|split(' | ')[0] %}
{% if '0' == beneficiaireTypeKey %}
    {% set classBlocAvisImpositionConjoint = '' %}
    {% set classBlocRevenuFiscalConjoint = '' %}
    {% set labelFieldAvisImpositionDemandeur = constant('App\\Entity\\Demande_::LABEL_FIELD_AVIS_IMPOSITION_DEMANDEUR_PARTICULIER') %}
    {% set texteInfoBulleAvisImpositionDemandeur = constant('App\\Entity\\Demande_::INFO_BULLE_HTML_AVIS_IMPOSITION_DEMANDEUR_PARTICULIER') %}
    {% set labelFieldNombrePersonneFoyer = constant('App\\Entity\\Demande_::LABEL_FIELD_NOMBRE_PERSONNE_FOYER_PARTICULIER') %}
    {% set labelFieldRevenuFiscalDemandeur = constant('App\\Entity\\Demande_::LABEL_FIELD_REVENU_FISCAL_DEMANDEUR_PARTICULIER') %}
    {% set labelFieldRevenuFiscalFoyer = constant('App\\Entity\\Demande_::LABEL_FIELD_REVENU_FISCAL_FOYER_PARTICULIER') %}
{% elseif '1' == beneficiaireTypeKey %}
    {% set classBlocAvisImpositionConjoint = 'hidden' %}
    {% set classBlocRevenuFiscalConjoint = 'hidden' %}
    {% set labelFieldAvisImpositionDemandeur = constant('App\\Entity\\Demande_::LABEL_FIELD_AVIS_IMPOSITION_DEMANDEUR_SCI') %}
    {% set texteInfoBulleAvisImpositionDemandeur = constant('App\\Entity\\Demande_::INFO_BULLE_HTML_AVIS_IMPOSITION_DEMANDEUR_SCI') %}
    {% set labelFieldNombrePersonneFoyer = constant('App\\Entity\\Demande_::LABEL_FIELD_NOMBRE_PERSONNE_FOYER_SCI') %}
    {% set labelFieldRevenuFiscalDemandeur = constant('App\\Entity\\Demande_::LABEL_FIELD_REVENU_FISCAL_DEMANDEUR_SCI') %}
    {% set labelFieldRevenuFiscalFoyer = constant('App\\Entity\\Demande_::LABEL_FIELD_REVENU_FISCAL_FOYER_SCI') %}
{% endif %}
{% set proprio = demande.logementSituation|split(' | ') %}
{% if ('0' == proprio[0] or '1' == proprio[0]) %}
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-information">
        <fieldset>
            <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Votre Revenu</legend>

            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">{{ labelFieldAvisImpositionDemandeur }} :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {% if demande and demande.demandeAvisImpositionAlt %}
                        <a href="{{ path(path_location, {'demandeId': demande.auditEId, 'typeFile': 2, 'extension': demande.demandeAvisImpositionUrl, 'typeDemande': 0}) }}" target="_blank">
                            Voir le document
                        </a>
                    {% else %}
                        Aucun document t&eacute;l&eacute;charg&eacute;
                    {% endif %}
                </div>
            </div>

            <div class="row {{ classBlocAvisImpositionConjoint }}">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Avis d'imposition du conjoint:</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {% if demande and demande.demandeAvisImpositionConjointAlt %}
                        <a href="{{ path(path_location, {'demandeId': demande.auditEId, 'typeFile': 11, 'extension': demande.demandeAvisImpositionConjointUrl, 'typeDemande': 0}) }}" target="_blank">
                            Voir le document
                        </a>
                    {% else %}
                        Aucun document t&eacute;l&eacute;charg&eacute;
                    {% endif %}
                </div>
            </div>

            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">{{ labelFieldNombrePersonneFoyer }} :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ demande.demandeNbPersFoyer }}
                </div>
            </div>

            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">{{ labelFieldRevenuFiscalDemandeur}} :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ demande.demandeRevenuDemandeur|number_format(2, '.', ' ') }}&euro;
                </div>
            </div>

            <div class="row {{ classBlocRevenuFiscalConjoint }}">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Revenu fiscal de r&eacute;f&eacute;rence du conjoint (n-1 ou n-2) :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ demande.demandeRevenuConjoint ? demande.demandeRevenuConjoint|number_format(2, '.', ' ') ~ '€' : '-' }}
                </div>
            </div>

            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">{{ labelFieldRevenuFiscalFoyer }} :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {{ demande.demandeRevenuFoyer|number_format(2, '.', ' ') }}&euro;
                </div>
            </div>

        </fieldset>

        <hr class="bloc-limit">
    </div>
{% endif %}
