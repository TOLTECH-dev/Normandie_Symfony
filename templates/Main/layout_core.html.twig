<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="apple-touch-icon" href="{{ asset('build/images/main/favicon/apple-touch-icon.png') }}" sizes="180x180">
    <link rel="icon" href="{{ asset('build/images/main/favicon/favicon-32x32.png') }}" type="image/png" sizes="32x32">
    <link rel="icon" href="{{ asset('build/images/main/favicon/favicon-16x16.png') }}" type="image/png" sizes="16x16">
    <link rel="mask-icon" href="{{ asset('build/images/main/favicon/safari-pinned-tab.svg') }}" color="#5bbad5">
    <link rel="manifest" href="{{ asset('build/images/main/favicon/manifest.json') }}">

    <title>
        {% block title %}
            Espace B&eacute;n&eacute;ficiaire
        {% endblock %}
    </title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        {{ encore_entry_link_tags('main') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        {{ encore_entry_script_tags('main') }}
        <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
        <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
        <script src="https://www.google.com/recaptcha/api.js?hl=fr" type="text/javascript"></script>
    {% endblock %}
</head>
<body>
{{ render(controller('App\\Controller\\MainCommonController:layoutHeader')) }}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc-content">
                {% block content %}

                {% endblock %}
            </div>
        </div>
    </div>
</div>

{#
{{ render(controller('App\\Controller\\MainCommonController:layoutFooter')) }}
#}

</body>
</html>