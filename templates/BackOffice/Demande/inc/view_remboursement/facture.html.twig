<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-facture">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Facture</legend>

        {% if (constant('App\\Entity\\Demande_::DEMANDE_TRAVAUX_TYPE') != demande.demandeType) %}
            <div class="row">
                <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Facture :</label>
                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                    {% if remboursement is defined
                        and remboursementInstruction
                        and remboursementInstruction.factureAlt
                    %}
                        <a href="{{ path(path_location, {'demandeId': remboursementInstruction.id, 'typeFile': 7, 'extension': remboursementInstruction.factureUrl, 'typeDemande': typeDemandeDocument}) }}" target="_blank">
                            Voir le document
                        </a>
                    {% else %}
                        Aucun document t&eacute;l&eacute;charg&eacute;
                    {% endif %}
                </div>
            </div>
        {% else %}
            {% if remboursementInstruction.remboursementTravauxInstructionConformite is defined and remboursementInstruction.remboursementTravauxInstructionConformite is not empty %}
                <table class="table table-condensed ">
                    <thead>
                        <tr>
                            <th>Facture</th>
                            <th>Conforme ?</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for item in remboursementInstruction.remboursementTravauxInstructionConformite %}
                        <tr>
                            <td>
                                {% if item.id and item.documentAlt %}
                                    <a href="{{ path(path_location, {'demandeId': item.id, 'typeFile': 10, 'extension': item.documentUrl, 'typeDemande': 10}) }}" target="_blank">
                                        Voir le document
                                    </a>
                                {% else %}
                                    Aucun document t&eacute;l&eacute;charg&eacute;
                                {% endif %}
                            </td>

                            <td>{{ isConformeArray[item.isConforme|split(' | ')[0]] }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-center bold fontSize9">Aucune facture enregistr&eacute;e.</p>
            {% endif %}
        {% endif %}

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Montant de la facture :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {{ (remboursementInstruction and remboursementInstruction.montantFacture) ? remboursementInstruction.montantFacture|number_format(2, '.', ' ') ~ ' €' : '-' }}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Factures conformes ?</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {% if remboursementInstruction %}
                    {{ isConformeArray[remboursementInstruction.isFactureConforme|split(' | ')[0]] }}
                {% else %}
                    -
                {% endif %}
            </div>
        </div>

        {% if remboursementInstruction and remboursementInstruction.factureReason is not empty %}
        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Raison :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                <ul class="noMmargin noPadding">
                    {% for item in remboursementInstruction.factureReason %}
                        <li>{{ item.slug }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% endif %}

        {% if remboursementInstruction and remboursementInstruction.factureReasonAutre %}
        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Autre raison :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                <ul class="noMmargin noPadding noPuce">
                    <li>{{ remboursementInstruction.factureReasonAutre }}</li>
                </ul>
            </div>
        </div>
        {% endif %}

    </fieldset>

    <hr class="bloc-limit">
</div>