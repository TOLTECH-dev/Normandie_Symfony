<page>

    {% if partenaireType is defined %}
        {% if 0 == partenaireType %}
            {% set textFrom = 'les Conseillers' %}
            {% set textTo = 'L\'Auditeur' %}
        {% elseif 1 == partenaireType %}
            {% set textFrom = 'la Région' %}
            {% set textTo = 'Le Rénovateur' %}
        {% endif %}
    {% else %}
        {% set textFrom = '' %}
        {% set textTo = '' %}
    {% endif %}

    <table cellpadding="0" cellspacing="5" align="center" border="0" style="margin-top: 8px;">
        <tr>
            <td><div class="legend-icon">&nbsp;</div></td>
            <td class="title1">Evaluation de {{ partenaireRaisonSociale }}</td>
        </tr>
    </table>

    <div class="smallText" style="text-align: right;">Edit&eacute; le {{ 'now'|date('d/m/Y') }}</div>
    <br>

    {% if 1 == partenaireType %}
        {{ include('BackOffice/Rating/inc/export/score.html.twig') }}

        <br>
        <div><hr class="gris"></div>
        <br>
    {% endif %}

    {{ include('BackOffice/Rating/inc/export/commentaire.html.twig') }}

</page>
