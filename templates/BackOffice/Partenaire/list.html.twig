{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_partenaire_list') }}
    {{ encore_entry_link_tags('backOffice_rating_view') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
            <div id="container-title">
                <h2>Liste des {{ title|capitalize }}s</h2>
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom10">
            <p class="text-center">
                {% if '0' == type %}
                    {% set titleAdd = 'nouvel Auditeur' %}
                {% elseif '1' == type %}
                    {% set titleAdd = 'nouveau Rénovateur' %}
                {% endif %}
                <a href="{{ path('partenaire_add', {'type': type}) }}"
                   class="btn btn-primary btn-xs"
                   role="button"
                   data-toggle="tooltip"
                   data-placement="bottom"
                   data-container="body"
                   title="Cr&eacute;er un {{ titleAdd }}"
                >
                    <i class="glyphicon glyphicon-plus"></i> <span class="bold">Cr&eacute;er un {{ title|capitalize }}</span>
                </a>
            </p>
        </div>

        <table cellspacing="0" id="table_list_partenaire" class="table table-striped table-bordered big_table">
            <thead>
            <tr>
                <th class="breakWord col0">Raison Sociale</th>
                <th class="breakWord col1">Code Postal</th>
                <th class="breakWord col2">Ville</th>
                <th class="breakWord col3">Contact</th>
                <th class="breakWord col4">Statut</th>
                <th class="breakWord col5">Action</th>
            </tr>

            <tr id="filterrow">
                <th class="with_search">Raison Sociale</th>
                <th class="with_search">Code Postal</th>
                <th class="with_search">Ville</th>
                <th class="with_search">Contact</th>
                <th class="with_select">Statut</th>
                <th class="text-center">
                    <button type="button"
                            role="button"
                            class="btn btn-danger btn-xs"
                            data-toggle="tooltip"
                            data-placement="bottom"
                            data-container="body"
                            title="Vider les champs de recherche"
                            id="clear_search_input"
                    >
                        <i class="glyphicon glyphicon-erase"></i>
                    </button>
                    {% if is_granted('ROLE_CLIENT') or is_granted('ROLE_ADMIN') %}
                        {% if '0' == type %}
                            <a  href="{{ path('partenaire_export', {'type': 0}) }}"
                                class="btn btn-success btn-xs"
                                role="button"
                                data-toggle="tooltip"
                                data-placement="bottom"
                                data-container="body"
                                title="Exporter la liste des Auditeurs"
                            >
                                <i class="glyphicon glyphicon-download-alt"></i>
                            </a>
                        {% elseif '1' == type %}
                            <a  href="{{ path('partenaire_export', {'type': 1}) }}"
                                class="btn btn-success btn-xs"
                                role="button"
                                data-toggle="tooltip"
                                data-placement="bottom"
                                data-container="body"
                                title="Exporter la liste des R&eacute;novateurs"
                            >
                                <i class="glyphicon glyphicon-download-alt"></i>
                            </a>
                        {% endif %}
                    {% endif %}
                </th>
            </tr>
            </thead>

            <tbody>
            {% for item in list_partenaire %}
                {% set type = item.partenaireThematique|split(' | ') %}

                {% set arrayContact = item.strContact|split('__|__') %}
                {% set contactCivilite = (arrayContact[0] is defined and arrayContact[0]) ? arrayContact[0]|split(' | ')[1] : '' %}
                {% set contactPrenom = (arrayContact[1] is defined and arrayContact[1]) ? arrayContact[1] : '' %}
                {% set contactNom = (arrayContact[2] is defined and arrayContact[2]) ? arrayContact[2] : '' %}
                {% set contactTelephone = (arrayContact[3] is defined and arrayContact[3]) ? arrayContact[3] : '' %}
                {% set contactEmail = (arrayContact[4] is defined and arrayContact[4]) ? arrayContact[4] : '' %}

                {% if '0' == type[0] %}
                    {% set titleDisplay = 'l\'Auditeur' %}
                {% elseif '1' == type[0] %}
                    {% set titleDisplay = 'le Rénovateur' %}
                {% endif %}
                <tr>
                    <td>
                        <a href="{{ path('partenaire_view', {'partenaireId': item.partenaireId, 'type': type[0]}) }}"
                           data-toggle="tooltip"
                           data-placement="bottom"
                           data-container="body"
                           title="Consulter {{ titleDisplay }}"
                        >
                            {{ item.partenaireRaisonSociale }}
                        </a>
                    </td>
                    <td>{{ item.partenaireCodePostal }}</td>
                    <td>{{ item.partenaireVille }}</td>
                    <td>
                        {{ (contactNom or contactPrenom) ? contactCivilite|capitalize  ~ ' ' ~ contactPrenom|capitalize ~ ' ' ~ contactNom|upper : '-' }}<br>
                        <span class="bold">T&eacute;l&eacute;phone:</span> {{ contactTelephone ? contactTelephone : '-' }}<br>
                        <span class="bold">Email:</span> {{ contactEmail ? contactEmail|lower : '-' }}
                    </td>

                    {% if 0 == item.partenaireEnabled %}
                        {% set statut = 'Inactif' ~ ' depuis le ' ~ item.partenaireDateInactif %}
                    {% elseif 1 == item.partenaireEnabled %}
                        {% set statut = 'Actif' %}
                    {% endif %}
                    <td>{{ statut }}</td>

                    <td class="text-center">
                        <button id="button_viewRating_{{ item.partenaireId }}"
                                class="btn btn-{{ (0 != item.countRating) ? 'success' : 'primary' }} btn-xs button_viewRating"
                                type="button"
                                title="Consulter l'&eacute;valuation"
                                data-toggle="tooltip"
                                data-placement="bottom"
                                data-container="body"
                                data-original-title="Consulter l'&eacute;valuation"
                                data-partenaireUrl="{{ path('partenaire_view_rating', {'partenaireId': item.partenaireId, 'partenaireType': type[0]|number_format}) }}"
                                data-partenaireType="{{ type[0]|number_format }}"
                                data-partenaireRaisonSociale="{{ item.partenaireRaisonSociale }}"
                                data-partenaireUrlExportRating="{{ path('partenaire_export_rating', {'partenaireId': item.partenaireId, 'partenaireType': type[0]|number_format}) }}"
                        >
                            <i class="glyphicon glyphicon-star"></i>
                        </button>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ include('BackOffice/Rating/inc/modalView.html.twig') }}

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_partenaire_index') }}
    {{ encore_entry_script_tags('backOffice_rating_index') }}
{% endblock %}
