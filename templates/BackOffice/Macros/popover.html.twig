{% macro fiche_technique_popover(audit) %}
    {% set texte = (audit == '1') ? 'l\'auditeur' : 'le conseiller' %}
    <span class="header-popover">
        <a role="button"
           tabindex="0"
           data-container="body"
           data-toggle="popover"
           data-trigger="focus"
           data-placement="top"
           data-content="Colonne &agrave; compl&eacute;ter par {{ texte }}."
        >
            <i class="glyphicon glyphicon-question-sign"></i>
        </a>
    </span>
{% endmacro %}
