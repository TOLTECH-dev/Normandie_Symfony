{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_banque_list') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom40">
        <div id="container-title">
            <h2>Liste des Banques</h2>
        </div>
    </div>

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 marginBottom10">
    <p class="text-center">
        <a href="{{ path('banque_add') }}"
           class="btn btn-primary btn-xs"
           role="button"
           data-toggle="tooltip"
           data-placement="bottom"
           data-container="body"
           title="Cr&eacute;er une nouvelle Banque"
        >
            <i class="glyphicon glyphicon-plus"></i> <span class="bold">Cr&eacute;er une Banque</span>
        </a>
    </p>
</div>

<table cellspacing="0" id="table_list_banque" class="table table-striped table-bordered big_table">
    <thead>
        <tr>
            <th class="breakWord col0">Nom</th>
            <th class="breakWord col1">Statut</th>
            <th class="breakWord col2">Action</th>
        </tr>
    </thead>
    <tbody>
        {% for item in list_banque %}
            <tr>
                <td>
                    <a href="{{ path('banque_view', {'banqueId': item.id}) }}"
                       data-toggle="tooltip"
                       data-placement="bottom"
                       data-container="body"
                       title="Consulter la Banque"
                    >
                    {{ item.nom }}
                    </a>
                </td>
                <td>
                    {% if 0 == item.banquestatut.enabled %}
                        {% set statut = 'Inactif' ~ ' depuis le ' ~ item.banquestatut.dateInactif|date('d/m/Y') %}
                    {% elseif 1 == item.banquestatut.enabled %}
                        {% set statut = 'Actif' %}
                    {% endif %}
                    {{ statut }}
                </td>

                <td class="text-center">
                    {% if 0 == item.banquestatut.enabled %}
                        <a href="{{ path('banque_enabled', {'banqueId': item.id, 'flag': 1}) }}"
                           class="btn btn-danger btn-xs"
                           role="button"
                           data-toggle="tooltip"
                           data-placement="bottom"
                           data-container="body"
                           title="Activer la Banque"
                        >
                            <i class="glyphicon glyphicon-flag"></i>
                        </a>
                    {% elseif 1 == item.banquestatut.enabled %}
                        <a href="{{ path('banque_enabled', {'banqueId': item.id, 'flag': 0}) }}"
                           class="btn btn-success btn-xs"
                           role="button"
                           data-toggle="tooltip"
                           data-placement="bottom"
                           data-container="body"
                           title="D&eacute;sactiver la Banque"
                        >
                            <i class="glyphicon glyphicon-flag"></i>
                        </a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_banque_listBanque_appel_datatables') }}
{% endblock %}
