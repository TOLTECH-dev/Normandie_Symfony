<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-validation">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Validation Fiche Technique</legend>

        <div class="flex-wrapper">
            <div class="flex0">
                &nbsp;
            </div>
            <div class="flex1 marginTop7 text-center fontSize9">
                {{ ficheTechnique.ficheTechnique_initial.informationValidation ? 'OUI' : 'NON' }}
            </div>
            <div class="flex2 marginTop7 text-center fontSize9">
                {{ ficheTechnique.ficheTechnique_BBC.informationValidation ? 'OUI' : 'NON' }}
            </div>
            <div class="flex3 marginTop7 text-center fontSize9">
                {{ ficheTechnique.ficheTechnique_prescription.informationValidation ? 'OUI' : 'NON' }}
            </div>
            {% if demande.remboursementFicheTechniqueId %}
                <div class="flex4 marginTop7 text-center fontSize9">
                    {{ ficheTechnique.ficheTechnique_finChantier.informationValidation ? 'OUI' : 'NON' }}
                </div>
            {% endif %}
        </div>

    </fieldset>
</div>
