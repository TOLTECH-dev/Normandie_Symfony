{% extends "BackOffice/Security/layout_auth.html.twig" %}
{% import "Macros/captcha.html.twig" as captcha %}

{% block title %}Connexion{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if cachedUserIsCaptchaItemValue is defined and cachedUserIsCaptchaItemValue %}
        <script src="https://www.google.com/recaptcha/api.js?hl=fr" type="text/javascript" async defer></script>
    {% endif %}
{% endblock %}

{% block card %}
    <div class="auth-card">
        <div class="auth-card-header">
            <h2 class="auth-card-title">Connexion</h2>
            <p class="auth-card-subtitle">Saisissez vos identifiants pour acc&eacute;der &agrave; votre espace.</p>
        </div>

        {{ include('BackOffice/Security/_auth_messages.html.twig') }}

        <form action="{{ path('admin_user_login') }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

            <div class="auth-field">
                <label for="username">Identifiant</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" class="auth-input"
                       required="required" autocomplete="username" autofocus />
            </div>

            <div class="auth-field">
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" class="auth-input"
                       required="required" autocomplete="current-password" />
            </div>

            {% if cachedUserIsCaptchaItemValue is defined and cachedUserIsCaptchaItemValue %}
                <div class="auth-captcha">
                    {{ captcha.recaptcha(recaptcha_client_key, 'light') }}
                </div>
            {% endif %}

            <button type="submit" class="auth-submit" id="_submit" name="_submit">Se connecter</button>
        </form>

        <div class="auth-card-footer">
            <a href="{{ path('user_resetting_request') }}">Mot de passe oubli&eacute; ?</a>
        </div>
    </div>

    <p class="auth-panel-note">
        Pour votre s&eacute;curit&eacute;, un code de v&eacute;rification peut vous &ecirc;tre envoy&eacute; par courriel apr&egrave;s la saisie de votre mot de passe.
    </p>
{% endblock %}
