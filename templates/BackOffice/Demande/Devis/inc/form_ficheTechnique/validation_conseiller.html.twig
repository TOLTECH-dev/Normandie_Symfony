<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-validation-conseiller">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Validation Conseiller</legend>

        <div class="flex-wrapper">
            <div class="flex0">
                {{ form_errors(form.isValidationConseiller) }}
            </div>

            <div class="flex1"></div>

            <div class="flex2">
                <p class="custom-titre-btn-oui-non">Validation finale de la demande d'aide</p>
                <div class="onoffswitch">
                    {{ form_widget(form.isValidationConseiller, {'attr': {'class': 'onoffswitch-checkbox'}}) }}
                    <label class="onoffswitch-label" for="{{ form.isValidationConseiller.vars.id }}">
                        <span class="onoffswitch-inner"></span>
                        <span class="onoffswitch-switch"></span>
                    </label>
                </div>
            </div>

            <div class="flex3"></div>
        </div>

    </fieldset>
</div>
