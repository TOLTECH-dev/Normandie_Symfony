{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_demande_list_all') }}
    {{ encore_entry_link_tags('backOffice_historique_modal_commentaire') }}
{% endblock %}

{% block contents %}
    {% if is_granted('ROLE_CONSEILLER')
        or is_granted('ROLE_INSTRUCTEUR')
        or is_granted('ROLE_AUDITEUR')
        or is_granted('ROLE_RENOVATEUR')
        or is_granted('ROLE_EPCI')
        or is_granted('ROLE_CLIENT')
        or is_granted('ROLE_ADMIN')
        or is_granted('ROLE_TECHNIQUE')
    %}
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 hidden" id="content-wrapper">
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-2 marginBottom40">
                <div id="container-title">
                    <h2>Consultation des dossiers</h2>
                </div>
            </div>

            {{ form_start(form_export, {'action': '', 'attr': {'id': 'formDemandeListAll'}}) }}
            {{ form_errors(form_export) }}

            <table cellspacing="0" id="table_list_demande" class="table table-striped table-bordered big_table">
                <thead>
                <tr>
                    <th class="with_search breakWord col0">N&deg;</th>
                    <th class="with_select breakWord col1">Th&eacute;matique</th>
                    <th class="with_search breakWord col2">B&eacute;n&eacute;ficiaire</th>
                    <th class="with_search breakWord col3">Ville</th>
                    <th class="with_search breakWord col4">Date de demande</th>
                    <th class="with_search breakWord col5">Statut</th>
                    <th class="with_search breakWord col6">Structure &amp; Conseiller</th>
                    <th class="breakWord col7">Audit</th>
                    <th class="with_search breakWord col8">Nom professionnel</th>
                    <th class="with_search breakWord col9">Date de commission</th>
                    <th class="with_search breakWord col10">Date de remboursement</th>
                    <th class="breakWord col11">Action</th>
                </tr>
                </thead>

                {% if recordsTotal and (recordsTotal is not null or recordsTotal != 0) %}
                    <tfoot>
                    <tr id="filterrow">
                        <th class="with_search" id="demandeId">N&deg;</th>
                        <th class="with_select" id="demandeType">Th&eacute;matique</th>
                        <th class="with_search" id="beneficiaireIdentifiant">B&eacute;n&eacute;ficiaire</th>
                        <th class="with_search" id="logement">Ville</th>
                        <th class="with_search" id="demandeDateCreation">Date de demande</th>
                        <th class="with_search" id="demandeStatutSlug">Statut</th>
                        <th class="with_search" id="structureConseiller">Structure &amp; Conseiller</th>
                        <th>&nbsp;</th>
                        <th class="with_search" id="partenaire">Nom professionnel</th>
                        <th class="with_search" id="commissionDate">Date de commission</th>
                        <th class="with_search" id="remboursementDate">Date de remboursement</th>
                        <th class="textCenter">
                            <button type="button"
                                    role="button"
                                    class="btn btn-danger btn-xs"
                                    data-toggle="tooltip"
                                    data-placement="bottom"
                                    data-container="body"
                                    title="Vider les champs de recherche"
                                    id="clear_search_input"
                            >
                                <i class="glyphicon glyphicon-erase"></i>
                            </button>
                            {% if is_granted('ROLE_CONSEILLER')
                                or is_granted('ROLE_INSTRUCTEUR')
                                or is_granted('ROLE_AUDITEUR')
                                or is_granted('ROLE_RENOVATEUR')
                                or is_granted('ROLE_EPCI')
                                or is_granted('ROLE_CLIENT')
                                or is_granted('ROLE_ADMIN')
                            %}
                                <button role="button"
                                        class="btn btn-success btn-xs"
                                        data-toggle="tooltip"
                                        data-placement="bottom"
                                        data-container="body"
                                        title="Exporter les Demandes"
                                        id="exporter_demandes"
                                >
                                    <i class="glyphicon glyphicon-download-alt"></i>
                                </button>
                            {% endif %}
                        </th>
                    </tr>
                    </tfoot>
                {% endif %}

                <tbody></tbody>

                <div id="js-role" style="display:none;"
                     data-is-conseiller="{% if is_granted('ROLE_CONSEILLER') %}1{% else %}0{% endif %}"
                     data-is-instructeur="{% if is_granted('ROLE_INSTRUCTEUR') %}1{% else %}0{% endif %}"
                     data-is-auditeur="{% if is_granted('ROLE_AUDITEUR') %}1{% else %}0{% endif %}"
                     data-is-renovateur="{% if is_granted('ROLE_RENOVATEUR') %}1{% else %}0{% endif %}"
                     data-is-epci="{% if is_granted('ROLE_EPCI') %}1{% else %}0{% endif %}"
                     data-is-client="{% if is_granted('ROLE_CLIENT') %}1{% else %}0{% endif %}"
                     data-is-admin="{% if is_granted('ROLE_ADMIN') %}1{% else %}0{% endif %}"
                     data-is-technique="{% if is_granted('ROLE_TECHNIQUE') %}1{% else %}0{% endif %}"
                >
                </div>
            </table>
            {{ form_rest(form_export) }}
            {{ form_end(form_export) }}

            {{ include('BackOffice/Demande/inc/modalCommentaire.html.twig') }}

        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('coreList') }}
    {{ encore_entry_script_tags('backOffice_demande_listDemande_appel_datatables_ajax') }}
    {{ encore_entry_script_tags('backOffice_demande_listDemande_popover') }}
    <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
    <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
{% endblock %}
