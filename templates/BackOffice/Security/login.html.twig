{% extends "BackOffice/layout_core.html.twig" %}
{% import "Macros/captcha.html.twig" as captcha %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOfficeLogin') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if cachedUserIsCaptchaItemValue is defined and cachedUserIsCaptchaItemValue %}
        <script src="https://www.google.com/recaptcha/api.js?hl=fr" type="text/javascript"></script>
    {% endif %}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 col-xs-offset-0 col-sm-offset-0 col-md-offset-1 col-lg-offset-1 hidden" id="content-wrapper">
    <form action="{{ path("admin_user_login") }}" method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

        <div class="container-login">
            <h1>Espace Priv&eacute;</h1><br>

<form>
    <div class="form-group">
        <label for="username">Login</label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" required="required" placeholder="Login" />
    </div>

    <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" required="required" placeholder="Mot de passe" />
    </div>

    <div class="form-group container-checkbox">
        <input type="checkbox" id="remember_me" name="_remember_me" value="on"/>
        <label for="remember_me">Se souvenir de moi</label>
    </div>

    {% if cachedUserIsCaptchaItemValue is defined and cachedUserIsCaptchaItemValue %}
        <div class="form-group">
            {{ captcha.recaptcha(recaptcha_client_key) }}
        </div>
    {% endif %}

    <div class="form-group">
        <input type="submit" class="btn btn-warning" id="_submit" name="_submit" value="Connexion" />
    </div>
</form>

            <div class="container-help">
                <a href="{{ path('user_resetting_request') }}">Mot de passe oubli&eacute;?</a>
            </div>
        </div>
    </form>
</div>
{% endblock %}


