<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc bloc-formCancel">

    <p class="bold text-center">Etes-vous certain de vouloir annuler le RMH ?</p>

    {{ form_start(formCancel, {'attr': {'class': 'form-horizontal'}}) }}
    {{ form_errors(formCancel) }}

    {{ form_row(formCancel.dateRMH_id) }}

    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
        <div>
            {{ form_widget(formCancel.valider, {'label': 'Confirmer', 'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-2 col-md-offset-2 col-lg-offset-2 btn btn-success'}}) }}
            <button type="button" class="col-xs-12 col-sm-4 col-md-4 col-lg-4 btn btn-secondary marginLeft10" data-dismiss="modal">Annuler</button>
        </div>
    </div>

    {{ form_rest(formCancel) }}
    {{ form_end(formCancel) }}

</div>
