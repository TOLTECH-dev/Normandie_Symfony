<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-statut">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Statut</legend>

        {% if structure.structure_statut is null  %}
            <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                    {{ form_widget(form_structure.structure_statut.enabled, {'attr': {'class': 'hidden', 'checked': 'checked'}}) }}
                    {{ form_widget(form_structure.structure_statut.dateInactif, {'attr': {'class': 'hidden', 'id': 'structure_dateInactif'}}) }}
            </div>
            <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                <i class="glyphicon glyphicon-alert"></i> Structure active par d&eacute;fault.
            </div>
        {% else %}

            <div class="form-group">
                {% if structure.structure_statut.enabled == true %}
                    {% set enabled = '1' %}
                {% elseif structure.structure_statut.enabled == false %}
                    {% set enabled = '0' %}
                {% endif %}
                <span class="hidden" id="enabledStructure">{{ enabled }}</span>

                {{ form_label(form_structure.structure_statut.enabled, "Actif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                {{ form_errors(form_structure.structure_statut.enabled) }}

                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                    {{ form_widget(form_structure.structure_statut.enabled, {'attr': {'class': 'checkboxstyle pull-left'}}) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form_structure.structure_statut.dateInactif, "Date Inactif", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                {{ form_errors(form_structure.structure_statut.dateInactif) }}

                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                    {{ form_widget(form_structure.structure_statut.dateInactif, {'attr': {'class': 'form-control'}, 'id': 'structure_dateInactif'}) }}
                </div>
            </div>

        {% endif %}

    </fieldset>

    <hr class="bloc-limit">
</div>
