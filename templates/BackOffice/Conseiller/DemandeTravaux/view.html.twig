{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('frontOffice_core_form') }}
    {{ encore_entry_link_tags('frontOffice_demande_travaux_view') }}
    {{ encore_entry_link_tags('frontOffice_common_menu') }}
    {{ encore_entry_link_tags('backOffice_historique_modal_commentaire') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3" id="title-wrapper">
        <div id="container-title">
            <h2>Consulter une demande d'Aide Travaux (Volet administratif) : Dossier n°{{ demande.demandeId }}</h2>
            {% if demande.dateCPId is null and demande.statutId not in ['15'] %}
                <a href="{{ path('conseiller_demande_travaux_edit', {'beneficiaireId': beneficiaireId, 'demandeId': demande.demandeId}) }}"
                   id="button_position1"
                   class="btn btn-warning btn-xs"
                   role="button"
                   data-toggle="tooltip"
                   data-placement="bottom"
                   data-container="body"
                   title="Modifier la demande"
                >
                    <i class="glyphicon glyphicon-edit"></i>
                </a>
            {% else %}
                <a href="#"
                   id="button_position1"
                   class="btn btn-link btn-xs"
                   role="button"
                   data-toggle="tooltip"
                   data-placement="bottom"
                   data-container="body"
                   title="Indisponible"
                >
                    <i class="glyphicon glyphicon-ban-circle"></i>
                </a>
            {% endif %}

            {% set buttonColor = (totalCommentaire and (totalCommentaire is not null or totalCommentaire != 0)) ? 'btn-danger' : 'btn-primary' %}
            <button id="button_position2"
                    class="btn {{ buttonColor }} btn-xs button_addCommentaire"
                    type="button"
                    title="Commenter la Demande"
                    data-toggle="tooltip"
                    data-placement="bottom"
                    data-container="body"
                    data-demandeId="{{ demande.demandeId }}"
                    data-demandeUrl="{{ path('demande_create_commentaire', {'demandeId': demande.demandeId}) }}"
                    data-original-title="Commenter la Demande"
            >
                <i class="glyphicon glyphicon-comment"></i>
            </button>
            {{ include('BackOffice/Demande/inc/modalCommentaire.html.twig') }}

        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 hidden" id="content-wrapper">
        {% set path_location = 'demande_document_bo' %}

        {{ include('FrontOffice/Demande/Travaux/inc/view_travaux/audit.html.twig') }}
        {{ include('FrontOffice/Demande/Travaux/inc/view_travaux/revenu.html.twig') }}
        {{ include('FrontOffice/Demande/Travaux/inc/view_travaux/structure.html.twig') }}
        {{ include('FrontOffice/Demande/Travaux/inc/view_travaux/signature.html.twig') }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_conseiller_demandeTravaux_viewTravaux_modalCommentaire') }}
{% endblock %}
