{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_orientation_add_edit') }}
{% endblock %}


{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="container-title">
            <h2>Ajouter une Orientation</h2>
            {{ include('BackOffice/Orientation/inc/back.html.twig') }}
        </div>
    </div>

{{ form_start(form_orientation, {'attr': {'class': 'form-horizontal', 'id': 'form_addOrientation'}}) }}

{{ form_errors(form_orientation) }}

{{ include('BackOffice/Orientation/inc/form_orientation/identification.html.twig') }}
{{ include('BackOffice/Orientation/inc/form_orientation/structureInferieur.html.twig') }}
{{ include('BackOffice/Orientation/inc/form_orientation/structureSuperieur.html.twig') }}
{{ include('BackOffice/Orientation/inc/form_orientation/EPCI.html.twig') }}

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
    <div class="form-group">
        {{ form_widget(form_orientation.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
    </div>
</div>

{{ form_rest(form_orientation) }}

{{ form_end(form_orientation) }}

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('backOffice_orientation_index') }}
{% endblock %}
