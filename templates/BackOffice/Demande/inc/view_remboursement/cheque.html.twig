<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-cheque">
    <fieldset>
        <legend class="marginTop20"><span class="legend-icon"></span>&nbsp;Ch&egrave;que</legend>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Recto du ch&egrave;que :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {% if remboursement is defined
                    and remboursementInstruction
                    and remboursementInstruction.rectoChequeAlt
                %}
                    <a href="{{ path(path_location, {'demandeId': remboursementInstruction.id, 'typeFile': 8, 'extension': remboursementInstruction.rectoChequeUrl, 'typeDemande': typeDemandeDocument}) }}" target="_blank">
                        Voir le document
                    </a>
                {% else %}
                    Aucun document t&eacute;l&eacute;charg&eacute;
                {% endif %}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Verso du ch&egrave;que :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {% if remboursement is defined
                    and remboursementInstruction
                    and remboursementInstruction.versoChequeAlt
                %}
                    <a href="{{ path(path_location, {'demandeId': remboursementInstruction.id, 'typeFile': 9, 'extension': remboursementInstruction.versoChequeUrl, 'typeDemande': typeDemandeDocument}) }}" target="_blank">
                        Voir le document
                    </a>
                {% else %}
                    Aucun document t&eacute;l&eacute;charg&eacute;
                {% endif %}
            </div>
        </div>

        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Ch&egrave;que conforme ?</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                {% if remboursementInstruction %}
                    {{ isConformeArray[remboursementInstruction.isChequeConforme|split(' | ')[0]] }}
                {% else %}
                    -
                {% endif %}
            </div>
        </div>

        {% if remboursementInstruction and remboursementInstruction.chequeReason is not empty %}
        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Raison :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                <ul class="noMmargin noPadding">
                    {% for item in remboursementInstruction.chequeReason %}
                        <li>{{ item.slug }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% endif %}

        {% if remboursementInstruction and remboursementInstruction.chequeReasonAutre %}
        <div class="row">
            <label class="col-xs-12 col-sm-12 col-md-5 col-lg-5 control-label">Autre raison :</label>
            <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                <ul class="noMmargin noPadding noPuce">
                    <li>{{ remboursementInstruction.chequeReasonAutre }}</li>
                </ul>
            </div>
        </div>
        {% endif %}

    </fieldset>

    <hr class="bloc-limit">
</div>