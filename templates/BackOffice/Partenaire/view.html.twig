{% extends "BackOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('backOffice_partenaire_view') }}
{% endblock %}

{% block contents %}
<div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 marginBottom40 hidden" id="content-wrapper">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="container-title">
            <h2>Consulter un {{ title|capitalize }}</h2>

            {% if '0' == type %}
                {% set titleDisplay = 'l\'Auditeur' %}
            {% elseif '1' == type %}
                {% set titleDisplay = 'le Rénovateur' %}
            {% endif %}
            <a href="{{ path('partenaire_edit', {'partenaireId': partenaire.id, 'type': type}) }}"
               class="btn btn-warning btn-xs"
               role="button"
               id="button_position1"
               data-toggle="tooltip"
               data-placement="bottom"
               data-container="body"
               title="Modifier {{ titleDisplay }}"
            >
                <i class="glyphicon glyphicon-edit"></i>
            </a>
            {{ include('BackOffice/Partenaire/inc/back.html.twig') }}
        </div>
    </div>

{% set path_location = 'demande_document_bo' %}

{{ include('BackOffice/Partenaire/inc/view_partenaire/identification.html.twig') }}
{% if '0' == type %}
{{ include('BackOffice/Partenaire/inc/view_partenaire/option_auditeur.html.twig') }}
{% elseif '1' == type %}
{{ include('BackOffice/Partenaire/inc/view_partenaire/option_renovateur.html.twig') }}
{% endif %}
{{ include('BackOffice/Partenaire/inc/view_partenaire/adresse.html.twig') }}
{{ include('BackOffice/Partenaire/inc/view_partenaire/statut.html.twig') }}
{{ include('BackOffice/Partenaire/inc/view_partenaire/contact.html.twig') }}
{{ include('BackOffice/Partenaire/inc/view_partenaire/agence.html.twig') }}

</div>
{% endblock %}
