{% extends "FrontOffice/layout_core.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('frontOffice_demande_travaux_view') }}
{% endblock %}

{% block contents %}
    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3" id="title-wrapper">
        <div id="container-title">
            <h2>Consulter ma demande d'Aide Travaux (Volet administratif)</h2>
            {% if demande.dateCPId is null and demande.statutId not in ['15'] %}
                <a href="{{ path('demande_travaux_edit', {'demandeId': demande.demandeId}) }}"
                   class="btn btn-warning btn-xs"
                   role="button"
                   data-toggle="tooltip"
                   data-placement="bottom"
                   data-container="body"
                   title="Modifier la demande"
                >
                    <i class="glyphicon glyphicon-edit"></i>
                </a>
            {% endif %}
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-6 col-xs-offset-0 col-sm-offset-0 col-md-offset-2 col-lg-offset-3 hidden" id="content-wrapper">
        {% set path_location = 'demande_document_fo' %}

        {{ include('FrontOffice/Demande/Travaux/inc/view_travaux/audit.html.twig') }}
        {{ include('FrontOffice/Demande/Travaux/inc/view_travaux/revenu.html.twig') }}
        {{ include('FrontOffice/Demande/Travaux/inc/view_travaux/structure.html.twig') }}
        {{ include('FrontOffice/Demande/Travaux/inc/view_travaux/signature.html.twig') }}
    </div>
{% endblock %}
