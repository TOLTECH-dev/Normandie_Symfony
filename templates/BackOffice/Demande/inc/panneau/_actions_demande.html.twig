{#
    Actions sur la demande, affichées en tête de l'onglet « Demande » du panneau.

    Les conditions reprennent celles de la vue complète (BackOffice/Demande/view.html.twig, boutons
    de la ligne de titre) : modification tant que le chèque n'est pas en production, refus tant
    qu'aucun remboursement n'existe et que le chèque n'est pas parti, suppression réservée à
    l'administrateur. Les deux fenêtres de confirmation portent ici des identifiants distincts, la
    vue complète gardant les siens.

    Mise en forme : assets/styles/backOffice/demande/panneau.css
#}
{% set estGestionnaire = is_granted('ROLE_CLIENT') or is_granted('ROLE_ADMIN') %}
{% set statutBloquant = demande.statutId in ['13', '15'] %}
{% set estTravaux = constant('App\\Entity\\Demande_::DEMANDE_TRAVAUX_TYPE') == demande.demandeType %}

{# Remboursement visé par le refus : le second s'il existe (travaux BBC en deux versements) #}
{% set remboursementVise = null %}
{% set remboursementViseStatutId = null %}
{% if remboursement and demande.remboursementId %}
    {% if remboursement2 and demande.remboursementId2 %}
        {% set remboursementVise = demande.remboursementId2 %}
        {% set remboursementViseStatutId = remboursement2.statutId %}
    {% else %}
        {% set remboursementVise = demande.remboursementId %}
        {% set remboursementViseStatutId = remboursement.statutId %}
    {% endif %}
{% endif %}

{% set peutTelechargerFicheLiaison = (is_granted('ROLE_CONSEILLER') or is_granted('ROLE_AUDITEUR')
    or is_granted('ROLE_RENOVATEUR') or is_granted('ROLE_EPCI') or estGestionnaire or is_granted('ROLE_TECHNIQUE'))
    and estTravaux and constant('App\\Entity\\Demande_statut::STATUS_14') == demande.statutId %}

{% set peutModifier = estGestionnaire and not statutBloquant
    and (demande.dateCPId is null or demande.statutId not in ['14']) %}
{% set peutRefuser = estGestionnaire and not statutBloquant
    and demande.statutId not in ['11', '14'] and remboursementVise is null %}
{% set peutRefuserRemboursement = estGestionnaire and not statutBloquant
    and demande.statutId not in ['11']
    and remboursementVise is not null and remboursementViseStatutId not in ['20', '21', '22'] %}
{% set peutSupprimer = is_granted('ROLE_ADMIN') %}
{% set peutModifierContacts = estGestionnaire and demande.statutId == '14'
    and ((not remboursement or remboursement.statutId != '22')
        or (estTravaux and 1 == isBBC2 and (not remboursement2 or remboursement2.statutId != '22'))) %}
{% set peutChangerNiveauAide = estGestionnaire and estTravaux and demande.devisId %}
{% set peutReactiver = estGestionnaire
    and constant('App\\Entity\\Demande_statut::STATUS_15') == demande.statutId %}

{% if peutTelechargerFicheLiaison or peutModifier or peutRefuser or peutRefuserRemboursement
    or peutSupprimer or peutModifierContacts or peutChangerNiveauAide or peutReactiver
%}
    <div class="panneau-actions-demande">
        {% if peutTelechargerFicheLiaison %}
            <a href="{{ path('demande_fiche_liaison_bo', {'demandeId': demande.demandeId}) }}"
               class="panneau-action icone-vert" target="_blank" rel="noopener">
                <i class="glyphicon glyphicon-file"></i> Fiche de liaison
            </a>
        {% endif %}

        {% if peutModifier %}
            {# Orange comme dans la vue, et rouge quand une date de commission est déjà affectée #}
            <a href="{{ path('demande_edit', {'demandeId': demande.demandeId}) }}"
               class="panneau-action {{ demande.dateCPId is not null ? 'icone-rouge' : 'icone-orange' }}">
                <i class="glyphicon glyphicon-pencil"></i> Modifier la demande
            </a>
            {% if demande.dateCPId is not null %}
                <span class="panneau-action-avertissement">
                    Une date de commission a d&eacute;j&agrave; &eacute;t&eacute; affect&eacute;e.
                </span>
            {% endif %}
        {% endif %}

        {% if peutRefuser %}
            <button type="button" class="panneau-action est-refus icone-rouge"
                    data-toggle="modal" data-target="#panneau_popupRefusDemande">
                <i class="glyphicon glyphicon-remove-sign"></i> Refuser la demande
            </button>
        {% endif %}

        {% if peutRefuserRemboursement %}
            <button type="button" class="panneau-action est-refus icone-rouge"
                    data-toggle="modal" data-target="#panneau_popupRefusRemboursement">
                <i class="glyphicon glyphicon-remove-sign"></i> Refuser le remboursement
            </button>
        {% endif %}

        {% if peutModifierContacts %}
            <button type="button" class="panneau-action icone-orange"
                    data-toggle="modal" data-target="#panneau_popupAssignContacts">
                <i class="glyphicon glyphicon-retweet"></i> Modifier les contacts
            </button>
        {% endif %}

        {% if peutChangerNiveauAide %}
            <button type="button" class="panneau-action icone-orange"
                    data-toggle="modal" data-target="#panneau_popupNiveauAide">
                <i class="glyphicon glyphicon-random"></i> Changer le niveau d&rsquo;aides
            </button>
        {% endif %}

        {% if peutReactiver %}
            <button type="button" class="panneau-action icone-orange"
                    data-toggle="modal" data-target="#panneau_modalReactivation">
                <i class="glyphicon glyphicon-folder-open"></i> R&eacute;activer la demande
            </button>
        {% endif %}

        {% if peutSupprimer %}
            <button type="button" class="panneau-action est-suppression icone-rouge"
                    data-toggle="modal" data-target="#panneau_popupValidation">
                <i class="glyphicon glyphicon-trash"></i> Supprimer la demande
            </button>
        {% endif %}
    </div>

    {% if peutRefuser %}
        <div class="modal fade modalBackdrop" id="panneau_popupRefusDemande" tabindex="-1" role="dialog" data-backdrop="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title text-center">Veuillez justifier le refus de la Demande</h4>
                    </div>
                    <div class="modal-body">
                        <form class="form-horizontal" action="{{ path('demande_deny', {'demandeId': demande.demandeId}) }}" method="post">
                            <div class="form-group">
                                {{ form_label(form_deny_demande.motifRefus, "Motif de refus", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                                {{ form_errors(form_deny_demande.motifRefus) }}

                                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                                    {{ form_widget(form_deny_demande.motifRefus, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                                <div class="form-group">
                                    {{ form_widget(form_deny_demande.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                                </div>
                            </div>
                            &nbsp;
                            {{ form_rest(form_deny_demande) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if peutRefuserRemboursement %}
        <div class="modal fade modalBackdrop" id="panneau_popupRefusRemboursement" tabindex="-1" role="dialog" data-backdrop="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title text-center">Veuillez justifier le refus du Remboursement</h4>
                    </div>
                    <div class="modal-body">
                        <form class="form-horizontal" action="{{ path('remboursement_deny', {'remboursementId': remboursementVise}) }}" method="post">
                            <div class="form-group">
                                {{ form_label(form_deny_remboursement.motifRefus, "Motif de refus", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                                {{ form_errors(form_deny_remboursement.motifRefus) }}

                                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                                    {{ form_widget(form_deny_remboursement.motifRefus, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                                <div class="form-group">
                                    {{ form_widget(form_deny_remboursement.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                                </div>
                            </div>
                            &nbsp;
                            {{ form_rest(form_deny_remboursement) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {#
        Choix des contacts : son formulaire charge structures et conseillers en Ajax. Le script
        d'origine (assets/js/backOffice/demande/view) s'exécutait au chargement de la page, quand ce
        formulaire n'existe pas encore ici : panneau.js le relance à l'ouverture de la fenêtre.
    #}
    {% if peutModifierContacts %}
        <div class="modal fade modalBackdrop" id="panneau_popupAssignContacts" tabindex="-1" role="dialog" data-backdrop="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title text-center">Veuillez choisir les contacts</h4>
                    </div>
                    <div class="modal-body">
                        <form class="form-horizontal" action="{{ path('demande_assign_contacts', {'demandeId': demande.demandeId}) }}" method="post">
                            <div class="form-group">
                                {{ form_label(form_assign_demande_contacts.beneficiaireEmail, "Email du Bénéficiaire", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                                {{ form_errors(form_assign_demande_contacts.beneficiaireEmail) }}

                                <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
                                    {{ form_widget(form_assign_demande_contacts.beneficiaireEmail, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            </div>

                            <div id="bloc-structure">
                                <div class="form-group">
                                    {{ form_label(form_assign_demande_contacts.structure_id, "Structure", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}

                                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 custom-select">
                                        {{ form_widget(form_assign_demande_contacts.structure_id, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                </div>

                                <div class="hidden" id="bloc-conseillerDisplay">
                                    <div class="form-group">
                                        {{ form_label(form_assign_demande_contacts.conseiller_id, "Conseiller", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 custom-select">
                                            {{ form_widget(form_assign_demande_contacts.conseiller_id, {'attr': {'class': 'form-control select-conseiller'}}) }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="bloc-auditeur" class="{% if not showAuditeur %}hidden{% endif %}">
                                <div class="form-group">
                                    {{ form_label(form_assign_demande_contacts.auditeur_id, "Auditeur", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                                    {{ form_errors(form_assign_demande_contacts.auditeur_id) }}

                                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 custom-select">
                                        {{ form_widget(form_assign_demande_contacts.auditeur_id, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                </div>
                            </div>

                            <div id="bloc-renovateur" class="{% if not showRenovateur %}hidden{% endif %}">
                                <div class="form-group">
                                    {{ form_label(form_assign_demande_contacts.renovateur_id, "Rénovateur", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                                    {{ form_errors(form_assign_demande_contacts.renovateur_id) }}

                                    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 custom-select">
                                        {{ form_widget(form_assign_demande_contacts.renovateur_id, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                                <div class="form-group">
                                    {{ form_widget(form_assign_demande_contacts.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                                </div>
                            </div>
                            &nbsp;
                            {{ form_rest(form_assign_demande_contacts) }}
                        </form>

                        {# Données lues par le script des contacts #}
                        <div id="data-js-bundle" class="hidden" data-prefix-pathname-bundle="{{ prefix_pathname_bundle_bo }}"></div>
                        <div id="data-js-demande" class="hidden" data-demande-conseiller-id="{{ demandeConseillerId is defined ? demandeConseillerId : '' }}"></div>
                        <input type="hidden" value="0" id="isCreation" />
                        <input type="hidden" id="demandeNbPersFoyer" value="{{ demande.demandeNbPersFoyer is defined and demande.demandeNbPersFoyer ? demande.demandeNbPersFoyer : '' }}">
                        <input type="hidden" id="demandeRevenuFoyer" name="revenuFiscalRef" value="{{ demande.demandeRevenuFoyer is defined and demande.demandeRevenuFoyer ? demande.demandeRevenuFoyer : '' }}">
                        <input type="hidden" id="demandeType" value="{{ demande.demandeType is defined and demande.demandeType ? demande.demandeType : '' }}">
                        <input type="hidden" id="beneficiaireId" value="{{ demande.beneficiaireId is defined and demande.beneficiaireId ? demande.beneficiaireId : '' }}">
                        <input type="hidden" id="logementId" value="{{ logement.id is defined and logement.id ? logement.id : '' }}">
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if peutChangerNiveauAide %}
        <div class="modal fade modalBackdrop" id="panneau_popupNiveauAide" tabindex="-1" role="dialog" data-backdrop="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title text-center">Changer niveau d'aides</h4>
                    </div>
                    <div class="modal-body">
                        <form class="form-horizontal" action="{{ path('demande_update_niveau_aide_travaux_devis', {'demandeId': demande.demandeId, 'devisId': demande.devisId}) }}" method="post">
                            <div class="form-group">
                                {{ form_label(form_travaux_devis_update_niveau_aide.niveau, "Niveau d'aide", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                                {{ form_errors(form_travaux_devis_update_niveau_aide.niveau) }}

                                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 custom-select">
                                    {{ form_widget(form_travaux_devis_update_niveau_aide.niveau, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            </div>

                            <input type="hidden" value="{{ devis.renovateurId }}" id="box-valueRenovateur" />
                            <div class="form-group hidden" id="box-renovateur">
                                {{ form_label(form_travaux_devis_update_niveau_aide.renovateur_id, "Rénovateur", {'label_attr': {'class': 'col-xs-12 col-sm-12 col-md-4 col-lg-4 control-label'}}) }}
                                {{ form_errors(form_travaux_devis_update_niveau_aide.renovateur_id) }}

                                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 custom-select">
                                    {{ form_widget(form_travaux_devis_update_niveau_aide.renovateur_id, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 bloc" id="bloc-submit">
                                <div class="form-group">
                                    {{ form_widget(form_travaux_devis_update_niveau_aide.valider, {'attr': {'class': 'col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xs-offset-0 col-sm-offset-4 col-md-offset-4 col-lg-offset-4 btn btn-success'}}) }}
                                </div>
                            </div>
                            &nbsp;
                            {{ form_rest(form_travaux_devis_update_niveau_aide) }}
                        </form>

                        <div id="data-js-demande-niveau" class="hidden"
                             data-niveau-etape1-bbc-renovateur-value="{{ constant('App\\Entity\\Demande_travaux_devis::DEMANDE_TYPE_NIVEAU_ETAPE1_BBC_RENOVATEUR_VALUE') }}"
                             data-niveau-renovation-globale-bbc-value="{{ constant('App\\Entity\\Demande_travaux_devis::DEMANDE_TYPE_NIVEAU_RENOVATION_GLOBALE_BBC_VALUE') }}"
                        ></div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if peutReactiver %}
        <div class="modal fade modalBackdrop" id="panneau_modalReactivation" tabindex="-1" role="dialog" data-backdrop="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title text-center">Veuillez confirmer la r&eacute;activation</h4>
                    </div>
                    <div class="modal-body">
                        <form action="{{ path('demande_reactive', {'demandeId': demande.demandeId}) }}" method="post">
                            <p class="text-center">Etes-vous certain de vouloir r&eacute;activer la Demande n&deg;{{ demande.demandeId }}&nbsp;?</p>
                            <div class="bloc-submit">
                                <input type="submit" value="Réactiver" class="btn btn-info text-center" />
                                <button type="button" class="btn btn-secondary marginLeft10" data-dismiss="modal">Annuler</button>
                            </div>
                            {{ form_rest(form_reactive_demande) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if peutSupprimer %}
        <div class="modal fade modalBackdrop" id="panneau_popupValidation" tabindex="-1" role="dialog" data-backdrop="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title text-center">Veuillez confirmer la suppression</h4>
                    </div>
                    <div class="modal-body">
                        <form action="{{ path('demande_delete', {'demandeId': demande.demandeId}) }}" method="post">
                            <p class="text-center">Etes-vous certain de vouloir supprimer la Demande n&deg;{{ demande.demandeId }}&nbsp;?</p>
                            <div class="bloc-submit">
                                <input type="submit" value="Supprimer" class="btn btn-danger text-center" />
                                <button type="button" class="btn btn-secondary marginLeft10" data-dismiss="modal">Annuler</button>
                            </div>
                            {{ form_rest(form_delete) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endif %}
